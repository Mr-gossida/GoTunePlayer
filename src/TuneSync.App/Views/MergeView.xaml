<Page x:Class="TuneSync.App.Views.MergeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      d:DataContext="{d:DesignInstance Type=vm:MergeViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="폴더 합치기">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:TextBlock Text="폴더 합치기" FontTypography="TitleLarge"/>
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                          Text="소스 폴더의 음원을 타겟 폴더로 이동합니다. 실행 전 미리보기로 전체 계획을 검토할 수 있고, 충돌한 파일은 삭제하지 않고 격리 폴더로 이동합니다."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,8,0,12">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="BodyStrong" Text="소스 폴더 (이동할 파일이 있는 폴더)"/>
                    <ui:TextBlock Text="{Binding SourceFolder, TargetNullValue='선택되지 않음'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Content="소스 선택" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding BrowseSourceCommand}"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="BodyStrong" Text="타겟 폴더 (이동 받을 폴더)"/>
                    <ui:TextBlock Text="{Binding TargetFolder, TargetNullValue='선택되지 않음'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Content="타겟 선택" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding BrowseTargetCommand}"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBlock Grid.Column="0" Text="충돌 규칙:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center"
                          ItemsSource="{Binding ConflictResolutionOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding ConflictResolution}" Margin="0,0,16,0"/>
                <CheckBox Grid.Column="2" Content="하위 폴더 포함" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center"/>

                <ui:Button Grid.Column="3" Content="미리보기" Icon="{ui:SymbolIcon Eye24}" Command="{Binding BuildPreviewCommand}" Margin="0,0,8,0"/>
                <ui:Button Grid.Column="4" Content="실행" Icon="{ui:SymbolIcon FolderSync24}" Appearance="Primary"
                           Command="{Binding ExecuteCommand}" IsEnabled="{Binding IsPlanReady}"/>
            </Grid>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Plan}" AutoGenerateColumns="False"
                  IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="소스 파일" Binding="{Binding SourceFileName}" Width="220"/>
                <DataGridTextColumn Header="작업" Binding="{Binding ActionLabel}" Width="150"/>
                <DataGridTextColumn Header="타겟 파일명" Binding="{Binding DestFileName}" Width="220"/>
                <DataGridTextColumn Header="사유" Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <ui:TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Page>
