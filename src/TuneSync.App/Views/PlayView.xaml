<Page x:Class="TuneSync.App.Views.PlayView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:views="clr-namespace:TuneSync.App.Views"
      xmlns:conv="clr-namespace:TuneSync.App.Converters"
      d:DataContext="{d:DesignInstance Type=vm:PlayPageViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="플레이"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Foreground: a Page doesn't inherit the window's theme text color (it falls back to black),
         so every page sets it explicitly. The background is the window's cover-tinted backdrop. -->
    <Page.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:PathLeafConverter x:Key="PathLeafConverter"/>
        <conv:GroupIconConverter x:Key="GroupIconConverter"/>

        <!-- Audio quality line: [Hi-Res | Lossless] FLAC · 24bit · 96kHz · 2,304kbps.
             Content is the PlaybackViewModel. -->
        <DataTemplate x:Key="QualityLineTemplate">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                        BorderThickness="1" BorderBrush="{DynamicResource PlayerAccentBrush}"
                        Visibility="{Binding HasQualityBadge, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <TextBlock Text="{Binding QualityBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PlayerAccentBrush}"/>
                </Border>
                <TextBlock Text="{Binding QualityText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Queue rows: flat, rounded hover/selection instead of the default accent block. -->
        <Style x:Key="QueueItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Right margin: room for the overlay scrollbar, so it never covers the durations. -->
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,5" Margin="0,1,12,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ========== Now playing: cover + info | synced lyrics ========== -->
        <Grid x:Name="NowPlayingGrid" Grid.Column="0" Margin="48,24,32,24" DataContext="{Binding Playback}"
              Visibility="{Binding DataContext.Library.HasNoFiles, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Narrow window (ApplyResponsiveLayout): a small cover + title strip on top and the
                 lyrics below it, instead of the big cover beside the lyrics. -->
            <Grid x:Name="CompactHeader" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="SmallCover" Width="88" Height="88" Margin="0,0,16,0">
                    <Border CornerRadius="8" Background="{DynamicResource PlayerHoverBrush}">
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Border>
                    <Border CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentCoverSmall}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NowPlayingTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding NowPlayingTitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding NowPlayingSubtitle}" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding NowPlayingDetails}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource QualityLineTemplate}" Margin="0,4,0,0" Focusable="False"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="NowPlayingPanel" Grid.Column="0" Grid.RowSpan="2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Width" Value="300"/>
                        <Setter Property="Margin" Value="0,0,48,0"/>
                        <Style.Triggers>
                            <!-- Lyrics hidden: the cover alone, larger and centered. -->
                            <DataTrigger Binding="{Binding IsLyricsVisible}" Value="False">
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Width" Value="400"/>
                                <Setter Property="Margin" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid x:Name="BigCover" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                    <Border CornerRadius="10" Background="{DynamicResource PlayerHoverBrush}">
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="80" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Border>
                    <Border CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding NowPlayingTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,24,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding NowPlayingSubtitle}" FontSize="16" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding NowPlayingDetails}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource QualityLineTemplate}" Margin="0,8,0,0" Focusable="False"/>
                <!-- Intro (hero card, PlayView.ApplyIntroStage): how far the opening has played. -->
                <Grid Height="3" Margin="0,24,0,0"
                      Visibility="{Binding IsIntroVisible, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <Border CornerRadius="1.5" Background="{DynamicResource PlayerTrackBrush}"/>
                    <Border CornerRadius="1.5" Background="{DynamicResource PlayerAccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding IntroProgress}"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>

            <Grid x:Name="LyricsArea" Grid.Column="1" Grid.RowSpan="2"
                  Visibility="{Binding IsLyricsVisible, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                <!-- Synced lyrics: the current line glides to the center (LyricsScroller) while it
                     grows and brightens; the rest stay dim and the edges fade out. -->
                <!-- Intro in the narrow layout (the song info is already in the strip above): a big
                     equalizer pulse and the opening's progress until the first line. In the wide
                     layout this whole area steps aside for the hero card instead. -->
                <StackPanel x:Name="IntroPulse" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="16"/>
                    </StackPanel.RenderTransform>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIntroVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.25" Duration="0:0:0.7"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" BeginTime="0:0:0.25" Duration="0:0:0.7">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-16" Duration="0:0:0.5">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <views:EqualizerBars BarBrush="{DynamicResource PlayerAccentBrush}" IsActive="{Binding IsPlaying}">
                        <views:EqualizerBars.LayoutTransform>
                            <ScaleTransform ScaleX="3.5" ScaleY="3.5"/>
                        </views:EqualizerBars.LayoutTransform>
                    </views:EqualizerBars>
                    <Grid Width="160" Height="3" Margin="0,32,0,0">
                        <Border CornerRadius="1.5" Background="{DynamicResource PlayerTrackBrush}"/>
                        <Border CornerRadius="1.5" Background="{DynamicResource PlayerAccentBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding IntroProgress}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>                </StackPanel>

                <ScrollViewer x:Name="LyricsScrollViewer"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              PreviewMouseWheel="LyricsScrollViewer_PreviewMouseWheel"
                              SizeChanged="LyricsScrollViewer_SizeChanged"
                              Visibility="{Binding HasSyncedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Style.Triggers>
                                <!-- Hidden during the intro (PlayView.ApplyIntroStage handles the
                                     dramatic reveal afterwards); ignore the mouse meanwhile so no
                                     hover highlight or "click to play from here" tooltip shows. -->
                                <DataTrigger Binding="{Binding IsIntroVisible}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <!-- Only a thin fade at the very edges, so lines near the top stay readable. -->
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.07"/>
                            <GradientStop Color="Black" Offset="0.93"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <!-- Margin (half the viewport above and below, so any line can sit in the middle)
                         is set from code in the same layout pass as a resize: a binding updated it
                         a frame late, which made the lines shake while the window was resized. -->
                    <ItemsControl x:Name="LyricsItems" ItemsSource="{Binding LyricsLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,8" Margin="0,2" CornerRadius="8" Cursor="Hand"
                                        ToolTip="클릭하면 이 위치부터 재생합니다" MouseLeftButtonUp="LyricLine_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock x:Name="LineText" Text="{Binding Text}" TextWrapping="Wrap"
                                               FontSize="20" FontWeight="Bold" Opacity="0.32"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="FontSize" To="28" Duration="0:0:0.45">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.5"/>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="FontSize" To="20" Duration="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="PlainLyricsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasPlainLyricsOnly, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <!-- Unsynced lyrics pour in from the top, line after line (PlainLine_Loaded). -->
                    <ItemsControl x:Name="PlainLyricsItems" ItemsSource="{Binding PlainLyricsLines}" Margin="14,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="17" LineHeight="32" Opacity="0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Loaded="PlainLine_Loaded"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Shown after scrolling the lyrics away by hand: back to the line being sung. -->
                <ui:Button x:Name="BackToLyricButton" Content="현재 가사로" Icon="{ui:SymbolIcon ArrowSync24}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Panel.ZIndex="10"
                           Padding="14,6" CornerRadius="16" BorderThickness="0" FontWeight="SemiBold" Visibility="Collapsed"
                           Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                           MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                           PressedForeground="{DynamicResource PlayerOnAccentBrush}" Click="BackToLyric_Click"/>

                <!-- No lyrics: hovering reveals "가사 찾기", which searches online for this song and
                     offers the result to save right here (PlayPageViewModel). -->
                <Border x:Name="NoLyricsCard" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Padding="32,24" CornerRadius="14"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                        Visibility="{Binding Playback.HasNoLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Idle -->
                        <StackPanel Visibility="{Binding FindState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Idle}">
                            <ui:SymbolIcon Symbol="SlideText24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="가사가 없는 곡입니다" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="온라인에서 이 곡의 가사를 찾아 바로 넣을 수 있습니다." FontSize="12" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ui:Button Content="가사 찾기" Icon="{ui:SymbolIcon Search24}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                       Padding="18,8" CornerRadius="18" BorderThickness="0" FontWeight="SemiBold"
                                       Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                                       MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                                       PressedForeground="{DynamicResource PlayerOnAccentBrush}"
                                       Command="{Binding FindLyricsCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=NoLyricsCard}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>

                        <!-- Searching -->
                        <StackPanel Visibility="{Binding FindState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Searching}">
                            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="가사를 찾는 중…" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:Button Content="취소" HorizontalAlignment="Center" Margin="0,12,0,0" Command="{Binding CancelFindCommand}"
                                       Background="Transparent" BorderThickness="0"/>
                        </StackPanel>

                        <!-- Found: preview before saving -->
                        <StackPanel Visibility="{Binding FindState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Found}">
                            <TextBlock Text="{Binding FoundSummary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PlayerAccentBrush}"/>
                            <TextBlock Text="{Binding FoundPreview}" FontSize="15" LineHeight="26" Margin="0,12,0,0" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="…" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <ui:Button Content="저장하고 보기" Icon="{ui:SymbolIcon Checkmark24}" Padding="18,8" CornerRadius="18"
                                           BorderThickness="0" FontWeight="SemiBold"
                                           Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                                           MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                                           PressedForeground="{DynamicResource PlayerOnAccentBrush}"
                                           Command="{Binding SaveFoundLyricsCommand}" ToolTip="이 가사를 음악 파일에 저장합니다"/>
                                <ui:Button Content="취소" Margin="8,0,0,0" Padding="16,8" CornerRadius="18"
                                           Background="Transparent" BorderThickness="0" Command="{Binding CancelFindCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Not found -->
                        <StackPanel Visibility="{Binding FindState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=NotFound}">
                            <ui:SymbolIcon Symbol="SearchInfo24" FontSize="34" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="가사를 찾지 못했습니다" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="제목과 아티스트 태그가 정확한지 확인해 보세요." FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <ui:Button Content="다시 찾기" Icon="{ui:SymbolIcon ArrowClockwise24}" Padding="16,8" CornerRadius="18"
                                           Command="{Binding FindLyricsCommand}"/>
                                <ui:Button Content="태그 관리에서 보기" Icon="{ui:SymbolIcon Tag24}" Margin="8,0,0,0" Padding="16,8" CornerRadius="18"
                                           Click="OpenCurrentInTagManager_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasCurrentFile, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="재생할 곡을 골라 주세요" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="재생 대기열에서 곡을 두 번 클릭하거나 ▶ 버튼을 누르면 재생됩니다." FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Track change: a snapshot of the previous song's screen fades out on top while the new
             one fades in underneath (PlayView.Crossfade). -->
        <Image x:Name="CrossfadeSnapshot" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- Layout switch (wide <-> narrow): the cover glides here from its old spot to its new one. -->
        <Canvas x:Name="TransitionLayer" Grid.Column="0" IsHitTestVisible="False"/>

        <!-- ========== Empty library: one clear way in ========== -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding Library.HasNoFiles, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
            <Border Width="104" Height="104" CornerRadius="28" Background="{DynamicResource PlayerHoverBrush}" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="MusicNote224" FontSize="48" Foreground="{DynamicResource PlayerAccentBrush}"/>
            </Border>
            <TextBlock Text="음악을 추가해 시작하세요" FontSize="24" FontWeight="SemiBold" Margin="0,24,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="이 PC의 음악 폴더나 파일, 또는 NAS·서버·클라우드(WebDAV, Samba, SFTP, FTP)의 음악을 추가하면 태그·커버·가사를 읽어 재생 대기열을 만듭니다."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <ui:Button Content="폴더 또는 파일 추가" Icon="{ui:SymbolIcon FolderAdd24}"
                           Padding="20,10" CornerRadius="20" BorderThickness="0" FontWeight="SemiBold"
                           Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                           MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                           PressedForeground="{DynamicResource PlayerOnAccentBrush}"
                           Command="{Binding Library.AddFoldersCommand}"/>
                <ui:Button Content="네트워크 위치 추가" Icon="{ui:SymbolIcon CloudAdd24}" Margin="10,0,0,0"
                           Padding="20,10" CornerRadius="20" FontWeight="SemiBold"
                           Background="{DynamicResource PlayerHoverBrush}" BorderBrush="{DynamicResource PlayerAccentBrush}" BorderThickness="1"
                           MouseOverBackground="{DynamicResource PlayerHoverBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Command="{Binding Library.AddNetworkLocationCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- ========== Queue panel (its sort/grouping also decides playback order) ========== -->
        <Border x:Name="QueuePanel" Grid.Column="1" Width="320" Background="{DynamicResource PlayerPanelBrush}" Padding="12,14,12,10"
                Visibility="{Binding Playback.IsQueueVisible, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
            <Grid DataContext="{Binding Library}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="재생 대기열" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button x:Name="SortButton" Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="16"
                                   Icon="{ui:SymbolIcon ArrowSort24}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="정렬" Click="SortButton_Click"/>
                        <ui:Button x:Name="GroupButton" Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="16"
                                   Icon="{ui:SymbolIcon GroupList24}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="그룹" Click="GroupButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Search: jumps the selection to matching songs (doesn't filter the list) -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <ui:TextBox x:Name="SearchBox" PlaceholderText="곡, 아티스트, 앨범 검색 (Ctrl+F)"
                                Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" Padding="10,7,60,7"
                                TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                ToolTip="제목·아티스트·앨범·파일명으로 찾습니다. Enter: 다음, Shift+Enter: 이전, ↓: 목록으로, Esc: 지우기"/>
                    <TextBlock x:Name="SearchCounter" HorizontalAlignment="Right" Margin="0,0,36,0" VerticalAlignment="Center" FontSize="11"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <ListBox Grid.Row="2" x:Name="PlaylistBox" ItemsSource="{Binding PlaylistView}"
                         ItemContainerStyle="{StaticResource QueueItemStyle}"
                         BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         MouseDoubleClick="PlaylistBox_MouseDoubleClick" KeyDown="PlaylistBox_KeyDown"
                         ContextMenuOpening="PlaylistBox_ContextMenuOpening"
                         ScrollViewer.ScrollChanged="PlaylistBox_ScrollChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu/>
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,14,18,4" ToolTip="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Margin="0,0,6,0" FontSize="14"
                                                       Symbol="{Binding DataContext.PlaylistGroup, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource GroupIconConverter}}"
                                                       Foreground="{DynamicResource PlayerAccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name, Converter={StaticResource PathLeafConverter}}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PlayerAccentBrush}"/>
                                        <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text="곡"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding FileName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40" Margin="0,0,10,0">
                                    <Border CornerRadius="4" Background="{DynamicResource PlayerHoverBrush}">
                                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Border>
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverThumbnail}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="4" Background="#8C000000"
                                            Visibility="{Binding IsNowPlaying, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                        <views:EqualizerBars BarBrush="{DynamicResource PlayerAccentBrush}"
                                                             IsActive="{Binding DataContext.Playback.IsPlaying, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                    </Border>
                                    <Border x:Name="HoverPlay" CornerRadius="4" Background="#A6000000" Visibility="Collapsed" Cursor="Hand"
                                            ToolTip="재생" MouseLeftButtonUp="PlayItem_Click">
                                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="18" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="{Binding DisplayTitle}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Artist}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                                    <!-- Reserved with "다음에 재생": its turn in that list. -->
                                    <Border CornerRadius="8" Padding="7,1" Margin="0,0,8,0" Background="{DynamicResource PlayerAccentBrush}"
                                            ToolTip="다음에 재생할 곡"
                                            Visibility="{Binding IsUpNext, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PlayerOnAccentBrush}">
                                            <Run Text="다음"/><Run Text=" "/><Run Text="{Binding UpNextOrder, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding DurationText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="HoverPlay" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" TextWrapping="Wrap" TextAlignment="Center" Margin="12,32,12,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Top"
                           Text="아래 + 버튼으로 폴더나 음악 파일을 추가하세요."
                           Visibility="{Binding HasNoFiles, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>

                <!-- Shown while the playing song is scrolled out of view: back to it. -->
                <ui:Button x:Name="BackToCurrentButton" Grid.Row="2" Content="지금 재생 중" Icon="{ui:SymbolIcon MusicNote224}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                           Padding="14,6" CornerRadius="16" BorderThickness="0" FontWeight="SemiBold" Visibility="Collapsed"
                           Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                           MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                           PressedForeground="{DynamicResource PlayerOnAccentBrush}" Click="BackToCurrent_Click"/>

                <views:LibrarySourceBar Grid.Row="3" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>
