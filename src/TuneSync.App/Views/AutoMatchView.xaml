<Page x:Class="TuneSync.App.Views.AutoMatchView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:conv="clr-namespace:TuneSync.App.Converters"
      d:DataContext="{d:DesignInstance Type=vm:AutoMatchViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="자동 채움">
    <Page.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:TextBlock Text="자동 채움" FontTypography="TitleLarge"/>
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                          Text="라이브러리에서 선택한 파일(없으면 전체)의 파일명/태그를 분석해 MusicBrainz·LRCLIB에서 누락된 태그·커버·가사를 찾습니다."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ToggleSwitch Content="완전 자동 적용" IsChecked="{Binding IsAutomaticMode}" OffContent="검토 후 적용"/>
            </StackPanel>

            <ui:Button Grid.Column="2" Content="실행" Icon="{ui:SymbolIcon Sparkle24}"
                       Command="{Binding RunCommand}" Appearance="Primary" Margin="0,0,8,0"/>
            <ui:Button Grid.Column="3" Content="선택 항목 적용" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                       Command="{Binding ApplySelectedCommand}"/>
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="선택" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="제안 내용" Binding="{Binding ChangeSummary}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="200" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <ui:TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" HorizontalAlignment="Right"
                              Visibility="{Binding IsRunning, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
        </Grid>
    </Grid>
</Page>
