                                <ui:TextBlock Style="{StaticResource Desc}"
                                              Text="이전 곡 · 재생 · 다음 곡 버튼만 눌리고, 나머지 자리의 클릭은 뒤의 창으로 갑니다. 마우스를 올리면 HUD가 선명해집니다."/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ClickThroughButtons}" OnContent="켬" OffContent="끔"
                                             AutomationProperties.Name="HUD 버튼은 누를 수 있게"/>
                        </Grid>
                    </ui:CardExpander>
                </StackPanel>

                <!-- 단축키 -->
