<Page x:Class="TuneSync.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:views="clr-namespace:TuneSync.App.Views"
      xmlns:app="clr-namespace:TuneSync.App"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
      Title="설정"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Settings in categories (list on the left, like Windows Settings) with a search over all of
         them. Each card's Tag holds the words the search looks for (SettingsView.ApplySearch). -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Under a 랜덤 card: the looks 랜덤 may pick, as checkboxes (SettingsViewModel's pools).
             Content is the pool. -->
        <DataTemplate x:Key="RandomPoolTemplate">
            <Border Margin="0,-2,0,6" Padding="56,10,16,12" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="8,3" FontSize="12" Content="모두 선택 · 해제"
                                   Command="{Binding DataContext.CheckAllCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="랜덤으로 고를 항목" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="체크한 것 중에서만 고릅니다 · 하나도 체크하지 않으면 전체에서" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" MinWidth="128" Margin="0,0,8,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="Desc" TargetType="ui:TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <!-- wrap between words (어절), never inside one -->
            <Setter Property="app:KeepWords.IsEnabled" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="CategoryTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Subtitle"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CategoryLead" TargetType="ui:TextBlock" BasedOn="{StaticResource Desc}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Group" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- a hotkey's key: a box that reads the key, and waits for a new one when clicked -->
        <Style x:Key="HotkeyKey" TargetType="views:HotkeyBox">
            <Setter Property="Content" Value="{Binding KeyText}"/>
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="views:HotkeyBox">
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Padding="10,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13"/>
                                <ui:SymbolIcon x:Name="Pen" Symbol="Keyboard16" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="Pen" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsListening" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PlayerAccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                                <Setter TargetName="Pen" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A row of choices side by side, the chosen one filled in the player's color (a
             segmented control): for a few short options that read better all at once than in
             a drop-down. Items are Choice<T> (Label/Value). -->
        <Style x:Key="Segmented" TargetType="ListBox">
            <Setter Property="DisplayMemberPath" Value="Label"/>
            <Setter Property="SelectedValuePath" Value="Value"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border CornerRadius="6" Padding="2" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="4" Padding="10,5" Margin="1,0" Background="Transparent">
                                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.FontSize="13" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerAccentBrush}"/>
                                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource PlayerOnAccentBrush}"/>
                                            <Setter TargetName="Content" Property="TextElement.FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- the category list: a bar in the player's accent marks the open one -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="12,8">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Mark" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource PlayerAccentBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== categories and search ===== -->
        <Border Background="{DynamicResource PlayerPanelBrush}" Padding="10,12,10,12">
            <DockPanel>
                <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" PlaceholderText="설정 검색" Icon="{ui:SymbolIcon Search24}"
                            ClearButtonEnabled="True" Margin="0,0,0,12" TextChanged="SearchBox_TextChanged"/>
                <ListBox x:Name="NavList" ItemContainerStyle="{StaticResource NavItem}" BorderThickness="0" Background="Transparent"
                         SelectionChanged="NavList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="General" IsSelected="True">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Options24" Margin="0,0,10,0"/><TextBlock Text="일반"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Playback">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" Margin="0,0,10,0"/><TextBlock Text="재생"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Sound">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DeviceEq24" Margin="0,0,10,0"/><TextBlock Text="음향"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Hud">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Board24" Margin="0,0,10,0"/><TextBlock Text="HUD"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Hotkeys">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Keyboard24" Margin="0,0,10,0"/><TextBlock Text="단축키"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ScreenSaver">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="SlideMultiple24" Margin="0,0,10,0"/><TextBlock Text="화면 보호기"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Library">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Library24" Margin="0,0,10,0"/><TextBlock Text="라이브러리"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Tools">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Toolbox24" Margin="0,0,10,0"/><TextBlock Text="도구"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="About">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Info24" Margin="0,0,10,0"/><TextBlock Text="정보"/></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== the open category (or, while searching, every match) ===== -->
        <ScrollViewer x:Name="ContentScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Categories" Margin="22,14,22,24">

                <!-- 일반 -->
                <StackPanel Tag="General">
                    <ui:TextBlock Text="일반" Style="{StaticResource CategoryTitle}"/>
                    <ui:TextBlock Text="모양, Windows 시작과 창" Style="{StaticResource CategoryLead}"/>
                    <ui:TextBlock Text="모양" Style="{StaticResource Group}"/>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon DarkTheme24}" Tag="테마 밝게 어둡게 다크 라이트 모양">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="테마" FontTypography="Body"/>
                                <ui:TextBlock Text="밝게 · 어둡게 · Windows 설정 따르기" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox Width="200" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Theme}"/>
                    </ui:CardControl>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon TextFont24}" Tag="앱 글꼴 폰트 서체 글씨체 모양"
                                    ToolTip="메뉴, 목록, 창 제목 등 앱 전체의 글꼴입니다. 고르면 바로 바뀝니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="앱 글꼴" FontTypography="Body"/>
                                <ui:TextBlock Text="메뉴 · 목록 · 창의 글씨" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox Width="260" SelectedValuePath="Value" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MaxDropDownHeight="420"
                                  DropDownOpened="FontList_DropDownOpened"
                                  ItemsSource="{Binding AppFontOptions}" SelectedValue="{Binding AppFontFamily}">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- each name in its own font -->
                                    <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </ui:CardControl>
                    <!-- Preview: the app's own text in the chosen font (the whole window changes too). -->
                    <Border Tag="앱 글꼴 폰트 서체 글씨체 모양 미리보기" Margin="0,0,0,4" Padding="20,14" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            TextElement.FontFamily="{DynamicResource AppFontFamily}">
                        <StackPanel>
                            <TextBlock Text="미리보기" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="GoTune Player · 재생 대기열" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="가나다라마바사 아자차카타파하 · ABCDEFG abcdefg · 0123456789" FontSize="14" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <ui:TextBlock Text="시작" Style="{StaticResource Group}"/>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Power24}" Tag="Windows 시작 자동 실행 로그인 부팅"
                                    ToolTip="Windows에 로그인하면 작업 표시줄에 최소화된 상태로 시작합니다. 작업 관리자 › 시작 앱에서도 끌 수 있습니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="Windows 시작 시 자동 실행" FontTypography="Body"/>
                                <ui:TextBlock Text="로그인하면 최소화된 상태로 시작합니다" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" OnContent="켬" OffContent="끔"/>
                    </ui:CardControl>
                    <ui:TextBlock Text="창" Style="{StaticResource Group}"/>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon PictureInPictureEnter24}" Tag="최소화 미니 플레이어"
                                    ToolTip="최소화(─) 버튼을 누르면 작업 표시줄로 숨는 대신 미니 플레이어로 바뀝니다. 미니 플레이어를 더블클릭하면 돌아옵니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="최소화하면 미니 플레이어로" FontTypography="Body"/>
                                <ui:TextBlock Text="미니 플레이어를 더블클릭하면 돌아옵니다" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding MinimizeToMini}" OnContent="켬" OffContent="끔"/>
                    </ui:CardControl>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Dismiss24}"
                                    Tag="닫기 버튼 종료 끄기 시스템 트레이 알림 영역 백그라운드 숨기기 계속 재생 X"
                                    ToolTip="시스템 트레이로 숨기면 창을 닫아도 음악이 계속 재생됩니다. 트레이 아이콘을 누르면 플레이어가 다시 열리고, 마우스 오른쪽 단추로 누르면 재생 버튼과 [종료]가 있는 메뉴가 나옵니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="닫기(✕) 버튼을 누르면" FontTypography="Body"/>
                                <ui:TextBlock Text="트레이로 숨기면 창을 닫아도 음악이 계속 재생됩니다" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox Width="200" ItemsSource="{Binding CloseActionOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding CloseAction}" AutomationProperties.Name="닫기 버튼을 누르면"/>
                    </ui:CardControl>
                </StackPanel>

                <!-- 재생 -->
                <StackPanel Tag="Playback">
                    <ui:TextBlock Text="재생" Style="{StaticResource CategoryTitle}"/>
                    <ui:TextBlock Text="시작할 때의 재생과 재생 화면의 효과" Style="{StaticResource CategoryLead}"/>
                    <ui:TextBlock Text="시작할 때" Style="{StaticResource Group}"/>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Play24}" Tag="시작하면 바로 재생 자동 재생"
                                    ToolTip="이어 들을 곡이 없으면 재생 대기열의 첫 곡(랜덤 재생이 켜져 있으면 랜덤으로 고른 곡)부터 재생합니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="시작하면 바로 재생" FontTypography="Body"/>
                                <ui:TextBlock Text="일시정지로 기다리지 않고 바로 재생합니다" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding AutoPlayOnStartup}" OnContent="켬" OffContent="끔"/>
                    </ui:CardControl>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon History24}" Tag="마지막 곡 이어 듣기 이어듣기 재개">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="마지막 곡 이어 듣기" FontTypography="Body"/>
                                <ui:TextBlock Text="열 때 마지막 곡을 어디서부터 준비할지" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox Width="200" ItemsSource="{Binding StartupResumeOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding StartupResume}"/>
                    </ui:CardControl>
                    <ui:TextBlock Text="화면 효과" Style="{StaticResource Group}"/>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Flash24}" Tag="재생바 효과 물결 불꽃 네온 파형 막대 분수 빗방울 오로라 별빛 불꽃놀이 폭죽 없음 랜덤 임의 시크바"
                                    ToolTip="재생한 부분 위에서 음악에 맞춰 움직이는 효과입니다. 랜덤은 곡마다 효과 중 하나를 고르고, 없음은 움직이지 않는 선만 그립니다(가장 가벼움).">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="재생바 효과" FontTypography="Body"/>
                                <ui:TextBlock Text="물결 · 불꽃 · 분수 · 빗방울 등 · 랜덤 · 없음" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox Width="200" ItemsSource="{Binding SeekBarStyleOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding SeekBarStyle}"/>
                    </ui:CardControl>
                    <ContentControl Content="{Binding SeekBarRandomPool}" ContentTemplate="{StaticResource RandomPoolTemplate}" Focusable="False"
                                    Visibility="{Binding IsSeekBarRandom, Converter={StaticResource BoolToVisibility}}"/>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon DataBarVertical24}" Tag="스펙트럼 모양 LED 막대 물결 랜덤"
                                    ToolTip="곡 정보 아래와 화면 보호기의 스펙트럼입니다. 곡 정보 아래 스펙트럼을 클릭해도 차례로 바뀝니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="스펙트럼 모양" FontTypography="Body"/>
                                <ui:TextBlock Text="스펙트럼을 클릭해도 바꿀 수 있습니다" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox Width="200" ItemsSource="{Binding SpectrumStyleOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding SpectrumStyle}"/>
                    </ui:CardControl>
                    <ContentControl Content="{Binding SpectrumRandomPool}" ContentTemplate="{StaticResource RandomPoolTemplate}" Focusable="False"
                                    Visibility="{Binding IsSpectrumRandom, Converter={StaticResource BoolToVisibility}}"/>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Timer24}" Tag="인트로 진행 게이지 전주"
                                    ToolTip="싱크 가사가 시작되기 전 인트로 동안, 가사가 나오기까지 얼마나 남았는지 가는 막대로 보여 줍니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="인트로 진행 게이지" FontTypography="Body"/>
                                <ui:TextBlock Text="가사가 나오기까지 남은 시간을 막대로" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding ShowIntroGauge}" OnContent="표시" OffContent="숨김"/>
                    </ui:CardControl>
