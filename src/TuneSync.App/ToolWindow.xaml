<ui:FluentWindow x:Class="TuneSync.App.ToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Icon="pack://application:,,,/Assets/TuneSync.ico"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="ToolTitleBar" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/TuneSync.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Focusable="False"/>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" VerticalAlignment="Bottom" Margin="20,0,20,76"/>
    </Grid>
</ui:FluentWindow>
