                            <StackPanel>
                                <ui:TextBlock Text="화면 보호기" FontTypography="Body"/>
                                <ui:TextBlock Text="{Binding ScreenSaverSummary}" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardExpander.Header>
