<Application x:Class="TuneSync.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TuneSync.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--
                WPF-UI's own DataGrid.xaml wires DataGridColumnHeader's Background/Padding/sort-icon
                but never sets a Foreground, relying on inheritance from the DataGrid. That inheritance
                doesn't reliably reach the auto-generated header ContentPresenter, so headers were
                rendering in a low-contrast default color against the dark theme instead of theme text.
                Override explicitly so every DataGrid's column headers are always readable.
            -->
            <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
