                                     ToolTip="카드 배경을 없애고 곡 정보 · 가사 · 스펙트럼 · 버튼만 띄웁니다. 글자와 버튼은 흰색에 어두운 테두리와 그림자를 둘러, 밝은 창 위에서도 어두운 창 위에서도 읽힙니다. 마우스를 올리면 카드가 옅게 나타납니다.">
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <ui:TextBlock Text="HUD 클리어 모드" FontTypography="Body"/>
                                    <ui:TextBlock Text="배경 없이 글자 · 커버 · 버튼만 테두리를 둘러 띄우기 · 그동안 투명도는 쓰지 않습니다" Style="{StaticResource Desc}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                                                 IsChecked="{Binding Clear}" OnContent="켬" OffContent="끔" AutomationProperties.Name="HUD 클리어 모드"/>
                            </Grid>
                        </ui:CardExpander.Header>
                        <Grid Margin="40,4,0,4" IsEnabled="{Binding Clear}">
