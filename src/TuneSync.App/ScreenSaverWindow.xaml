<Window x:Class="TuneSync.App.ScreenSaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:TuneSync.App.Effects"
        xmlns:views="clr-namespace:TuneSync.App.Views"
        xmlns:local="clr-namespace:TuneSync.App"
        Title="GoTune 화면 보호기"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="Black" Cursor="None" WindowStartupLocation="Manual">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid x:Name="Root" Opacity="0">
        <!-- Same cover-colored backdrop as the player, a little darker. -->
        <Rectangle Fill="{DynamicResource PlayerTintBrush}"/>
        <Image Source="{Binding BackdropCover}" Stretch="UniformToFill" Opacity="0.6" RenderOptions.BitmapScalingMode="Linear"/>
        <Rectangle Fill="{DynamicResource PlayerScrimBrush}"/>
        <Rectangle Fill="#73000000"/>

        <!-- Aurora-lamp light flowing over the backdrop in the cover's colors (Effects/Aurora.hlsl,
             on the GPU). The near-transparent fill only gives the effect an area to draw on. -->
        <Rectangle x:Name="AuroraLayer" Fill="#01000000" IsHitTestVisible="False" SizeChanged="AuroraLayer_SizeChanged">
            <Rectangle.Effect>
                <effects:AuroraEffect x:Name="AuroraLight" Intensity="0.7"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- The clock stays put in its corner (drifting, it could slide off the screen); its
             digits change every minute anyway. -->
        <StackPanel x:Name="ClockPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,72,0">
            <TextBlock x:Name="ClockText" FontSize="72" FontWeight="Light" Foreground="White" HorizontalAlignment="Right"/>
            <TextBlock x:Name="DateText" FontSize="18" Foreground="#B3FFFFFF" HorizontalAlignment="Right" Margin="0,0,4,0"/>
        </StackPanel>

        <!-- The cover, song and lyrics drift a little now and then, so nothing sits still long
             enough to burn in. -->
        <Grid x:Name="Stage">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Drift"/>
            </Grid.RenderTransform>

            <!-- A soft shade behind the song, so white text and the spectrum read even when the
                 cover is pale and the aurora lights up behind them. No visible edge. -->
            <Rectangle Width="1500" Height="1150" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#80000000" Offset="0"/>
                        <GradientStop Color="#59000000" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel x:Name="MainStack" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
                <Border x:Name="CoverCard" Width="340" Height="340" CornerRadius="14" HorizontalAlignment="Center" Background="#22FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="12" Direction="270" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                </Border>
                <TextBlock x:Name="TitleText" Text="{Binding NowPlayingTitle}" FontSize="38" FontWeight="Bold" Foreground="White" Margin="0,36,0,0"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="SubtitleText" Text="{Binding NowPlayingSubtitle}" FontSize="20" Foreground="#CCFFFFFF" Margin="0,8,0,0"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <!-- How far the song has got: the player's seek bar in the same look, shown only
                     (any mouse movement ends the screen saver anyway). White, like the spectrum. -->
                <Grid x:Name="SeekPanel" Width="560" Margin="0,26,0,0" IsHitTestVisible="False">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                    </Grid.Effect>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <local:WaveSeekBar Height="24"
                                       Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                       IsPlaying="{Binding IsPlaying}" Waveform="{Binding Waveform}" Look="{Binding SeekLook}"
                                       WaveBrush="#F2FFFFFF" TrackBrush="#40FFFFFF"/>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <TextBlock Text="{Binding PositionText}" FontSize="13" Foreground="#CCFFFFFF"/>
                        <TextBlock Text="{Binding DurationText}" FontSize="13" Foreground="#CCFFFFFF" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

                <!-- The spectrum of what's playing, as in the player - but white: the cover's accent
                     color is the same hue as the light behind it here and got lost. -->
                <views:SpectrumView x:Name="MainSpectrum" Playback="{Binding}" Look="{Binding SpectrumLook}" BarBrush="#F2FFFFFF" BarWidth="4"
                                    Width="560" Height="48" Margin="0,18,0,0">
                    <views:SpectrumView.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                    </views:SpectrumView.Effect>
                </views:SpectrumView>

                <!-- Three lines - the one just sung, the current one, the next - gliding up like the
                     player's lyrics (LyricsScroller). Lines are laid out at the current-line size and
                     drawn smaller when not current, so a line growing never re-wraps. -->
                <ScrollViewer x:Name="LyricsViewer" Height="160" Margin="0,34,0,0" Focusable="False" IsHitTestVisible="False"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              SizeChanged="LyricsViewer_SizeChanged"
                              Visibility="{Binding HasSyncedLyrics, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.65" Color="Black"/>
                    </ScrollViewer.Effect>
                    <!-- Absolute, matching the view's Height: a relative mask is sized to the drawn
                         lines and would fade the first/last line itself (see PlayView). -->
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,160">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.12"/>
                            <GradientStop Color="Black" Offset="0.88"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <ItemsControl x:Name="LyricsItems" ItemsSource="{Binding LyricsLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Line" Margin="0,5" RenderTransformOrigin="0.5,0.5" Opacity="0.55">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="0.62" ScaleY="0.62"/>
                                    </Grid.RenderTransform>
                                    <TextBlock Text="{Binding Text}" FontSize="30" FontWeight="SemiBold" Foreground="White"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45"/>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.5"/>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.62" Duration="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.62" Duration="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Other monitors (ScreenSaverRole.Ambient), and the lyrics screen while there are no
                 lines to show: a big clock over a wide spectrum. -->
            <StackPanel x:Name="AmbientPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                </StackPanel.Effect>
                <TextBlock x:Name="AmbientClock" FontSize="150" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="AmbientDate" FontSize="24" Foreground="#B3FFFFFF" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                <views:SpectrumView x:Name="AmbientSpectrum" Playback="{Binding}" Look="{Binding SpectrumLook}" BarBrush="#E6FFFFFF" BarWidth="8"
                                    Width="1000" Height="130" Margin="0,56,0,0"/>
                <TextBlock Margin="0,30,0,0" HorizontalAlignment="Center" FontSize="18" Foreground="#B3FFFFFF">
                    <Run Text="{Binding NowPlayingTitle, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding NowPlayingSubtitle, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <!-- The lyrics screen (ScreenSaverRole.Lyrics): which song, quietly, under the lines. -->
            <TextBlock x:Name="WallFooter" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,90" FontSize="20" Foreground="#B3FFFFFF">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                </TextBlock.Effect>
                <Run Text="{Binding NowPlayingTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="White"/><Run Text="  ·  "/><Run Text="{Binding NowPlayingSubtitle, Mode=OneWay}"/>
            </TextBlock>
        </Grid>

        <TextBlock x:Name="Hint" Text="마우스를 움직이거나 아무 키나 누르면 돌아갑니다" FontSize="13" Foreground="#99FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"/>
    </Grid>
</Window>
