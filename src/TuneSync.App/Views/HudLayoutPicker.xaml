<UserControl x:Class="TuneSync.App.Views.HudLayoutPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TuneSync.App.Converters"
             xmlns:app="clr-namespace:TuneSync.App"
             x:Name="Root">
    <!-- The HUD's layouts as four tiles, each with a small drawing of its shape; the same picker
         sits in 설정 (with a line on each) and in the HUD's own menu (names only). -->
    <UserControl.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Tile" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" Padding="8,8,8,7"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <ContentPresenter/>
                            </Border>
                            <!-- the chosen one: a ring in the accent (drawn over, so nothing inside moves) -->
                            <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource PlayerAccentBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PlayerAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- pieces of the little drawings: a card outline, text lines, the lyric line, a cover -->
        <Style x:Key="Shape" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Text" TargetType="Border">
            <Setter Property="Height" Value="2"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
        <Style x:Key="Lyric" TargetType="Border" BasedOn="{StaticResource Text}">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource PlayerAccentBrush}"/>
        </Style>
        <Style x:Key="Art" TargetType="Border">
            <Setter Property="CornerRadius" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <!-- 설정: drawing over name over line, four in a row; the HUD's menu: drawing beside name, two by two -->
        <Style x:Key="Body" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowDescriptions, ElementName=Root}" Value="False">
                    <Setter Property="Orientation" Value="Horizontal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Drawing" TargetType="Viewbox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="StretchDirection" Value="DownOnly"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowDescriptions, ElementName=Root}" Value="False">
                    <Setter Property="Height" Value="22"/>
                    <Setter Property="Width" Value="36"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Name" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowDescriptions, ElementName=Root}" Value="False">
                    <Setter Property="Margin" Value="8,0,0,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Line" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="app:KeepWords.IsEnabled" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Visibility" Value="{Binding ShowDescriptions, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>
        </Style>
    </UserControl.Resources>

    <UniformGrid Margin="-3">
        <UniformGrid.Style>
            <Style TargetType="UniformGrid">
                <Setter Property="Columns" Value="4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowDescriptions, ElementName=Root}" Value="False">
                        <Setter Property="Columns" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </UniformGrid.Style>
        <RadioButton Style="{StaticResource Tile}" AutomationProperties.Name="HUD 레이아웃: 카드"
                     IsChecked="{Binding Layout, ElementName=Root, Converter={StaticResource EnumToBool}, ConverterParameter=Card}">
            <StackPanel Style="{StaticResource Body}">
                <Viewbox Style="{StaticResource Drawing}">
                    <Border Style="{StaticResource Shape}" Width="54" Height="34" Padding="5,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Art}" Width="7" Height="7"/>
                                <Border Style="{StaticResource Text}" Width="22" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Border Style="{StaticResource Lyric}" Width="36" Margin="0,4,0,0"/>
                            <Border Style="{StaticResource Text}" Width="26" Margin="0,2,0,0"/>
                            <Border Style="{StaticResource Text}" Width="42" Margin="0,4,0,0" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                </Viewbox>
                <TextBlock Style="{StaticResource Name}" Text="카드"/>
                <TextBlock Style="{StaticResource Line}" Text="모든 정보를 한 카드에"/>
            </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Tile}" AutomationProperties.Name="HUD 레이아웃: 한 줄"
                     IsChecked="{Binding Layout, ElementName=Root, Converter={StaticResource EnumToBool}, ConverterParameter=Compact}">
            <StackPanel Style="{StaticResource Body}">
                <Viewbox Style="{StaticResource Drawing}">
                    <Grid Height="34" Width="58">
                        <Border Style="{StaticResource Shape}" Width="58" Height="13" Padding="3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Art}" Width="7" Height="7"/>
                                <StackPanel Margin="3,0,0,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Text}" Width="20"/>
                                    <Border Style="{StaticResource Lyric}" Width="26" Height="2" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <Border Style="{StaticResource Art}" Width="10" Height="3" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Viewbox>
                <TextBlock Style="{StaticResource Name}" Text="한 줄"/>
                <TextBlock Style="{StaticResource Line}" Text="얇은 띠 하나, 가장 작게"/>
            </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Tile}" AutomationProperties.Name="HUD 레이아웃: 가사 집중"
                     IsChecked="{Binding Layout, ElementName=Root, Converter={StaticResource EnumToBool}, ConverterParameter=Lyrics}">
            <StackPanel Style="{StaticResource Body}">
                <Viewbox Style="{StaticResource Drawing}">
                    <Border Style="{StaticResource Shape}" Width="62" Height="26" Padding="5,4">
                        <StackPanel>
                            <Border Style="{StaticResource Lyric}" Width="44" Height="4" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource Text}" Width="30" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource Text}" Width="50" Height="1.5" Margin="0,4,0,0" HorizontalAlignment="Center" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                </Viewbox>
                <TextBlock Style="{StaticResource Name}" Text="가사 집중"/>
                <TextBlock Style="{StaticResource Line}" Text="가사 두 줄을 크게"/>
            </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Tile}" AutomationProperties.Name="HUD 레이아웃: 세로 미니멀"
                     IsChecked="{Binding Layout, ElementName=Root, Converter={StaticResource EnumToBool}, ConverterParameter=Vertical}">
            <StackPanel Style="{StaticResource Body}">
                <Viewbox Style="{StaticResource Drawing}">
                    <Border Style="{StaticResource Shape}" Width="24" Height="34" Padding="3">
                        <StackPanel>
                            <Border Style="{StaticResource Art}" Width="16" Height="16" HorizontalAlignment="Center"/>
                            <Border Style="{StaticResource Text}" Width="12" Margin="0,3,0,0"/>
                            <Border Style="{StaticResource Lyric}" Width="16" Height="2" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Viewbox>
                <TextBlock Style="{StaticResource Name}" Text="세로 미니멀"/>
                <TextBlock Style="{StaticResource Line}" Text="큰 커버 중심"/>
            </StackPanel>
        </RadioButton>
    </UniformGrid>
</UserControl>
