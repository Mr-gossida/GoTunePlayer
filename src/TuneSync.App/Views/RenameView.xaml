<Page x:Class="TuneSync.App.Views.RenameView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:conv="clr-namespace:TuneSync.App.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:RenameViewModel}"
      Title="이름 변경"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ToolStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <ui:TextBlock Text="이름 변경" FontTypography="Subtitle"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                       Text="태그로 파일 이름을 정리합니다. 바뀌는 이름을 바로 보여 주며, 가사 파일(.lrc)도 함께 바뀌고 되돌릴 수 있습니다."/>
        </StackPanel>

        <!-- ===== 1 대상 · 2 규칙 ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ToolCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StepCaption}" Text="1  대상"/>
                    <Border Style="{StaticResource SegmentTray}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="RenameSource" Content="태그 관리에서 선택한 곡"
                                         IsChecked="{Binding Source, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Selection}"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="RenameSource" Content="폴더"
                                         IsChecked="{Binding Source, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Folder}"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SourceSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding SourceSummary}"/>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowClockwise24}" Appearance="Transparent" Padding="6"
                                   Command="{Binding RefreshCommand}" ToolTip="곡을 다시 읽기"/>
                    </Grid>

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding Source, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Folder}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="폴더 선택…" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding BrowseFolderCommand}" Padding="10,4"/>
                            <CheckBox Content="하위 폴더 포함" IsChecked="{Binding IncludeSubfolders}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="태그 관리 목록에서 곡을 고르면 여기에 바로 반영됩니다."
                               Visibility="{Binding Source, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Selection}"/>
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding ExcludedNote}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExcludedNote}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ToolCard}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource StepCaption}" Text="2  이름 규칙"/>
                        <Border Style="{StaticResource SegmentTray}" HorizontalAlignment="Right" Margin="0,-4,0,6">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="RenameMode" Content="자동"
                                             ToolTip="트랙 번호와 앨범이 있는 곡은 앨범 규칙, 나머지는 싱글 규칙"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Auto}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="RenameMode" Content="싱글"
                                             ToolTip="모든 곡에 싱글 규칙"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Single}"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="RenameMode" Content="앨범"
                                             ToolTip="모든 곡에 앨범 규칙"
                                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Album}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Single pattern -->
                    <Grid Visibility="{Binding UsesSingle, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="싱글" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox x:Name="SinglePatternBox" Grid.Column="1" Text="{Binding SingleTrackPattern, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{}{Artist} - {Title}" ClearButtonEnabled="False" FontFamily="Consolas, Malgun Gothic"
                                    GotKeyboardFocus="PatternBox_GotFocus"/>
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SinglePresets}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PresetLink}" Content="{Binding Label}" ToolTip="{Binding Pattern}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Album pattern -->
                    <Grid Visibility="{Binding UsesAlbum, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="앨범" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox x:Name="AlbumPatternBox" Grid.Column="1" Text="{Binding AlbumTrackPattern, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{}{Track} {Title}" ClearButtonEnabled="False" FontFamily="Consolas, Malgun Gothic"
                                    GotKeyboardFocus="PatternBox_GotFocus"/>
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AlbumPresets}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PresetLink}" Content="{Binding Label}" ToolTip="{Binding Pattern}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Token chips: insert at the cursor of the pattern being edited -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="넣기" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Tokens}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TokenChip}" Click="Token_Click" ToolTip="{Binding Token}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+ " Foreground="{DynamicResource TagChangeBrush}"/>
                                            <TextBlock Text="{Binding Label}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 3 미리보기 ===== -->
        <Border Grid.Row="2" Style="{StaticResource ToolCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="16,12,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource StepCaption}" Text="3  미리보기" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="RenameFilter"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}">
                            <TextBlock><Run Text="전체 "/><Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="RenameFilter"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Changed}">
                            <TextBlock><Run Text="바뀜 "/><Run Text="{Binding ChangedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TagChangeBrush}"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="RenameFilter"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Same}">
                            <TextBlock><Run Text="그대로 "/><Run Text="{Binding SameCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterChip}" GroupName="RenameFilter"
                                     IsChecked="{Binding Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Check}">
                            <TextBlock><Run Text="확인 필요 "/><Run Text="{Binding CheckCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}"/></TextBlock>
                        </RadioButton>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="모두 선택" Appearance="Transparent" Padding="8,3" FontSize="12"
                                   Command="{Binding SetAllVisibleCommand}" CommandParameter="True"/>
                        <ui:Button Content="모두 해제" Appearance="Transparent" Padding="8,3" FontSize="12"
                                   Command="{Binding SetAllVisibleCommand}" CommandParameter="False"/>
                    </StackPanel>
                </Grid>

                <!-- column header -->
                <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="8,5,14,5">
                    <Grid TextElement.FontSize="12" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="지금 이름"/>
                        <TextBlock Grid.Column="3" Text="바뀔 이름"/>
                        <TextBlock Grid.Column="4" Text="상태"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="2" ItemsSource="{Binding PreviewView}" ItemContainerStyle="{StaticResource PlainRow}"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RenamePreviewItemViewModel}">
                            <Grid x:Name="Row">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsIncluded}" IsEnabled="{Binding WillChange}" VerticalAlignment="Center"
                                          MinWidth="0" Padding="0" Margin="0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="OldName" Text="{Binding OldFileName}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OldFileName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Location}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <ui:SymbolIcon x:Name="Arrow" Grid.Column="2" Symbol="ArrowRight16" FontSize="13" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="NewName" TextTrimming="CharacterEllipsis" ToolTip="{Binding NewFileName}">
                                        <Run Text="{Binding NewHead, Mode=OneWay}"/><Run Text="{Binding NewChanged, Mode=OneWay}"
                                             Foreground="{DynamicResource TagChangeBrush}" Background="{DynamicResource TagChangeBackgroundBrush}"
                                             FontWeight="SemiBold"/><Run Text="{Binding NewTail, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Note}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Border x:Name="Badge" Style="{StaticResource Badge}">
                                        <TextBlock x:Name="BadgeText" Text="{Binding KindLabel}" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Change">
                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource TagChangeBackgroundBrush}"/>
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TagChangeBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Collision">
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="MissingTags">
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Same">
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter TargetName="NewName" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <Setter TargetName="Arrow" Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- empty / loading state -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="Rename24" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="바꿀 곡이 없습니다" HorizontalAlignment="Center" Margin="0,8,0,2" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="태그 관리에서 곡을 선택하거나, 폴더를 골라 주세요."/>
                </StackPanel>
                <ui:ProgressRing Grid.Row="2" IsIndeterminate="True" Width="28" Height="28"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- ===== action bar ===== -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding UndoSummary}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <ui:Button Grid.Column="1" Content="되돌리기" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="12,0,8,0"
                       Command="{Binding UndoCommand}" Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                       ToolTip="방금 바꾼 이름을 모두 원래대로 돌립니다"/>
            <ui:Button Grid.Column="2" Appearance="Primary" MinWidth="150" Padding="16,6"
                       Command="{Binding ExecuteCommand}" Content="{Binding ExecuteLabel}"/>
        </Grid>
    </Grid>
</Page>
