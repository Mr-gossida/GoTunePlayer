<Page x:Class="TuneSync.App.Views.RenameView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="폴더·파일명 규칙">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="이름 규칙" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="단일 곡 패턴" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="SinglePatternBox" Margin="12,0,24,0"/>
                    <TextBlock Grid.Column="2" Text="콜론( : ) 대체 문자" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" x:Name="ColonReplacementBox" Margin="12,0,0,0"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="앨범 트랙 패턴" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="AlbumPatternBox" Margin="12,0,24,0"/>
                    <TextBlock Grid.Column="2" Text="기타 금지문자 대체" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" x:Name="OtherReplacementBox" Margin="12,0,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="규칙 저장" Appearance="Primary" Click="SaveRules_Click"/>
                    <Button Content="규칙 기본값으로" Margin="8,0,0,0" Click="ResetRules_Click"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="대상 폴더" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="FolderBox" IsReadOnly="True" Margin="12,0"/>
                <Button Grid.Column="2" Content="찾아보기..." Click="Browse_Click"/>
                <CheckBox Grid.Column="3" x:Name="IsAlbumCheck" Content="앨범 폴더(트랙 번호 포함)" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Grid.Column="4" Content="미리보기" Margin="16,0,0,0" Click="Preview_Click"/>
                <ui:Button Grid.Column="5" Content="적용" Margin="8,0,0,0" Appearance="Primary" Click="Apply_Click"/>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Row="2" Padding="0">
            <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="기존 파일명" Binding="{Binding OldName}" Width="2*"/>
                    <DataGridTextColumn Header="새 파일명" Binding="{Binding NewName}" Width="2*"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>
    </Grid>
</Page>
