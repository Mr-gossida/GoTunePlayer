<Page x:Class="TuneSync.App.Views.PlayView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:views="clr-namespace:TuneSync.App.Views"
      xmlns:conv="clr-namespace:TuneSync.App.Converters"
      d:DataContext="{d:DesignInstance Type=vm:PlayPageViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="플레이"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Foreground: a Page doesn't inherit the window's theme text color (it falls back to black),
         so every page sets it explicitly. The background is the window's cover-tinted backdrop. -->
    <Page.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:PathLeafConverter x:Key="PathLeafConverter"/>
        <conv:GroupIconConverter x:Key="GroupIconConverter"/>

        <!-- Audio quality line: [Hi-Res | Lossless] FLAC · 24bit · 96kHz · 2,304kbps.
             Content is the PlaybackViewModel. -->
        <DataTemplate x:Key="QualityLineTemplate">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                        BorderThickness="1" BorderBrush="{DynamicResource PlayerAccentBrush}"
                        Visibility="{Binding HasQualityBadge, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <TextBlock Text="{Binding QualityBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PlayerAccentBrush}"/>
                </Border>
                <TextBlock Text="{Binding QualityText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Queue rows: flat, rounded hover/selection instead of the default accent block. -->
        <Style x:Key="QueueItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <!-- Group heading above a group's first song (LibraryViewModel.UpdateGroupHeaders).
                                 Not WPF grouping, which built every row up front. Not clickable. -->
                            <Grid x:Name="GroupHeading" Margin="6,14,18,4" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Margin="0,0,6,0" FontSize="14"
                                               Symbol="{Binding DataContext.PlaylistGroup, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource GroupIconConverter}}"
                                               Foreground="{DynamicResource PlayerAccentBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding GroupHeader, Converter={StaticResource PathLeafConverter}}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PlayerAccentBrush}"/>
                                <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <Run Text="{Binding GroupCount, Mode=OneWay}"/><Run Text="곡"/>
                                </TextBlock>
                            </Grid>
                            <!-- Right margin: room for the overlay scrollbar, so it never covers the durations. -->
                            <Grid Margin="0,1,12,1">
                                <!-- the search's current hit: tinted in the accent color with a bar at the left -->
                                <Border x:Name="HitFill" CornerRadius="6" Background="{DynamicResource PlayerAccentBrush}" Opacity="0" IsHitTestVisible="False"/>
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <Border x:Name="HitBar" Width="3" CornerRadius="1.5" Margin="0,5" HorizontalAlignment="Left"
                                        Background="{DynamicResource PlayerAccentBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding GroupHeader}" Value="{x:Null}">
                                <Setter TargetName="GroupHeading" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                <Setter TargetName="HitBar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- a flash that settles into a steady tint -->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HitFill" Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.5"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0.2">
                                                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HitFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dense rows (촘촘한 목록): one line per song, no cover. -->
        <Style x:Key="QueueCompactItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource QueueItemStyle}">
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <DataTemplate x:Key="QueueCompactTemplate">
            <Grid ToolTip="{Binding FileName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox x:Name="Eq" Width="12" Height="11" HorizontalAlignment="Left" Visibility="Collapsed">
                    <views:EqualizerBars BarBrush="{DynamicResource PlayerAccentBrush}"
                                         IsActive="{Binding DataContext.Playback.IsPlaying, RelativeSource={RelativeSource AncestorType=Page}}"/>
                </Viewbox>
                <Border x:Name="HoverPlay" Width="18" Height="18" Margin="-3,0,0,0" CornerRadius="9" HorizontalAlignment="Left"
                        Background="Transparent" Cursor="Hand" ToolTip="재생" Visibility="Collapsed" MouseLeftButtonUp="PlayItem_Click">
                    <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Foreground="{DynamicResource PlayerAccentBrush}"/>
                </Border>
                <TextBlock x:Name="Line" Grid.Column="1" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Run Text="{Binding PrimaryText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding SecondaryText, Mode=OneWay}" FontSize="12"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,2,0">
                    <Border CornerRadius="7" Padding="5,0" Margin="0,0,6,0" Background="{DynamicResource PlayerAccentBrush}" ToolTip="다음에 재생할 곡"
                            Visibility="{Binding IsUpNext, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding UpNextOrder}" Foreground="{DynamicResource PlayerOnAccentBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                    <Setter TargetName="Eq" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="HoverPlay" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Eq" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Cover grid (그리드): covers with soft shadows and the song over a dark fade, like a
             music app's album wall; sized by VirtualizingTilePanel. Hover lifts a tile a little;
             a selected one is tinted with a check mark instead of getting an outline. -->
        <Style x:Key="QueueTileStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Margin="6" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Lift" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <!-- the shadow, cast by a shape tucked inside the cover's edge (a shape the
                                 cover's size showed as a thin dark line around its rounded corners) -->
                            <Border CornerRadius="10" Margin="4" Background="#FF000000">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="Shadow" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter/>
                            <Border x:Name="Tint" CornerRadius="10" Background="{DynamicResource PlayerAccentBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="Ring" CornerRadius="10" BorderThickness="3" BorderBrush="{DynamicResource PlayerAccentBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="Check" Width="24" Height="24" CornerRadius="12" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{DynamicResource PlayerAccentBrush}" BorderBrush="#E6FFFFFF" BorderThickness="1.5"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource PlayerOnAccentBrush}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="BlurRadius" To="24" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.22"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="QueueTileTemplate">
            <Grid ToolTip="{Binding FileName}">
                <Border x:Name="NoCover" CornerRadius="10" Background="{DynamicResource PlayerHoverBrush}" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="30" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Border>
                <Border CornerRadius="10">
                    <Border.Background>
                        <!-- a hair trimmed off each edge: older thumbnails have a thin dark border -->
                        <ImageBrush ImageSource="{Binding CoverThumbnail}" Stretch="UniformToFill" Viewbox="0.015,0.015,0.97,0.97"/>
                    </Border.Background>
                </Border>
                <!-- the song, over a fade that starts well above the text so it reads on any cover -->
                <Border VerticalAlignment="Bottom" Padding="10,30,10,9" CornerRadius="0,0,10,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#73000000" Offset="0.4"/>
                            <GradientStop Color="#D9000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="{Binding PrimaryText}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SecondaryText}" FontSize="11" Margin="0,2,0,0" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <!-- the playing song: an equalizer on a frosted chip -->
                <!-- the playing song: its moving equalizer on a small dark disc -->
                <Border x:Name="PlayingBadge" Width="28" Height="28" CornerRadius="14" Padding="7" Margin="8"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Background="#B3000000" Visibility="Collapsed" ToolTip="재생 중">
                    <views:EqualizerBars BarBrush="{DynamicResource PlayerAccentBrush}"
                                         IsActive="{Binding DataContext.Playback.IsPlaying, RelativeSource={RelativeSource AncestorType=Page}}"/>
                </Border>
                <Border CornerRadius="11" Padding="8,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource PlayerAccentBrush}" ToolTip="다음에 재생할 곡"
                        Visibility="{Binding IsUpNext, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PlayerOnAccentBrush}">
                        <Run Text="다음"/><Run Text=" "/><Run Text="{Binding UpNextOrder, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
                <!-- hover: a round play button in the cover's color -->
                <Border x:Name="HoverPlay" Width="46" Height="46" CornerRadius="23" Opacity="0" IsHitTestVisible="False" Cursor="Hand" ToolTip="재생"
                        Background="{DynamicResource PlayerAccentBrush}" MouseLeftButtonUp="PlayItem_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.4" Color="Black" RenderingBias="Performance"/>
                    </Border.Effect>
                    <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="22" Margin="3,0,0,0" Foreground="{DynamicResource PlayerOnAccentBrush}"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="HoverPlay" Property="IsHitTestVisible" Value="True"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverPlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverPlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                    <Setter TargetName="PlayingBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CoverThumbnail}" Value="{x:Null}">
                    <Setter TargetName="NoCover" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ========== Now playing: cover + info | synced lyrics ========== -->
        <Grid x:Name="NowPlayingGrid" Grid.Column="0" Margin="48,24,32,24" DataContext="{Binding Playback}"
              Visibility="{Binding DataContext.Library.HasNoFiles, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Narrow window (ApplyResponsiveLayout): a small cover + title strip on top and the
                 lyrics below it, instead of the big cover beside the lyrics. -->
            <Grid x:Name="CompactHeader" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="SmallCover" Width="88" Height="88" Margin="0,0,16,0">
                    <Border CornerRadius="8" Background="{DynamicResource PlayerHoverBrush}">
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Border>
                    <Border CornerRadius="8">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentCoverSmall}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NowPlayingTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding NowPlayingTitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding NowPlayingSubtitle}" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding NowPlayingDetails}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource QualityLineTemplate}" Margin="0,4,0,0" Focusable="False"/>
                    <views:SpectrumView Playback="{Binding}" Look="{Binding SpectrumLook}" CycleOnClick="True" BarBrush="{DynamicResource PlayerAccentBrush}" Height="21" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="NowPlayingPanel" Grid.Column="0" Grid.RowSpan="2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Width" Value="300"/>
                        <Setter Property="Margin" Value="0,0,48,0"/>
                        <Style.Triggers>
                            <!-- Lyrics hidden: the cover alone, larger and centered. -->
                            <DataTrigger Binding="{Binding IsLyricsVisible}" Value="False">
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Width" Value="400"/>
                                <Setter Property="Margin" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Square; its size is set from code (PlayView.FitNowPlayingPanel) to fit the window. -->
                <Grid x:Name="BigCover" Width="300" Height="300" HorizontalAlignment="Left" Cursor="Hand" ToolTip="음악 집중 모드 (F11)"
                      MouseEnter="BigCover_MouseEnter" MouseLeave="BigCover_MouseLeave" MouseLeftButtonUp="BigCover_Click">
                    <Border CornerRadius="10" Background="{DynamicResource PlayerHoverBrush}">
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="80" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Border>
                    <Border CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                    <!-- On hover: a soft shade and what a click does (음악 집중 모드). -->
                    <Border x:Name="FocusHint" CornerRadius="10" Background="#59000000" Opacity="0" IsHitTestVisible="False">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="20" Padding="14,8" Background="#B3101010">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExpand24" FontSize="16" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="집중 모드" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding NowPlayingTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,24,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding NowPlayingSubtitle}" FontSize="16" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="PanelDetails" Text="{Binding NowPlayingDetails}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <ContentControl x:Name="PanelQuality" Content="{Binding}" ContentTemplate="{StaticResource QualityLineTemplate}" Margin="0,8,0,0" Focusable="False"/>
                <!-- Spectrum analyzer of what's playing (SpectrumView): transparent, in the cover's color. -->
                <views:SpectrumView x:Name="PanelSpectrum" Playback="{Binding}" Look="{Binding SpectrumLook}" CycleOnClick="True" BarBrush="{DynamicResource PlayerAccentBrush}" Height="42" Margin="0,18,0,0"/>
                <!-- Intro (hero card, PlayView.ApplyIntroStage): how far the opening has played. -->
                <!-- Shown/hidden from code (ApplyIntroStage), before the card is measured for its glide. -->
                <Grid x:Name="HeroGauge" Height="3" Margin="0,24,0,-27" Visibility="Collapsed">
                    <Border CornerRadius="1.5" Background="{DynamicResource PlayerTrackBrush}"/>
                    <Border CornerRadius="1.5" Background="{DynamicResource PlayerAccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <!-- driven from code (GlideIntroGauge), like the bar in the lyrics area -->
                            <ScaleTransform x:Name="HeroGaugeScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </StackPanel>

            <Grid x:Name="LyricsArea" Grid.Column="1" Grid.RowSpan="2"
                  Visibility="{Binding IsLyricsVisible, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                <!-- Synced lyrics: the current line glides to the center (LyricsScroller) while it
                     grows and brightens; the rest stay dim and the edges fade out. -->
                <!-- Intro in the narrow layout (the song info is already in the strip above): a big
                     equalizer pulse and the opening's progress until the first line. In the wide
                     layout this whole area steps aside for the hero card instead. -->
                <StackPanel x:Name="IntroPulse" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="16"/>
                    </StackPanel.RenderTransform>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIntroVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.25" Duration="0:0:0.7"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" BeginTime="0:0:0.25" Duration="0:0:0.7">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-16" Duration="0:0:0.5">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <views:EqualizerBars BarBrush="{DynamicResource PlayerAccentBrush}" IsActive="{Binding IsPlaying}">
                        <views:EqualizerBars.LayoutTransform>
                            <ScaleTransform ScaleX="3.5" ScaleY="3.5"/>
                        </views:EqualizerBars.LayoutTransform>
                    </views:EqualizerBars>
                    <Grid x:Name="PulseGauge" Width="160" Height="3" Margin="0,32,0,0"
                          Visibility="{Binding ShowIntroGauge, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                        <Border CornerRadius="1.5" Background="{DynamicResource PlayerTrackBrush}"/>
                        <Border CornerRadius="1.5" Background="{DynamicResource PlayerAccentBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <!-- driven from code (GlideIntroGauge): smooth between position updates -->
                                <ScaleTransform x:Name="IntroGaugeScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>                </StackPanel>

                <ScrollViewer x:Name="LyricsScrollViewer"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              PreviewMouseWheel="LyricsScrollViewer_PreviewMouseWheel"
                              SizeChanged="LyricsScrollViewer_SizeChanged"
                              Visibility="{Binding HasSyncedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Style.Triggers>
                                <!-- Hidden during the intro (PlayView.ApplyIntroStage handles the
                                     dramatic reveal afterwards); ignore the mouse meanwhile so no
                                     hover highlight or "click to play from here" tooltip shows. -->
                                <DataTrigger Binding="{Binding IsIntroVisible}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <!-- Absolute coordinates (EndPoint = the view's height, kept up to date in
                         LyricsScrollViewer_SizeChanged): a relative mask is sized to what's drawn,
                         which is only the lines - the fade then fell on the first (and last) line
                         itself instead of the view's edges, dimming its top. -->
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush x:Name="LyricsFade" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,800">
                            <!-- Only a thin fade at the very edges, so lines near the top stay readable. -->
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.07"/>
                            <GradientStop Color="Black" Offset="0.93"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <!-- Margin (half the viewport above and below, so any line can sit in the middle)
                         is set from code in the same layout pass as a resize: a binding updated it
                         a frame late, which made the lines shake while the window was resized. -->
                    <ItemsControl x:Name="LyricsItems" ItemsSource="{Binding LyricsLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,3" Margin="0,2" CornerRadius="8" Cursor="Hand"
                                        ToolTip="클릭하면 이 위치부터 재생합니다" MouseLeftButtonUp="LyricLine_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- Every line is laid out at the current-line size and drawn scaled down
                                         when not current. Growing is then a pure scale: the line breaks never
                                         change mid-animation (animating FontSize re-wrapped the text every
                                         frame and shifted everything below it). -->
                                    <TextBlock x:Name="LineText" Text="{Binding Text}" TextWrapping="Wrap"
                                               FontSize="28" FontWeight="Bold" Opacity="0.32" RenderTransformOrigin="0,0.5"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform ScaleX="0.72" ScaleY="0.72"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.5"/>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.72" Duration="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="LineText" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.72" Duration="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Top margin: room for the "싱크 가사 만들기" button above the text. -->
                <ScrollViewer x:Name="PlainLyricsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,52,0,0"
                              Visibility="{Binding HasPlainLyricsOnly, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <!-- Unsynced lyrics pour in from the top, line after line (PlainLine_Loaded). -->
                    <ItemsControl x:Name="PlainLyricsItems" ItemsSource="{Binding PlainLyricsLines}" Margin="14,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="17" LineHeight="32" Opacity="0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Loaded="PlainLine_Loaded"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Plain lyrics: offer to time them (LyricsSyncWindow). -->
                <ui:Button Content="싱크 가사 만들기" Icon="{ui:SymbolIcon Sparkle24}" Click="MakeSyncedLyrics_Click"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,24,0" Panel.ZIndex="10"
                           Padding="12,6" CornerRadius="16" BorderThickness="0"
                           Background="{DynamicResource PlayerHoverBrush}" MouseOverBackground="{DynamicResource PlayerTrackBrush}"
                           ToolTip="음성 인식으로 각 줄의 시간을 자동으로 맞추고, 들어보며 고칠 수 있습니다"
                           Visibility="{Binding HasPlainLyricsOnly, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>

                <!-- Shown after scrolling the lyrics away by hand: back to the line being sung. -->
                <ui:Button x:Name="BackToLyricButton" Content="현재 가사로" Icon="{ui:SymbolIcon ArrowSync24}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Panel.ZIndex="10"
                           Padding="14,6" CornerRadius="16" BorderThickness="0" FontWeight="SemiBold" Visibility="Collapsed"
                           Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                           MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                           PressedForeground="{DynamicResource PlayerOnAccentBrush}" Click="BackToLyric_Click"/>

                <!-- No lyrics: hovering reveals "가사 찾기", which searches online for this song and
                     offers the result to save right here (PlayPageViewModel). -->
                <Border x:Name="NoLyricsCard" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Padding="32,24" CornerRadius="14"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                        Visibility="{Binding Playback.HasNoLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Idle -->
                        <StackPanel Visibility="{Binding FindState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Idle}">
                            <ui:SymbolIcon Symbol="SlideText24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="가사가 없는 곡입니다" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="온라인에서 이 곡의 가사를 찾아 바로 넣을 수 있습니다." FontSize="12" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ui:Button Content="가사 찾기" Icon="{ui:SymbolIcon Search24}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                       Padding="18,8" CornerRadius="18" BorderThickness="0" FontWeight="SemiBold"
                                       Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                                       MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                                       PressedForeground="{DynamicResource PlayerOnAccentBrush}"
                                       Command="{Binding FindLyricsCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=NoLyricsCard}" Value="True">
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>

                        <!-- Searching -->
                        <StackPanel Visibility="{Binding FindState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Searching}">
                            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="가사를 찾는 중…" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:Button Content="취소" HorizontalAlignment="Center" Margin="0,12,0,0" Command="{Binding CancelFindCommand}"
                                       Background="Transparent" BorderThickness="0"/>
                        </StackPanel>

                        <!-- Found: preview before saving -->
                        <StackPanel Visibility="{Binding FindState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Found}">
                            <TextBlock Text="{Binding FoundSummary}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PlayerAccentBrush}"/>
                            <TextBlock Text="{Binding FoundPreview}" FontSize="15" LineHeight="26" Margin="0,12,0,0" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="…" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <ui:Button Content="저장하고 보기" Icon="{ui:SymbolIcon Checkmark24}" Padding="18,8" CornerRadius="18"
                                           BorderThickness="0" FontWeight="SemiBold"
                                           Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                                           MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                                           PressedForeground="{DynamicResource PlayerOnAccentBrush}"
                                           Command="{Binding SaveFoundLyricsCommand}" ToolTip="이 가사를 음악 파일에 저장합니다"/>
                                <ui:Button Content="취소" Margin="8,0,0,0" Padding="16,8" CornerRadius="18"
                                           Background="Transparent" BorderThickness="0" Command="{Binding CancelFindCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Not found -->
                        <StackPanel Visibility="{Binding FindState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=NotFound}">
                            <ui:SymbolIcon Symbol="SearchInfo24" FontSize="34" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="가사를 찾지 못했습니다" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="제목과 아티스트 태그가 정확한지 확인해 보세요." FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <ui:Button Content="다시 찾기" Icon="{ui:SymbolIcon ArrowClockwise24}" Padding="16,8" CornerRadius="18"
                                           Command="{Binding FindLyricsCommand}"/>
                                <ui:Button Content="태그 관리에서 보기" Icon="{ui:SymbolIcon Tag24}" Margin="8,0,0,0" Padding="16,8" CornerRadius="18"
                                           Click="OpenCurrentInTagManager_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasCurrentFile, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="재생할 곡을 골라 주세요" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="재생 대기열에서 곡을 두 번 클릭하거나 ▶ 버튼을 누르면 재생됩니다." FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Track change: a snapshot of the previous song's screen fades out on top while the new
             one fades in underneath (PlayView.Crossfade). -->
        <Image x:Name="CrossfadeSnapshot" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- Layout switch (wide <-> narrow): the cover glides here from its old spot to its new one. -->
        <Canvas x:Name="TransitionLayer" Grid.Column="0" IsHitTestVisible="False"/>

        <!-- ========== Registered folders can't be reached (a NAS / server that's off) ========== -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                    Visibility="{Binding Library.IsOffline, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
            <Border Width="104" Height="104" CornerRadius="28" Background="{DynamicResource PlayerHoverBrush}" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="CloudOff24" FontSize="48" Foreground="{DynamicResource PlayerAccentBrush}"/>
            </Border>
            <TextBlock Text="음악 폴더에 연결할 수 없습니다" FontSize="24" FontWeight="SemiBold" Margin="0,24,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="등록된 "/><Run Text="{Binding Library.UnreachableNames, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="에 접근할 수 없습니다. 서버나 NAS가 켜져 있고 네트워크에 연결되어 있는지 확인해 주세요."/>
            </TextBlock>
            <TextBlock FontSize="12" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="다시 연결되면 자동으로 목록을 불러옵니다. 등록된 목록은 그대로 남아 있습니다."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <ui:Button Content="다시 연결" Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Padding="20,10" CornerRadius="20" BorderThickness="0" FontWeight="SemiBold"
                           Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                           MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                           PressedForeground="{DynamicResource PlayerOnAccentBrush}"
                           Command="{Binding Library.ReconnectCommand}"/>
                <ui:Button Content="폴더 또는 파일 추가" Icon="{ui:SymbolIcon FolderAdd24}" Margin="10,0,0,0"
                           Padding="20,10" CornerRadius="20" FontWeight="SemiBold"
                           Background="{DynamicResource PlayerHoverBrush}" BorderBrush="{DynamicResource PlayerAccentBrush}" BorderThickness="1"
                           Command="{Binding Library.AddFoldersCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- ========== Registered folders, first load still running ========== -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Library.IsLoadingEmpty, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
            <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"/>
            <TextBlock Text="음악 목록을 불러오는 중…" FontSize="16" Margin="0,16,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{Binding Library.StatusText}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- ========== Empty library: one clear way in ========== -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding Library.IsWelcome, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
            <Border Width="104" Height="104" CornerRadius="28" Background="{DynamicResource PlayerHoverBrush}" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="MusicNote224" FontSize="48" Foreground="{DynamicResource PlayerAccentBrush}"/>
            </Border>
            <TextBlock Text="음악을 추가해 시작하세요" FontSize="24" FontWeight="SemiBold" Margin="0,24,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock FontSize="14" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="이 PC의 음악 폴더나 파일, 또는 NAS·서버·클라우드(WebDAV, Samba, SFTP, FTP)의 음악을 추가하면 태그·커버·가사를 읽어 재생 대기열을 만듭니다."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <ui:Button Content="폴더 또는 파일 추가" Icon="{ui:SymbolIcon FolderAdd24}"
                           Padding="20,10" CornerRadius="20" BorderThickness="0" FontWeight="SemiBold"
                           Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                           MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                           PressedForeground="{DynamicResource PlayerOnAccentBrush}"
                           Command="{Binding Library.AddFoldersCommand}"/>
                <ui:Button Content="네트워크 위치 추가" Icon="{ui:SymbolIcon CloudAdd24}" Margin="10,0,0,0"
                           Padding="20,10" CornerRadius="20" FontWeight="SemiBold"
                           Background="{DynamicResource PlayerHoverBrush}" BorderBrush="{DynamicResource PlayerAccentBrush}" BorderThickness="1"
                           MouseOverBackground="{DynamicResource PlayerHoverBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Command="{Binding Library.AddNetworkLocationCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- ========== Queue panel's left edge: drag to resize (snaps to the standard width) ========== -->
        <Thumb x:Name="QueueResizer" Grid.Column="1" Width="10" Margin="-5,0,0,0" HorizontalAlignment="Left" Panel.ZIndex="10"
               Cursor="SizeWE" ToolTip="끌어서 너비 조절 · 두 번 클릭하면 기본 너비"
               DragStarted="QueueResizer_DragStarted" DragDelta="QueueResizer_DragDelta" DragCompleted="QueueResizer_DragCompleted"
               MouseDoubleClick="QueueResizer_MouseDoubleClick"
               Visibility="{Binding Playback.IsQueueVisible, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Width="3" CornerRadius="1.5" HorizontalAlignment="Center" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="snapped">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource PlayerAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- ========== Queue panel (its sort/grouping also decides playback order) ========== -->
        <Border x:Name="QueuePanel" Grid.Column="1" Width="320" Background="{DynamicResource PlayerPanelBrush}" Padding="12,14,12,10"
                Visibility="{Binding Playback.IsQueueVisible, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
            <Grid DataContext="{Binding Library}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="재생 대기열" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button x:Name="SortButton" Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="16"
                                   Icon="{ui:SymbolIcon ArrowSort24}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="정렬" Click="SortButton_Click"/>
                        <ui:Button x:Name="GroupButton" Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="16"
                                   Icon="{ui:SymbolIcon GroupList24}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="그룹" Click="GroupButton_Click"/>
                        <ui:Button x:Name="ViewButton" Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="16"
                                   Icon="{ui:SymbolIcon AppsList24}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="보기 방식 (기본 / 촘촘한 목록 / 그리드)" Click="ViewButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Search: jumps the selection to matching songs (doesn't filter the list) -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <ui:TextBox x:Name="SearchBox" PlaceholderText="곡, 아티스트, 앨범 검색 (Ctrl+F)"
                                Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" Padding="10,7,60,7"
                                TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                ToolTip="제목·아티스트·앨범·파일명으로 찾습니다. Enter: 다음, Shift+Enter: 이전, ↓: 목록으로, Esc: 지우기"/>
                    <TextBlock x:Name="SearchCounter" HorizontalAlignment="Right" Margin="0,0,36,0" VerticalAlignment="Center" FontSize="11"
                               IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <ListBox Grid.Row="2" x:Name="PlaylistBox" ItemsSource="{Binding PlaylistView}"
                         ItemContainerStyle="{StaticResource QueueItemStyle}" SelectionMode="Extended"
                         SelectionChanged="PlaylistBox_SelectionChanged"
                         AllowDrop="True" DragOver="PlaylistBox_DragOver" Drop="PlaylistBox_Drop" DragLeave="PlaylistBox_DragLeave"
                         PreviewMouseLeftButtonDown="PlaylistBox_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="PlaylistBox_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="PlaylistBox_PreviewMouseMove"
                         PreviewMouseWheel="PlaylistBox_PreviewMouseWheel"
                         BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         MouseDoubleClick="PlaylistBox_MouseDoubleClick" KeyDown="PlaylistBox_KeyDown"
                         ContextMenuOpening="PlaylistBox_ContextMenuOpening"
                         ScrollViewer.ScrollChanged="PlaylistBox_ScrollChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu/>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding FileName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40" Margin="0,0,10,0">
                                    <Border CornerRadius="4" Background="{DynamicResource PlayerHoverBrush}">
                                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </Border>
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverThumbnail}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="4" Background="#8C000000"
                                            Visibility="{Binding IsNowPlaying, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                        <views:EqualizerBars BarBrush="{DynamicResource PlayerAccentBrush}"
                                                             IsActive="{Binding DataContext.Playback.IsPlaying, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                    </Border>
                                    <Border x:Name="HoverPlay" CornerRadius="4" Background="#A6000000" Visibility="Collapsed" Cursor="Hand"
                                            ToolTip="재생" MouseLeftButtonUp="PlayItem_Click">
                                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="18" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="{Binding PrimaryText}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SecondaryText}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                                    <!-- Reserved with "다음에 재생": its turn in that list. -->
                                    <Border CornerRadius="8" Padding="7,1" Margin="0,0,8,0" Background="{DynamicResource PlayerAccentBrush}"
                                            ToolTip="다음에 재생할 곡"
                                            Visibility="{Binding IsUpNext, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PlayerOnAccentBrush}">
                                            <Run Text="다음"/><Run Text=" "/><Run Text="{Binding UpNextOrder, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding DurationText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="HoverPlay" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- The group being scrolled through stays pinned at the top (PlayView.UpdateStickyGroup);
                     the list fades out under it, so no background is needed over the see-through panel. -->
                <Grid x:Name="StickyGroup" Grid.Row="2" VerticalAlignment="Top" Margin="6,6,30,0" IsHitTestVisible="False"
                      Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="StickyShift"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Margin="0,0,6,0" FontSize="14"
                                   Symbol="{Binding PlaylistGroup, Converter={StaticResource GroupIconConverter}}"
                                   Foreground="{DynamicResource PlayerAccentBrush}"/>
                    <TextBlock x:Name="StickyGroupName" Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PlayerAccentBrush}"/>
                    <TextBlock x:Name="StickyGroupCount" Grid.Column="2" Margin="8,0,0,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <!-- Where dragged songs will land. -->
                <Canvas Grid.Row="2" IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="DropLine" CornerRadius="1.5" Background="{DynamicResource PlayerAccentBrush}" Visibility="Collapsed"/>
                </Canvas>

                <TextBlock Grid.Row="2" TextWrapping="Wrap" TextAlignment="Center" Margin="12,32,12,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Top"
                           Text="아래 + 버튼으로 폴더나 음악 파일을 추가하세요."
                           Visibility="{Binding IsWelcome, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                <TextBlock Grid.Row="2" TextWrapping="Wrap" TextAlignment="Center" Margin="12,32,12,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Top"
                           Text="등록된 폴더에 음악 파일이 없습니다."
                           Visibility="{Binding IsNoSongs, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                <TextBlock Grid.Row="2" TextWrapping="Wrap" TextAlignment="Center" Margin="12,32,12,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Top"
                           Text="불러오는 중…"
                           Visibility="{Binding IsLoadingEmpty, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                <StackPanel Grid.Row="2" Margin="12,32,12,0" VerticalAlignment="Top"
                            Visibility="{Binding IsOffline, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="등록된 폴더에 연결할 수 없습니다. 연결되면 자동으로 불러옵니다."/>
                    <ui:Button Content="다시 연결" Icon="{ui:SymbolIcon ArrowClockwise24}" HorizontalAlignment="Center" Margin="0,10,0,0"
                               Padding="12,5" Command="{Binding ReconnectCommand}"/>
                </StackPanel>

                <!-- Shown while the playing song is scrolled out of view: back to it. -->
                <ui:Button x:Name="BackToCurrentButton" Grid.Row="2" Content="지금 재생 중" Icon="{ui:SymbolIcon MusicNote224}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                           Padding="14,6" CornerRadius="16" BorderThickness="0" FontWeight="SemiBold" Visibility="Collapsed"
                           Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerOnAccentBrush}"
                           MouseOverBackground="{DynamicResource PlayerAccentBrush}" PressedBackground="{DynamicResource PlayerAccentBrush}"
                           PressedForeground="{DynamicResource PlayerOnAccentBrush}" Click="BackToCurrent_Click"/>

                <views:LibrarySourceBar Grid.Row="3" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>
