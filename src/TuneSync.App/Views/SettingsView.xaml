                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="효과" FontTypography="BodyStrong"/>
                                <ui:TextBlock Style="{StaticResource Desc}"
                                              Text="글자와 버튼의 가장자리에만 두르는 효과입니다. 밝고 복잡한 화면에서 잘 안 보이면 '테두리'를 고르세요."/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center" ItemsSource="{Binding ClearEffectOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding ClearEffect}" AutomationProperties.Name="HUD 클리어 효과"/>
                        </Grid>
                    </ui:CardExpander>
                    <ui:CardControl Style="{StaticResource Card}" DataContext="{Binding Hud}" IsEnabled="{Binding CanSetOpacity}" Icon="{ui:SymbolIcon Blur24}" Tag="HUD 투명도 불투명도 반투명"
                                    ToolTip="마우스를 올리면 잠시 선명해져 버튼을 누르기 쉽습니다. HUD의 메뉴(⚙)에서도 바꿀 수 있습니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="HUD 투명도" FontTypography="Body"/>
                                <ui:TextBlock Text="낮출수록 뒤가 비쳐 보입니다" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="180" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Opacity}"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="HUD 투명도"/>
                            <TextBlock Text="{Binding OpacityText}" Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </ui:CardControl>
                    <ui:TextBlock Text="마우스" Style="{StaticResource Group}"/>
