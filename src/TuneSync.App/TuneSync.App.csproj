<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TuneSync.Core\TuneSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\TuneSync.ico</ApplicationIcon>
    <!-- What Windows shows for the app (taskbar, Task Manager, file properties). The exe keeps its
         file name so pinned shortcuts and the autostart entry keep working. -->
    <AssemblyName>GoTune</AssemblyName>
    <RootNamespace>TuneSync.App</RootNamespace>
    <Product>GoTune Player</Product>
    <AssemblyTitle>GoTune Player</AssemblyTitle>
    <Company>GoTune</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\TuneSync.png" />
    <Resource Include="Assets\TuneSync.ico" />
    <Resource Include="Effects\Aurora.ps" />
  </ItemGroup>

</Project>
