<ui:FluentWindow x:Class="TuneSync.App.Network.RemoteSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:net="clr-namespace:TuneSync.App.Network"
        Title="네트워크 위치 추가" Width="640" Height="680" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" WindowCornerPreference="Round" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Kind cards: one per protocol, the chosen one outlined in the accent color. -->
        <Style x:Key="KindCardStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Margin="0,0,8,0" Padding="10,12" CornerRadius="8" BorderThickness="2"
                                BorderBrush="Transparent" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="네트워크 위치 추가" ShowMinimize="False" ShowMaximize="False"/>

        <!-- ========== Step 1: where and how to connect ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsConnectStep, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="28,8,28,16">
                <TextBlock Text="어디에 연결할까요?" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="NAS, 서버, 클라우드에 있는 음악을 바로 재생합니다. 처음 재생할 때 내려받아 두므로 다시 들을 때는 바로 나옵니다."
                           FontSize="13" TextWrapping="Wrap" Margin="0,6,0,18" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <ListBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" ItemContainerStyle="{StaticResource KindCardStyle}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" Rows="1"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type net:KindOption}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="주소" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="AddressBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding AddressPlaceholder}" Icon="{ui:SymbolIcon Link24}"/>
                    <ui:NumberBox Grid.Column="1" Width="110" Margin="8,0,0,0" Value="{Binding Port}" PlaceholderText="{Binding PortPlaceholder}"
                                  Minimum="1" Maximum="65535" MaxDecimalPlaces="0" SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False"
                                  ToolTip="포트 (비워 두면 기본값)"
                                  Visibility="{Binding ShowPort, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <TextBlock Text="{Binding AddressHint}" FontSize="12" TextWrapping="Wrap" Margin="2,6,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="사용자 이름" Style="{StaticResource FieldLabel}"/>
                        <ui:TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding UserPlaceholder}"
                                    Icon="{ui:SymbolIcon Person24}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="비밀번호" Style="{StaticResource FieldLabel}"/>
                        <ui:PasswordBox x:Name="PasswordBox" PlaceholderText="비밀번호" Icon="{ui:SymbolIcon Key24}"
                                        PasswordChanged="PasswordBox_PasswordChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="비밀번호는 Windows 자격 증명 관리자에 암호화되어 저장됩니다." FontSize="12" Margin="2,6,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                <TextBlock Text="표시 이름 (선택)" Style="{StaticResource FieldLabel}"/>
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="예: 거실 NAS" Icon="{ui:SymbolIcon Tag24}"/>

                <CheckBox Content="인증서 확인 안 함 (자체 서명 인증서를 쓰는 NAS)" Margin="0,16,0,0" IsChecked="{Binding AcceptAnyCertificate}"
                          Visibility="{Binding ShowCertificateOption, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ========== Step 2: pick the music folder ========== -->
        <Grid Grid.Row="1" Margin="28,8,28,8" Visibility="{Binding IsBrowseStep, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="음악 폴더를 고르세요" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="폴더를 두 번 클릭하면 들어갑니다. 원하는 폴더에서 '이 폴더 추가'를 누르세요." FontSize="13" Margin="0,6,0,14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="8" Padding="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}"
                               ToolTip="상위 폴더" Width="34" Height="32" Padding="0" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding CurrentFolderLabel}" Margin="8,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ListBox x:Name="FolderList" Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding Folders}"
                     Background="Transparent" BorderThickness="0" MouseDoubleClick="FolderList_MouseDoubleClick" KeyDown="FolderList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type net:BrowseItem}">
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Folder24" FontSize="20" Foreground="#E8B84A"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding MusicCountText}" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Content="하위 폴더 포함" IsChecked="{Binding IncludeSubfolders}"/>
            </Grid>
        </Grid>

        <!-- ========== Footer: progress / error and the buttons ========== -->
        <Border Grid.Row="2" Padding="28,14" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18"/>
                    <TextBlock Text="{Binding BusyText}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="18" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                    <TextBlock Text="{Binding ErrorText}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="320" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="취소" Width="96" Click="Cancel_Click"
                               Visibility="{Binding IsConnectStep, Converter={StaticResource BoolToVisibility}}"/>
                    <ui:Button Content="연결" Width="120" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon PlugConnected24}"
                               Command="{Binding ConnectCommand}" IsDefault="True"
                               Visibility="{Binding IsConnectStep, Converter={StaticResource BoolToVisibility}}"/>
                    <ui:Button Content="뒤로" Width="96" Command="{Binding BackCommand}" Icon="{ui:SymbolIcon ArrowLeft24}"
                               Visibility="{Binding IsBrowseStep, Converter={StaticResource BoolToVisibility}}"/>
                    <ui:Button Content="이 폴더 추가" Width="140" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                               Command="{Binding AddFolderCommand}"
                               Visibility="{Binding IsBrowseStep, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
