<ui:FluentWindow x:Class="TuneSync.App.BatchSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TuneSync.App"
        xmlns:conv="clr-namespace:TuneSync.App.Converters"
        Title="싱크 가사 일괄 만들기" Width="680" Height="780" MinWidth="560" MinHeight="540"
        WindowStartupLocation="Manual" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" WindowCornerPreference="Round" ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- The batch of 싱크 가사 만들기 (BatchSyncViewModel). Not owned by the main window: it can
         run for hours, minimized or behind the player; the taskbar button shows its progress. -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressValue="{Binding OverallProgress}" ProgressState="{Binding TaskbarState}"/>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/SyncStepChips.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            </Style>

            <!-- One song in the list: [state] [cover] title / artist ... status [확인]. The song in
                 progress is tinted with the accent and has an accent bar, like the sync editor's
                 playing line. -->
            <Style x:Key="SongItemStyle" TargetType="ListBoxItem">
                <!-- a click picks the song (after the work; the row's buttons take their own clicks) -->
                <EventSetter Event="MouseLeftButtonUp" Handler="SongRow_MouseLeftButtonUp"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid Margin="0,1,10,1">
                                <Border x:Name="Hover" CornerRadius="6" Background="Transparent"/>
                                <Border x:Name="Tint" CornerRadius="6" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0"/>
                                <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,8" HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="8,6,8,6"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.1"/>
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.16"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="싱크 가사 일괄 만들기" ShowMaximize="False"/>

        <!-- The whole batch: how far, what came of it, how long is left -->
        <Grid Grid.Row="1" Margin="24,6,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Text="{Binding CountText}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResultText}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <TextBlock Text="{Binding RemainingText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding FinishAtText}" FontSize="12" Margin="0,2,0,0" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding OverallProgress, Mode=OneWay}" Maximum="1" Height="6" Margin="0,12,0,0"/>
        </Grid>

        <!-- The song in progress; once nothing runs, how it ended. Both share one cell so the
             list below doesn't move when the batch stops or ends. -->
        <Border Grid.Row="2" Margin="24,0,24,14" Style="{StaticResource Card}" MinHeight="118">
            <Grid>
                <!-- working on a song -->
                <Grid Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44" Margin="0,0,12,0">
                        <Border CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="{Binding IsDownloading, Converter={x:Static local:BatchSyncWindow.HeaderIcon}}" FontSize="20"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Border>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Current.File.CoverThumbnail}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Current.File.DisplayTitle}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Text" Value="처리 모델을 받는 중"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current}" Value="{x:Null}">
                                            <Setter Property="Text" Value="준비하는 중…"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Current.File.Artist}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Text" Value="처음 한 번만 받습니다. 노래와 가사는 외부로 보내지 않습니다."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- what it runs on: the same badge as the sync editor's -->
                    <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="4" Padding="7,2" Margin="12,0,0,0"
                            Background="{DynamicResource PlayerAccentBrush}"
                            ToolTip="지금 이 장치로 처리하고 있습니다. 설정 › 도구 › 가사 싱크에서 바꿀 수 있습니다.">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProcessingDevice}" Value="">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PlayerOnAccentBrush}">
                            <Run Text="Processing on"/> <Run Text="{Binding ProcessingDevice, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{Binding Steps}" Margin="-4,12,0,0" Focusable="False"
                                  ItemTemplate="{StaticResource SyncStepChipTemplate}" MinHeight="22">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StepPercent}" FontSize="12" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <ProgressBar Value="{Binding StepProgress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- stopped or finished -->
                <Grid VerticalAlignment="Center"
                      Visibility="{Binding IsRunning, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                        <!-- finished: the accent; stopped or undone: a quiet grey -->
                        <Ellipse>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOutcomeQuiet}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <ui:SymbolIcon Symbol="{Binding OutcomeSymbol}" FontSize="22" Filled="True"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OutcomeTitle}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OutcomeText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" local:KeepWords.IsEnabled="True"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ui:Button Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Appearance="Primary"
                               Icon="{ui:SymbolIcon Play24}" Command="{Binding ResumeCommand}"
                               Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ResumeText}"/>
                    </ui:Button>
                </Grid>
            </Grid>
        </Border>

        <!-- list heading -->
        <Grid Grid.Row="3" Margin="26,0,26,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="곡 목록" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <!-- quick picks, once there's something to pick -->
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                            Visibility="{Binding CanPick, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Content="모두 선택" Command="{Binding SelectAllCommand}" Appearance="Transparent"
                               Padding="6,1" FontSize="12" ToolTip="저장했거나 되돌린 곡을 모두 고릅니다 (Ctrl+A)"/>
                    <ui:Button Content="확인 필요한 곡 선택" Command="{Binding SelectNeedsCheckCommand}" Appearance="Transparent"
                               Padding="6,1" FontSize="12" Margin="2,0,0,0"
                               Visibility="{Binding HasNeedsCheck, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="노란 점이 있는 곡만 고릅니다"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="음성 인식이 또렷이 듣지 못해 앞뒤 줄로 추정한 시간이 있는 곡입니다. '확인'을 눌러 들어보고 고칠 수 있습니다.">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="추정한 줄이 있어 확인이 필요한 곡" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- the songs -->
        <ListBox x:Name="SongList" Grid.Row="4" Margin="16,0,10,0" ItemsSource="{Binding Items}"
                 ItemContainerStyle="{StaticResource SongItemStyle}" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- where it is -->
                        <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse x:Name="WaitingMark" Width="14" Height="14" StrokeThickness="1.5"
                                     Stroke="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ui:ProgressRing x:Name="ActiveMark" IsIndeterminate="True" Width="16" Height="16" Visibility="Collapsed"/>
                            <Grid x:Name="DoneMark" Visibility="Collapsed">
                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <ui:SymbolIcon Symbol="Checkmark12" FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Grid>
                            <ui:SymbolIcon x:Name="OtherMark" FontSize="20" Visibility="Collapsed"/>
                            <!-- in place of the mark while picking, or under the pointer -->
                            <CheckBox x:Name="PickBox" IsChecked="{Binding IsSelected}" Visibility="Collapsed"
                                      MinWidth="0" MinHeight="0" Padding="0" Margin="-1,0,0,0" Focusable="False"
                                      ToolTip="이 곡 선택"/>
                        </Grid>

                        <Grid Grid.Column="1" Width="36" Height="36" Margin="0,0,10,0">
                            <Border CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <ui:SymbolIcon Symbol="MusicNote224" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </Border>
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding File.CoverThumbnail}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Text="{Binding File.DisplayTitle}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding File.Artist}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Ellipse x:Name="CheckDot" Width="8" Height="8" Margin="0,0,6,0" Visibility="Collapsed"
                                     Fill="{DynamicResource SystemFillColorCautionBrush}"/>
                            <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12" ToolTip="{Binding Detail}"
                                       MaxWidth="300" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- this song alone: shown under the pointer, its room kept so the row doesn't shift -->
                            <ui:Button x:Name="UndoButton" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Transparent"
                                       Padding="6,4" Margin="8,0,0,0" Click="UndoOne_Click" Visibility="Collapsed"
                                       ToolTip="이 곡만 작업 전으로 되돌립니다 (창을 닫기 전까지 다시 저장할 수 있습니다)"/>
                            <ui:Button x:Name="SaveButton" Content="다시 저장" Icon="{ui:SymbolIcon Save24}"
                                       Appearance="Transparent" Padding="8,3" FontSize="12" Margin="8,0,0,0"
                                       Click="SaveOne_Click" Visibility="Collapsed"
                                       ToolTip="되돌린 싱크 가사를 다시 저장합니다"/>
                            <ui:Button x:Name="ReviewButton" Content="확인" Icon="{ui:SymbolIcon Headphones24}"
                                       Appearance="Transparent" Padding="8,3" FontSize="12" Margin="4,0,0,0"
                                       Click="Review_Click" Visibility="Collapsed"
                                       ToolTip="싱크 편집에서 들어보며 시간을 고칩니다"/>
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="WaitingMark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="WaitingMark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DoneMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Setter TargetName="ReviewButton" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NeedsCheck}" Value="True">
                            <Setter TargetName="CheckDot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                            <Setter TargetName="WaitingMark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OtherMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OtherMark" Property="Symbol" Value="SubtractCircle24"/>
                            <Setter TargetName="OtherMark" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                            <Setter TargetName="WaitingMark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OtherMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OtherMark" Property="Symbol" Value="ErrorCircle24"/>
                            <Setter TargetName="OtherMark" Property="Filled" Value="True"/>
                            <Setter TargetName="OtherMark" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUndone}" Value="True">
                            <Setter TargetName="WaitingMark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OtherMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="OtherMark" Property="Symbol" Value="ArrowUndo24"/>
                            <Setter TargetName="OtherMark" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </DataTrigger>
                        <!-- after the work: a saved song keeps room for its 되돌리기, an undone one offers 다시 저장 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsDone}" Value="True"/>
                                <Condition Binding="{Binding DataContext.CanPick, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="UndoButton" Property="Visibility" Value="Hidden"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsDone}" Value="True"/>
                                <Condition Binding="{Binding DataContext.CanPick, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="UndoButton" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsUndone}" Value="True"/>
                                <Condition Binding="{Binding DataContext.CanPick, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="SaveButton" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                        <!-- the check box: while picking, or under the pointer -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanSelect}" Value="True"/>
                                <Condition Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PickBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="DoneMark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OtherMark" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanSelect}" Value="True"/>
                                <Condition Binding="{Binding DataContext.CanPick, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PickBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="DoneMark" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="OtherMark" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="24,12,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding FooterHint}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" local:KeepWords.IsEnabled="True"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding HasSelection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}"/>
            <!-- picking: how many, and letting them all go -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SelectionText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ui:Button Content="선택 해제" Command="{Binding ClearSelectionCommand}" Appearance="Transparent"
                           Padding="8,3" FontSize="12" Margin="8,0,0,0" ToolTip="선택을 모두 풉니다 (Esc)"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon ArrowUndo24}" Margin="0,0,8,0" Command="{Binding UndoSelectedCommand}"
                           Visibility="{Binding CanUndoSelected, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="고른 곡의 가사를 작업 전으로 되돌립니다. 창을 닫기 전까지 다시 저장할 수 있습니다.">
                    <TextBlock Text="{Binding UndoSelectedText}"/>
                </ui:Button>
                <ui:Button Icon="{ui:SymbolIcon Save24}" Margin="0,0,8,0" Command="{Binding SaveSelectedCommand}"
                           Visibility="{Binding CanSaveSelected, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="고른 곡 중 되돌린 곡의 싱크 가사를 다시 저장합니다">
                    <TextBlock Text="{Binding SaveSelectedText}"/>
                </ui:Button>
                <ui:Button Content="모두 되돌리기" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Transparent" Margin="0,0,8,0"
                           Command="{Binding UndoAllCommand}"
                           ToolTip="이 작업에서 저장한 곡의 가사를 작업 전으로 되돌립니다">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanUndoAll}" Value="True"/>
                                        <Condition Binding="{Binding HasSelection}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Icon="{ui:SymbolIcon RecordStop24}" Command="{Binding StopCommand}"
                           IsEnabled="{Binding IsStopping, Converter={StaticResource InverseBooleanConverter}}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="지금 곡을 멈추고 남은 곡은 그대로 둡니다. 끝난 곡은 저장되어 있습니다.">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="중지"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStopping}" Value="True">
                                        <Setter Property="Text" Value="중지하는 중…"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ui:Button>
                <ui:Button x:Name="CloseButton" Content="닫기" Click="Close_Click"
                           Visibility="{Binding IsRunning, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                    <Setter Property="Appearance" Value="Primary"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
