<Page x:Class="TuneSync.App.Views.LibraryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:TuneSync.App.Views"
      Title="음악 라이브러리">
    <Page.Resources>
        <local:FileNameConverter x:Key="FileNameConverter"/>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="음악 라이브러리" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="왼쪽 트리에서 폴더를 찾아 들어가고, 파일을 선택하면 오른쪽에 커버·이름 규칙·가사·태그 작업 패널이 나타납니다."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="780"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Explorer-style folder tree -->
            <ui:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Margin="12" HorizontalAlignment="Stretch" Content="다른 폴더 열기..." Click="OpenFolder_Click"/>
                    <TreeView Grid.Row="1" x:Name="FolderTree" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ui:SymbolIcon Symbol="Folder24" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </ui:Card>

            <!-- Right: file list + selection-driven task panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="PathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="왼쪽에서 폴더를 선택하세요"/>
                        <CheckBox Grid.Column="1" x:Name="IncludeSubfoldersCheck" Content="하위 폴더 포함" VerticalAlignment="Center" Margin="12,0" Checked="IncludeSubfolders_Changed" Unchecked="IncludeSubfolders_Changed"/>
                        <RadioButton Grid.Column="2" x:Name="ListModeRadio" Content="목록" GroupName="ViewMode" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" Checked="ListModeRadio_Checked"/>
                        <RadioButton Grid.Column="3" x:Name="GridModeRadio" Content="격자" GroupName="ViewMode" VerticalAlignment="Center" Margin="8,0,0,0" Checked="GridModeRadio_Checked"/>
                        <Button Grid.Column="4" Content="새로고침" Margin="16,0,0,0" Click="Refresh_Click"/>
                    </Grid>
                </ui:Card>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="450"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="300" MinWidth="260" MaxWidth="420"/>
                    </Grid.ColumnDefinitions>

                    <ui:Card Grid.Column="0" Padding="0">
                        <Grid>
                            <DataGrid x:Name="FileListGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                                      HorizontalScrollBarVisibility="Auto"
                                      SelectionChanged="FileList_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="220" MinWidth="160"/>
                                    <DataGridTextColumn Header="아티스트" Binding="{Binding Tags.Artist}" Width="120" MinWidth="100"/>
                                    <DataGridTextColumn Header="제목" Binding="{Binding Tags.Title}" Width="150" MinWidth="120"/>
                                    <DataGridTextColumn Header="앨범" Binding="{Binding Tags.Album}" Width="150" MinWidth="120"/>
                                    <DataGridTextColumn Header="커버" Binding="{Binding HasCoverMark}" Width="50" MinWidth="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="가사" Binding="{Binding HasLyricsMark}" Width="50" MinWidth="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <ListBox x:Name="FileGridBox" Visibility="Collapsed" SelectionMode="Extended"
                                     BorderThickness="0" Background="Transparent"
                                     SelectionChanged="FileList_SelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="120" Margin="6">
                                            <Border Width="108" Height="108" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </ui:Card>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" Background="{DynamicResource ControlFillColorDefaultBrush}" Cursor="SizeWE"/>

                    <!-- Selection-driven task panel -->
                    <ui:Card Grid.Column="2" Padding="0">
                        <TabControl x:Name="TaskTabs" BorderThickness="0" Background="Transparent">
                            <TabItem Header="자동 검색">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="자동 검색" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="AutoMatchTargetInfo" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                                   Text="MusicBrainz에서 태그를, Cover Art Archive에서 커버를, LRCLIB에서 가사를 찾아 비교합니다. 기존 태그가 비었거나 매칭이 안 되면 건너뜁니다."/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                        <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Click="RunAutoMatch_Click">
                                            <TextBlock Text="자동 검색 실행" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </ui:Button>
                                        <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="ApplyAutoMatch_Click">
                                            <TextBlock Text="선택 항목 적용" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </ui:Button>
                                        <TextBlock x:Name="AutoMatchStatusText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"/>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="AutoMatchList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Card Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding ArtistDiff}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                                <TextBlock Text="{Binding TitleDiff}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding AlbumDiff}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <TextBlock Text="{Binding CoverStatus, StringFormat=커버: {0}}" FontSize="11" Margin="0,0,12,0"/>
                                                                    <TextBlock Text="{Binding LyricsStatus, StringFormat=가사: {0}}" FontSize="11"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </ui:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <TabItem Header="커버">
                                <StackPanel Margin="16">
                                    <TextBlock x:Name="CoverSelectionInfo" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" Text="파일을 선택하면 커버를 확인하고 바꿀 수 있습니다."/>
                                    <Border Height="200" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Image x:Name="CoverPreviewImage" Stretch="Uniform"/>
                                    </Border>
                                    <Button Content="이미지 파일로 교체..." HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="ReplaceCover_Click"/>
                                    <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="ApplyCoverToSelection_Click">
                                        <TextBlock Text="선택한 전체 항목에 같은 커버 적용" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </ui:Button>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="이름 규칙">
                                <StackPanel Margin="16">
                                    <TextBlock Text="이름 규칙" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="단일 곡 패턴" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="SinglePatternBox" Margin="8,4"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="앨범 트랙 패턴" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="AlbumPatternBox" Margin="8,4"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="콜론( : ) 대체" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="ColonReplacementBox" Margin="8,4"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="기타 금지문자" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="OtherReplacementBox" Margin="8,4"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="규칙 저장" Click="SaveRenameRules_Click"/>
                                        <Button Content="기본값으로" Margin="8,0,0,0" Click="ResetRenameRules_Click"/>
                                    </StackPanel>
                                    <CheckBox x:Name="IsAlbumCheck" Content="앨범 폴더(트랙 번호 포함)로 처리" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="RenameTargetInfo" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="미리보기" Click="PreviewRename_Click"/>
                                        <ui:Button Content="적용" Appearance="Primary" Margin="8,0,0,0" Click="ApplyRename_Click"/>
                                    </StackPanel>
                                    <DataGrid x:Name="RenamePreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              BorderThickness="0" Background="Transparent" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="기존 파일명" Binding="{Binding OldName}" Width="2*"/>
                                            <DataGridTextColumn Header="새 파일명" Binding="{Binding NewName}" Width="2*"/>
                                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="가사">
                                <StackPanel Margin="16">
                                    <TextBlock x:Name="LyricsTargetInfo" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="선택 항목 검색" Click="SearchLyricsSelected_Click"/>
                                        <Button Content="전체 검색" Margin="8,0,0,0" Click="SearchLyricsAll_Click"/>
                                        <ui:Button Content="선택 항목 적용" Appearance="Primary" Margin="8,8,0,0" Click="ApplyLyricsSelected_Click"/>
                                        <ui:Button Content="찾은 전체 적용" Appearance="Primary" Margin="8,8,0,0" Click="ApplyLyricsAllFound_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="LyricsStatusText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="LyricsResultGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              BorderThickness="0" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="1.6*"/>
                                            <DataGridTextColumn Header="기존" Binding="{Binding HasLyricsLabel}" Width="60"/>
                                            <DataGridTextColumn Header="검색 결과" Binding="{Binding LyricsSearchLabel}" Width="1.2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="태그">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TagStatusText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ui:Button Grid.Column="1" Content="변경사항 저장" Appearance="Primary" Click="SaveTags_Click"/>
                                    </Grid>
                                    <DataGrid Grid.Row="1" x:Name="TagEditGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                              BorderThickness="0" Background="Transparent">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="파일" Binding="{Binding FileName}" IsReadOnly="True" Width="1.3*"/>
                                            <DataGridTextColumn Header="Title" Binding="{Binding Tags.Title}" Width="1.2*"/>
                                            <DataGridTextColumn Header="Artist" Binding="{Binding Tags.Artist}" Width="1*"/>
                                            <DataGridTextColumn Header="Album" Binding="{Binding Tags.Album}" Width="1*"/>
                                            <DataGridTextColumn Header="Genre" Binding="{Binding Tags.Genre}" Width="0.8*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </ui:Card>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
