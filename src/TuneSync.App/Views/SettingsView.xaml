                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="프리셋" FontTypography="Body"/>
                                <ui:TextBlock Text="{Binding Equalizer.PresetName, StringFormat=지금: {0}}" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox Width="200" ItemsSource="{Binding Equalizer.Presets}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding Equalizer.SelectedPreset}"/>
                    </ui:CardControl>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Options24}" Tag="이퀄라이저 열기 밴드 슬라이더 프리앰프 좌우 균형 스테레오 폭"
                                    ToolTip="재생 바의 이퀄라이저 버튼으로도 열 수 있습니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="세부 조절" FontTypography="Body"/>
                                <ui:TextBlock Text="밴드별 슬라이더, 저음·고음, 스테레오 폭, 좌우 균형" Style="{StaticResource Desc}"/>
