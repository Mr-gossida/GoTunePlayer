<Window x:Class="TuneSync.App.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TuneSync.App"
        xmlns:conv="clr-namespace:TuneSync.App.Converters"
        xmlns:views="clr-namespace:TuneSync.App.Views"
        Title="GoTune HUD"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <!-- The HUD: what is playing in a small card that stays above every other program (it never
         takes the focus from them). DataContext: the PlaybackViewModel; the card's own menu works
         on the HudViewModel (Tag). It is as solid as set (설정 or its menu) and turns solid while
         the mouse is over it, so the buttons can be read; drag it anywhere.
         Four layouts (설정 › HUD 레이아웃): each has a fixed width and fixed line heights, so the
         card keeps one size and shape for every song (synced lyrics, plain lyrics, none) and for
         every line in any font. -->
    <Window.Resources>
        <conv:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <Storyboard x:Key="LineFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
        <Style x:Key="HudChrome" TargetType="ui:Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- the cover with a note behind it for songs without one; its size is set where used -->
        <Style x:Key="Cover" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border CornerRadius="6" Background="{DynamicResource PlayerHoverBrush}">
                                <ui:SymbolIcon Symbol="MusicNote224" FontSize="{TemplateBinding FontSize}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </Border>
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CurrentCoverSmall}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding NowPlayingTitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="Subtitle" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding NowPlayingSubtitle}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- the line being sung (fades in at each new line) -->
        <Style x:Key="LyricNow" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding CurrentLyricText, NotifyOnTargetUpdated=True}"/>
            <Setter Property="FontFamily" Value="{DynamicResource LyricsFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard Storyboard="{StaticResource LineFadeIn}"/>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LyricNext" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding NextLyricText}"/>
            <Setter Property="FontFamily" Value="{DynamicResource LyricsFontFamily}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
        <!-- what stands in the lyrics' place when the song has no synced lyrics (app font) -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="HintNote" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
        <!-- shown only for synced lyrics, but its room is kept (Hidden, not Collapsed) -->
        <Style x:Key="SyncedOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSyncedLyrics}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HudProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="{Binding DurationSeconds}"/>
            <Setter Property="Value" Value="{Binding PositionSeconds, Mode=OneWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PlayerTrackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <!-- 클리어: a dark track, so the line shows over light windows too -->
                <DataTrigger Binding="{Binding Tag.Clear, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#8C000000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallIcon" TargetType="ui:Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SmallPlay" TargetType="ui:Button" BasedOn="{StaticResource PlayerPlayButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <!-- the card's menu and close sit at its top right, except in the one-line strip -->
        <Style x:Key="ChromePlace" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,8,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.Layout, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,108,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag.Layout, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vertical">
                    <Setter Property="Margin" Value="0,14,14,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- the margin leaves room for the shadow -->
    <Grid Margin="10">
        <!-- The shadow is cast by a plain card-shaped shape behind the card, not by the card itself:
             an effect on the card was redone over the whole card every time anything in it changed
             (the spectrum, ~30 times a second), and this window is see-through, so each of those
             frames is also copied back from the GPU. Same shape (and color, so no edge shows). -->
        <!-- The card's surface: its shadow, tint and the cover's colors. In 클리어 모드 it is gone
             (only faintly there while the mouse is over the HUD, to show its edges and buttons). -->
        <Grid x:Name="Surface" IsHitTestVisible="False">
            <Border CornerRadius="14" Background="{DynamicResource PlayerTintBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="Black" RenderingBias="Performance"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource PlayerTrackBrush}" Background="{DynamicResource PlayerTintBrush}"/>
            <!-- the cover's colors behind, like the player -->
            <Border CornerRadius="13" Margin="1" ClipToBounds="True" Opacity="0.4">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding BackdropCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"/>
                </Border.Background>
            </Border>
            <Border CornerRadius="13" Margin="1" Background="{DynamicResource PlayerTintBrush}" Opacity="0.6"/>
        </Grid>
        <!-- The card's contents. Its background is all but invisible (alpha 1/255) on purpose: a
             see-through window only gets the mouse where it draws something, and in 클리어 모드
             the HUD must still be grabbed between its words. -->
        <Border x:Name="Card" CornerRadius="14" BorderThickness="1" BorderBrush="Transparent" Background="#01000000">
            <Grid>
                <!-- 클리어: soft dark shades behind each group of words, the spectrum and the seek
                     bar (HudWindow.Clear.cs places them); never in the way of the mouse -->
                <Canvas x:Name="Scrims" IsHitTestVisible="False"/>

                <!-- ===== 카드: the song, two lyric lines, spectrum and buttons, the times ===== -->
                <Grid x:Name="CardLayout" Width="392" Margin="14,12,12,10"
                      Visibility="{Binding Tag.Layout, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Card}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource Cover}" Width="46" Height="46" Margin="0,0,12,0"/>
                        <!-- the right margin keeps the title clear of the menu and close buttons -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,56,0">
                            <TextBlock Style="{StaticResource Title}" FontSize="14" LineHeight="19"/>
                            <TextBlock Style="{StaticResource Subtitle}" FontSize="12" LineHeight="16" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <StackPanel Style="{StaticResource SyncedOnly}">
                            <TextBlock Style="{StaticResource LyricNow}" FontSize="16" LineHeight="22"/>
                            <TextBlock Style="{StaticResource LyricNext}" FontSize="12" LineHeight="17" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasNoLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <TextBlock Style="{StaticResource Hint}" Text="♪  가사가 없는 곡" FontSize="14" LineHeight="22"/>
                            <TextBlock Style="{StaticResource HintNote}" Text="태그 관리에서 가사를 추가할 수 있습니다" FontSize="12" LineHeight="17" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasPlainLyricsOnly, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <TextBlock Style="{StaticResource Hint}" Text="♪  시간이 맞춰지지 않은 가사" FontSize="14" LineHeight="22"/>
                            <TextBlock Style="{StaticResource HintNote}" Text="싱크 가사 만들기로 한 줄씩 따라가게 할 수 있습니다" FontSize="12" LineHeight="17" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 클리어: the same bars in dark, a pixel and a half down and right, as a hard
                             shadow (a blur on something redrawn ~30 times a second would cost the GPU
                             on every frame; this costs one more spectrum, and none when not shown) -->
                        <views:SpectrumView Playback="{Binding}" Look="{Binding SpectrumLook}" BarBrush="#D0000000"
                                            Height="22" VerticalAlignment="Center" Margin="1.5,1.5,10.5,-1.5" IsHitTestVisible="False"
                                            Visibility="{Binding Tag.Clear, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                        <views:SpectrumView Playback="{Binding}" Look="{Binding SpectrumLook}" BarBrush="{DynamicResource PlayerAccentBrush}"
                                            Height="22" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="15"
                                       Icon="{ui:SymbolIcon Previous24, Filled=True}" Command="{Binding PlayPreviousCommand}" ToolTip="이전 곡"/>
                            <ui:Button Style="{StaticResource PlayerPlayButtonStyle}" Width="36" Height="36" CornerRadius="18" Margin="4,0" FontSize="16"
                                       Icon="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                                       Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지"/>
                            <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="15"
                                       Icon="{ui:SymbolIcon Next24, Filled=True}" Command="{Binding PlayNextCommand}" ToolTip="다음 곡"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource HudProgress}"/>
                        <!-- (lone words sit in a Border: 클리어 gives such groups a second halo) -->
                        <Border Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Typography.NumeralAlignment="Tabular">
                                <Run Text="{Binding PositionText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== 한 줄: one thin strip; the line being sung takes the artist's place ===== -->
                <Grid x:Name="CompactLayout" Width="418" Height="54"
                      Visibility="{Binding Tag.Layout, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Compact}">
                    <Grid Margin="9,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource Cover}" Width="36" Height="36" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Title}" FontSize="13" LineHeight="18"/>
                            <Grid Margin="0,1,0,0">
                                <TextBlock Style="{StaticResource LyricNow}" FontSize="12" LineHeight="17"
                                           Visibility="{Binding HasSyncedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                <TextBlock Style="{StaticResource Subtitle}" FontSize="12" LineHeight="17"
                                           Visibility="{Binding HasSyncedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Style="{StaticResource SmallIcon}" Icon="{ui:SymbolIcon Previous24, Filled=True}" Command="{Binding PlayPreviousCommand}" ToolTip="이전 곡"/>
                            <ui:Button Style="{StaticResource SmallPlay}" Icon="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                                       Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지"/>
                            <ui:Button Style="{StaticResource SmallIcon}" Icon="{ui:SymbolIcon Next24, Filled=True}" Command="{Binding PlayNextCommand}" ToolTip="다음 곡"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Style="{StaticResource HudProgress}" Height="2" VerticalAlignment="Bottom" Margin="14,0,14,3"/>
                </Grid>

                <!-- ===== 가사 집중: the two lines large and centered, the song small underneath;
                     the buttons come up while the mouse is over it ===== -->
                <Grid x:Name="LyricsLayout" Width="518" Margin="0,14,0,10"
                      Visibility="{Binding Tag.Layout, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Lyrics}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- the side margins keep the centered lines clear of the menu and close buttons -->
                    <Grid Margin="62,0">
                        <StackPanel Style="{StaticResource SyncedOnly}">
                            <TextBlock Style="{StaticResource LyricNow}" FontSize="20" LineHeight="28" TextAlignment="Center"/>
                            <TextBlock Style="{StaticResource LyricNext}" FontSize="14" LineHeight="20" Margin="0,2,0,0" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasNoLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <TextBlock Style="{StaticResource Hint}" Text="♪  가사가 없는 곡" FontSize="17" LineHeight="28" TextAlignment="Center"/>
                            <TextBlock Style="{StaticResource HintNote}" Text="태그 관리에서 가사를 추가할 수 있습니다" FontSize="13" LineHeight="20" Margin="0,2,0,0" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasPlainLyricsOnly, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <TextBlock Style="{StaticResource Hint}" Text="♪  시간이 맞춰지지 않은 가사" FontSize="17" LineHeight="28" TextAlignment="Center"/>
                            <TextBlock Style="{StaticResource HintNote}" Text="싱크 가사 만들기로 한 줄씩 따라가게 할 수 있습니다" FontSize="13" LineHeight="20" Margin="0,2,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="18,12,18,0" Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border VerticalAlignment="Center">
                            <TextBlock FontSize="11" LineHeight="15" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding NowPlayingTitle, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding NowPlayingSubtitle, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                        <ProgressBar Grid.Column="1" Style="{StaticResource HudProgress}" Height="2" Margin="12,0"/>
                        <Border Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PositionText}" FontSize="11" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Border>
                        <!-- over the progress line while the mouse is on the card -->
                        <Border x:Name="LyricsButtons" Grid.ColumnSpan="3" HorizontalAlignment="Center" CornerRadius="16" Padding="4,0" Opacity="0"
                                Background="{DynamicResource PlayerTintBrush}" BorderThickness="1" BorderBrush="{DynamicResource PlayerTrackBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource SmallIcon}" Icon="{ui:SymbolIcon Previous24, Filled=True}" Command="{Binding PlayPreviousCommand}" ToolTip="이전 곡"/>
                                <ui:Button Style="{StaticResource SmallIcon}" Icon="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                                           Foreground="{DynamicResource PlayerAccentBrush}" Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지"/>
                                <ui:Button Style="{StaticResource SmallIcon}" Icon="{ui:SymbolIcon Next24, Filled=True}" Command="{Binding PlayNextCommand}" ToolTip="다음 곡"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== 세로 미니멀: an upright card around a large cover; one lyric line ===== -->
                <StackPanel x:Name="VerticalLayout" Width="198" Margin="0,9,0,10"
                            Visibility="{Binding Tag.Layout, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Vertical}">
                    <ContentControl Style="{StaticResource Cover}" Width="178" Height="178" FontSize="40"/>
                    <StackPanel Margin="12,10,12,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}" FontSize="13" LineHeight="18"/>
                            <TextBlock Style="{StaticResource Subtitle}" FontSize="11" LineHeight="15" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource LyricNow}" FontSize="12" LineHeight="17"
                                       Visibility="{Binding HasSyncedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            <TextBlock Style="{StaticResource HintNote}" Text="♪  가사 없음" FontSize="12" LineHeight="17"
                                       Visibility="{Binding HasNoLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            <TextBlock Style="{StaticResource HintNote}" Text="♪  싱크 가사 없음" FontSize="12" LineHeight="17"
                                       Visibility="{Binding HasPlainLyricsOnly, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource HudProgress}" Height="2" Margin="0,9,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <ui:Button Style="{StaticResource SmallIcon}" Icon="{ui:SymbolIcon Previous24, Filled=True}" Command="{Binding PlayPreviousCommand}" ToolTip="이전 곡"/>
                            <ui:Button Style="{StaticResource SmallPlay}" Margin="8,0" Icon="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                                       Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지"/>
                            <ui:Button Style="{StaticResource SmallIcon}" Icon="{ui:SymbolIcon Next24, Filled=True}" Command="{Binding PlayNextCommand}" ToolTip="다음 곡"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- what a hotkey just switched ("클리어 모드 켬"), for a moment in the middle -->
                <Border x:Name="FlashBadge" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                        CornerRadius="14" Padding="14,6" Background="{DynamicResource PlayerTintBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource PlayerAccentBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black" RenderingBias="Performance"/>
                    </Border.Effect>
                    <TextBlock x:Name="FlashText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Border>

                <!-- the card's menu and close: shown while the mouse is over it -->
                <Border x:Name="Chrome" Style="{StaticResource ChromePlace}" Opacity="0" CornerRadius="14" Padding="1"
                        Background="{DynamicResource PlayerTintBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="MenuButton" Style="{StaticResource HudChrome}" Icon="{ui:SymbolIcon Options24}" ToolTip="레이아웃 · 투명도 · 마우스 통과"
                                   Click="Menu_Click" AutomationProperties.Name="HUD 메뉴"/>
                        <ui:Button Style="{StaticResource HudChrome}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="HUD 끄기"
                                   Command="{Binding Tag.CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="HUD 끄기"/>
                    </StackPanel>
                </Border>

                <!-- the menu: layout, how solid, click-through, and off -->
                <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" HorizontalOffset="-262" VerticalOffset="4"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Margin="8" Width="300" CornerRadius="10" Padding="14,12" Background="{DynamicResource PlayerTintBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource PlayerTrackBrush}"
                            DataContext="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="레이아웃" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <views:HudLayoutPicker Layout="{Binding Layout, Mode=TwoWay}" Margin="0,8,0,14"/>
                            <Grid>
                                <TextBlock Text="클리어 모드" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:ToggleSwitch IsChecked="{Binding Clear}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 AutomationProperties.Name="HUD 클리어 모드"/>
                            </Grid>
                            <TextBlock Text="배경 없이 글자와 버튼만 테두리를 둘러 띄웁니다" FontSize="11" Margin="0,4,0,12" TextWrapping="Wrap"
                                       local:KeepWords.IsEnabled="True" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <!-- the opacity is the card's; with no card (클리어) it is set aside -->
                            <StackPanel IsEnabled="{Binding Clear, Converter={StaticResource InverseBooleanConverter}}">
                                <Grid>
                                    <TextBlock Text="투명도" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding OpacityText}" FontSize="12" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Slider Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Opacity}" Margin="0,8,0,4"
                                        IsMoveToPointEnabled="True" AutomationProperties.Name="HUD 투명도"/>
                                <TextBlock Text="마우스를 올리면 잠시 선명해집니다" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="마우스 통과" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:ToggleSwitch IsChecked="{Binding ClickThrough}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 AutomationProperties.Name="HUD 마우스 통과"/>
                            </Grid>
                            <TextBlock Text="클릭이 뒤의 창으로 갑니다. 트레이 메뉴나 설정에서 끕니다" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       local:KeepWords.IsEnabled="True" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <!-- set before turning it on: this menu can't be reached while clicks pass through -->
                            <CheckBox IsChecked="{Binding ClickThroughButtons}" Margin="0,6,0,0" FontSize="12"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.Name="HUD 버튼은 누를 수 있게">
                                <TextBlock Text="켜도 재생 버튼은 누를 수 있게" TextWrapping="Wrap" local:KeepWords.IsEnabled="True"/>
                            </CheckBox>
                            <ui:Button Content="HUD 끄기" Icon="{ui:SymbolIcon Dismiss24}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                       Command="{Binding CloseCommand}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
