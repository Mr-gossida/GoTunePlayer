<Page x:Class="TuneSync.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="설정">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Top">
            <ui:TextBlock Text="설정" FontTypography="TitleLarge"/>
            <ui:TextBlock Text="리네임/병합 규칙, 자동 채움 기본 동작(완전 자동/검토 후 적용) 등을 설정합니다. (구현 예정)"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
