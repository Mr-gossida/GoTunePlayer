<ui:FluentWindow x:Class="TuneSync.App.LyricsSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:TuneSync.App.Converters"
        xmlns:local="clr-namespace:TuneSync.App"
        Title="{Binding WindowTitle}" Width="760" Height="820" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" WindowCornerPreference="Round" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>

        <!-- One lyric line: [time] [mark] text. Two states that must never be confused:
             the line being sung (playing) - a tint of the player's accent, an accent bar on the
             left, accent bold text and a speaker mark; and the selected line (where Space stamps
             and the arrows edit) - a strong outline. A line can be both. -->
        <Style x:Key="LineItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1,10,1">
                            <Border x:Name="Hover" CornerRadius="6" Background="Transparent"/>
                            <Border x:Name="Tint" CornerRadius="6" Background="{DynamicResource PlayerAccentBrush}" Opacity="0"/>
                            <Border x:Name="Bar" Width="4" CornerRadius="2" Margin="0,4" HorizontalAlignment="Left"
                                    Background="{DynamicResource PlayerAccentBrush}" Visibility="Collapsed"/>
                            <Border x:Name="Outline" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent"/>
                            <ContentPresenter Margin="6,3,4,3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.16"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{Binding WindowTitle}" ShowMinimize="False" ShowMaximize="False"/>

        <!-- Song -->
        <Grid Grid.Row="1" Margin="24,8,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- What the line marks mean, one per row so it stays narrow -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextElement.FontSize="12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource PlayerAccentBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="재생 중인 줄" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Border Width="14" Height="14" CornerRadius="3" BorderThickness="2" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="선택한 줄 (시간을 찍을 줄)" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            ToolTip="음성 인식이 또렷이 듣지 못해 앞뒤 줄로 추정한 시간입니다. 들어보고 맞으면 그대로 두고, 틀리면 시간을 다시 찍으세요.">
                    <Grid Width="14" Margin="0,0,6,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SystemFillColorCautionBrush}"/>
                    </Grid>
                    <TextBlock Text="추정한 시간 (확인 필요)" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <Grid Width="56" Height="56" Margin="0,0,14,0">
                <Border CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Border>
                <Border CornerRadius="6">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding File.CoverThumbnail}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding File.DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding File.Artist}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Automatic sync. Idle text and progress share one cell, the hidden one kept in the
             layout (Visibility Hidden), so the card keeps its height when a sync starts and the
             lines below don't move. -->
        <Border Grid.Row="2" Margin="24,0,24,12" Padding="16,12" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- title, then (while syncing) the steps: done ones get a check, the current one the accent -->
                <StackPanel Orientation="Horizontal" MinHeight="22">
                    <TextBlock Text="자동으로 맞추기" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="14,0,0,0" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChevronRight12" FontSize="12" Margin="6,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding HasPrevious, Converter={StaticResource BoolToVisibility}}"/>
                                    <Border x:Name="Chip" CornerRadius="11" Padding="4,2,10,2" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="18" Height="18" Margin="0,0,6,0">
                                                <Ellipse x:Name="Dot" Fill="{DynamicResource ControlFillColorSecondaryBrush}"
                                                         Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"/>
                                                <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <ui:SymbolIcon x:Name="Check" Symbol="Checkmark12" FontSize="11" Visibility="Collapsed"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Grid>
                                            <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter TargetName="Dot" Property="Stroke" Value="{x:Null}"/>
                                        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        <Setter TargetName="Dot" Property="Stroke" Value="{x:Null}"/>
                                        <Setter TargetName="Number" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- what it runs on: a filled badge like the song's Lossless / Hi-Res mark -->
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Padding="7,2"
                        Background="{DynamicResource PlayerAccentBrush}" ToolTip="자동으로 맞추기가 지금 이 장치로 처리하고 있습니다. 설정 › 도구 › 가사 싱크에서 바꿀 수 있습니다.">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProcessingDevice}" Value="">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PlayerOnAccentBrush}">
                        <Run Text="Processing on"/> <Run Text="{Binding ProcessingDevice, Mode=OneWay}"/>
                    </TextBlock>
                </Border>

                <Grid Grid.Row="1" Margin="0,6,16,0">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="음성 인식이 이 PC에서 노래를 듣고 각 줄의 시간을 찾습니다. 노래와 가사는 외부로 보내지 않습니다. 결과는 아래에서 들어보며 고칠 수 있습니다.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- the current step: what it's doing, its own percentage and bar -->
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StepPercent}" FontSize="12" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <ProgressBar Value="{Binding Progress}" Maximum="1" Height="4" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,6,0,0">
                    <ui:Button Content="자동으로 맞추기" Icon="{ui:SymbolIcon Sparkle24}" Appearance="Primary" Command="{Binding AutoSyncCommand}"
                               HorizontalAlignment="Right"
                               Visibility="{Binding IsBusy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}"/>
                    <ui:Button Content="취소" Command="{Binding CancelWorkCommand}" HorizontalAlignment="Right"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Lines -->
        <ListBox x:Name="LinesList" Grid.Row="3" Margin="20,0,14,0" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                 ItemContainerStyle="{StaticResource LineItemStyle}" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="98"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- the time: click to play from just before it -->
                        <ui:Button x:Name="TimeButton" Content="{Binding TimeText}" FontFamily="Consolas" FontSize="13" Padding="8,3"
                                   Appearance="Transparent" HorizontalAlignment="Left" Click="TimeButton_Click"
                                   ToolTip="여기부터 듣기 (Enter)"/>
                        <Ellipse x:Name="CheckDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Center" Visibility="Collapsed"
                                 Fill="{DynamicResource SystemFillColorCautionBrush}"
                                 ToolTip="자동으로 추정한 시간입니다. 들어보고 맞는지 확인하세요."/>
                        <ui:SymbolIcon x:Name="PlayingMark" Grid.Column="1" Symbol="Speaker224" Filled="True" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{DynamicResource PlayerAccentBrush}" ToolTip="지금 재생 중인 줄"/>
                        <TextBlock x:Name="LineText" Grid.Column="2" Text="{Binding Text}" FontSize="14" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="4,0,0,0"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasTime}" Value="False">
                            <Setter TargetName="TimeButton" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NeedsCheck}" Value="True">
                            <Setter TargetName="CheckDot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="TimeButton" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="LineText" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                            <Setter TargetName="CheckDot" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PlayingMark" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- an instrumental break from the existing lyrics -->
                        <DataTrigger Binding="{Binding IsGap}" Value="True">
                            <Setter TargetName="LineText" Property="Text" Value="♪ 간주 (가사 없음 · 선택)"/>
                            <Setter TargetName="LineText" Property="FontSize" Value="12"/>
                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <Setter TargetName="LineText" Property="ToolTip" Value="앞 줄이 사라지는 시점입니다. 시간을 지우면 저장할 때 빠집니다."/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Listen and tap -->
        <Border Grid.Row="4" Margin="24,10,24,0" Padding="12,10" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Width="32" Height="32" CornerRadius="16" Padding="0" Margin="0,0,4,0" Appearance="Transparent"
                               Icon="{ui:SymbolIcon Rewind24}" Command="{Binding SeekBackCommand}" ToolTip="5초 뒤로 (Ctrl+←)"/>
                    <ui:Button Width="40" Height="40" CornerRadius="20" Padding="0" Appearance="Primary" Command="{Binding TogglePlayCommand}"
                               Icon="{Binding Playback.IsPlaying, Converter={StaticResource PlayPauseIconConverter}}" ToolTip="재생 / 일시정지"/>
                    <ui:Button Width="32" Height="32" CornerRadius="16" Padding="0" Margin="4,0,0,0" Appearance="Transparent"
                               Icon="{ui:SymbolIcon FastForward24}" Command="{Binding SeekForwardCommand}" ToolTip="5초 앞으로 (Ctrl+→)"/>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="PositionText" FontFamily="Consolas" FontSize="15" Text="00:00.00"/>
                        <TextBlock Text="{Binding Playback.DurationText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="−0.1초" Command="{Binding NudgeBackCommand}" Margin="0,0,4,0" ToolTip="선택한 줄을 앞당기기 (←, Shift+← 0.5초)"/>
                    <ui:Button Content="+0.1초" Command="{Binding NudgeForwardCommand}" Margin="0,0,10,0" ToolTip="선택한 줄을 늦추기 (→, Shift+→ 0.5초)"/>
                    <ui:Button Content="지금 시간 찍기" Icon="{ui:SymbolIcon Flag24}" Appearance="Primary" Command="{Binding StampCommand}"
                               ToolTip="선택한 줄을 지금 재생 위치로 정하고 다음 줄로 (Space)"/>
                </StackPanel>
                <!-- Where the song is (the player's seek bar, as a plain line: no effect while syncing): click or drag to
                     listen from anywhere. Driven from code each tick (LyricsSyncWindow): it shows
                     this song only, not whatever else the player has loaded. -->
                <local:WaveSeekBar x:Name="SeekBar" Grid.Row="1" Grid.ColumnSpan="3" Height="30" Margin="0,8,0,0"
                                   Maximum="1" Value="0" Look="None"
                                   WaveBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                   TrackBrush="{DynamicResource ControlStrongFillColorDisabledBrush}"
                                   SeekStarted="SeekBar_SeekStarted" SeekCompleted="SeekBar_SeekCompleted"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="24,12,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Space 시간 찍기 · Enter 이 줄부터 듣기 · ↑↓ 줄 이동 · ←→ 0.1초 조정 · Ctrl+←→ 5초 이동 · Delete 시간 지우기 · Ctrl+S 저장"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <ui:Button Content="취소" Click="Cancel_Click" Margin="0,0,8,0"/>
                <ui:Button Content="저장" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
