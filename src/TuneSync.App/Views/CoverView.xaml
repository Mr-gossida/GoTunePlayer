<Page x:Class="TuneSync.App.Views.CoverView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="앨범 커버">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="앨범 커버" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" Opacity="0.6" TextWrapping="Wrap"
                       Text="폴더 안 트랙의 앨범 커버를 확인하고, 선택한 트랙에 새 이미지를 한 번에 적용합니다."/>
        </StackPanel>

        <ui:Card Grid.Row="1" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="폴더 선택" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="폴더" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="FolderBox" IsReadOnly="True" Margin="12,0"/>
                    <Button Grid.Column="2" Content="찾아보기..." Click="Browse_Click"/>
                    <Button Grid.Column="3" Content="새로고침" Margin="8,0,0,0" Click="Refresh_Click"/>
                </Grid>
            </StackPanel>
        </ui:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="트랙 목록" FontWeight="SemiBold" FontSize="14" Margin="16,16,16,8"/>
                    <DataGrid Grid.Row="1" x:Name="TrackGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                              SelectionChanged="TrackGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="2*"/>
                            <DataGridTextColumn Header="앨범" Binding="{Binding Album}" Width="1.5*"/>
                            <DataGridTextColumn Header="커버" Binding="{Binding HasCoverLabel}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="2">
                <StackPanel>
                    <TextBlock Text="선택한 커버" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                    <Border Height="220" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Image x:Name="CoverImage" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="SelectionInfo" Margin="0,12,0,12" TextWrapping="Wrap" Opacity="0.7"/>
                    <Button Content="이미지 파일로 교체..." HorizontalAlignment="Stretch" Click="ReplaceFromFile_Click"/>
                    <ui:Button HorizontalAlignment="Stretch" Appearance="Primary" Margin="0,8,0,0" Click="ApplyToAll_Click">
                        <TextBlock Text="선택한 전체 항목에 같은 커버 적용" TextWrapping="Wrap" TextAlignment="Center"/>
                    </ui:Button>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
