<Window x:Class="TuneSync.App.ScreenSaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:TuneSync.App.Effects"
        Title="TuneSync 화면 보호기"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="Black" Cursor="None" WindowStartupLocation="Manual">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid x:Name="Root" Opacity="0">
        <!-- Same cover-colored backdrop as the player, a little darker. -->
        <Rectangle Fill="{DynamicResource PlayerTintBrush}"/>
        <Image Source="{Binding BackdropCover}" Stretch="UniformToFill" Opacity="0.6" RenderOptions.BitmapScalingMode="Linear"/>
        <Rectangle Fill="{DynamicResource PlayerScrimBrush}"/>
        <Rectangle Fill="#73000000"/>

        <!-- Aurora-lamp light flowing over the backdrop in the cover's colors (Effects/Aurora.hlsl,
             on the GPU). The near-transparent fill only gives the effect an area to draw on. -->
        <Rectangle x:Name="AuroraLayer" Fill="#01000000" IsHitTestVisible="False" SizeChanged="AuroraLayer_SizeChanged">
            <Rectangle.Effect>
                <effects:AuroraEffect x:Name="AuroraLight" Intensity="0.8"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- Everything drifts a little now and then, so nothing sits still long enough to burn in. -->
        <Grid x:Name="Stage">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Drift"/>
            </Grid.RenderTransform>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,72,0">
                <TextBlock x:Name="ClockText" FontSize="72" FontWeight="Light" Foreground="White" HorizontalAlignment="Right"/>
                <TextBlock x:Name="DateText" FontSize="18" Foreground="#B3FFFFFF" HorizontalAlignment="Right" Margin="0,0,4,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
                <Border Width="340" Height="340" CornerRadius="14" HorizontalAlignment="Center" Background="#22FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="12" Direction="270" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                </Border>
                <TextBlock Text="{Binding NowPlayingTitle}" FontSize="38" FontWeight="Bold" Foreground="White" Margin="0,36,0,0"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NowPlayingSubtitle}" FontSize="20" Foreground="#CCFFFFFF" Margin="0,8,0,0"
                           TextAlignment="Center" TextWrapping="Wrap"/>

                <!-- Three lines - the one just sung, the current one, the next - gliding up like the
                     player's lyrics (LyricsScroller). Lines are laid out at the current-line size and
                     drawn smaller when not current, so a line growing never re-wraps. -->
                <ScrollViewer x:Name="LyricsViewer" Height="160" Margin="0,34,0,0" Focusable="False" IsHitTestVisible="False"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              SizeChanged="LyricsViewer_SizeChanged"
                              Visibility="{Binding HasSyncedLyrics, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.12"/>
                            <GradientStop Color="Black" Offset="0.88"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <ItemsControl x:Name="LyricsItems" ItemsSource="{Binding LyricsLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Line" Margin="0,5" RenderTransformOrigin="0.5,0.5" Opacity="0.45">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="0.62" ScaleY="0.62"/>
                                    </Grid.RenderTransform>
                                    <TextBlock Text="{Binding Text}" FontSize="30" FontWeight="SemiBold" Foreground="White"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                    <!-- the current line takes the cover's accent color (cross-faded in) -->
                                    <TextBlock x:Name="Accent" Text="{Binding Text}" FontSize="30" FontWeight="SemiBold" Opacity="0"
                                               Foreground="{DynamicResource PlayerAccentBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45"/>
                                                    <DoubleAnimation Storyboard.TargetName="Accent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45"/>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.5"/>
                                                    <DoubleAnimation Storyboard.TargetName="Accent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.62" Duration="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.62" Duration="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Hint" Text="마우스를 움직이거나 아무 키나 누르면 돌아갑니다" FontSize="13" Foreground="#99FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"/>
    </Grid>
</Window>
