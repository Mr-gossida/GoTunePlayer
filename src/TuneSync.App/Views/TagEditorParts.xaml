<ResourceDictionary x:Class="TuneSync.App.Views.TagEditorParts"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
                    xmlns:conv="clr-namespace:TuneSync.App.Converters">
    <!-- The tag editor's parts, shared by 태그 관리 (LibraryView) and the one-song editor
         (SongEditorView): field rows, the search status line, tabs, cover candidate tiles. -->
    <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>

    <!-- A tab's online search: progress, then what was found (or not), with a cancel link. -->
    <DataTemplate x:Key="SearchStatusTemplate">
        <Grid x:Name="Line">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:ProgressRing x:Name="Ring" IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                             Visibility="Collapsed"/>
            <TextBlock Grid.Column="1" Text="{Binding SearchStatus}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:Button x:Name="Cancel" Grid.Column="2" Content="취소" Appearance="Transparent" Padding="8,2" FontSize="12"
                       Margin="6,0,0,0" Command="{Binding CancelSearchCommand}" Visibility="Collapsed"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Cancel" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SearchStatus}" Value="">
                <Setter TargetName="Line" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Small caption above a group of fields -->
    <Style x:Key="EditorSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,16,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>

    <!-- Centered hint when a tab has nothing to show -->
    <Style x:Key="EditorEmpty" TargetType="StackPanel">
        <Setter Property="Margin" Value="16,48,16,0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="MaxWidth" Value="280"/>
    </Style>

    <!-- Underlined text tab; Tag=True puts a dot after it (unsaved change inside) -->
    <Style x:Key="PanelTab" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent" Margin="0,0,20,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="1,2,1,0">
                                <ContentPresenter x:Name="Label" TextElement.FontSize="13"
                                                  TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Ellipse x:Name="Dot" Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                         Fill="{DynamicResource TagChangeBrush}"/>
                            </StackPanel>
                            <Border x:Name="Underline" Height="3" CornerRadius="1.5" Margin="0,8,0,-1" Background="Transparent"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One tag field: label (+ value spread / revert), the box, then "이전" or an error.
         An edited field gets an accent bar on the left and a tinted background. -->
    <DataTemplate x:Key="TagFieldTemplate" DataType="{x:Type vm:TagFieldViewModel}">
        <Border x:Name="Row" Padding="10,6,6,7" Margin="0,0,0,2" BorderThickness="3,0,0,0"
                BorderBrush="Transparent" Background="Transparent" PreviewKeyDown="Field_PreviewKeyDown">
            <StackPanel>
                <Grid MinHeight="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 일괄 편집: whether this field changes every selected song -->
                    <CheckBox x:Name="ApplyCheck" MinWidth="0" Margin="0,0,2,0" Padding="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                              IsChecked="{Binding IsApplied}" ToolTip="체크하면 이 칸의 값을 선택한 모든 곡에 넣고, 끄면 곡마다 원래 값을 둡니다"/>
                    <TextBlock x:Name="FieldLabel" Grid.Column="1" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="BatchStatusText" Grid.Column="2" Text="{Binding BatchStatus}" FontSize="11" Margin="8,0,4,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <ui:Button x:Name="RevertButton" Grid.Column="3" Icon="{ui:SymbolIcon ArrowUndo16}" Appearance="Transparent"
                               Padding="4,2" MinWidth="0" BorderThickness="0" Command="{Binding RevertCommand}"
                               ToolTip="이 칸 되돌리기 (Esc)" Visibility="Collapsed"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <ui:TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Placeholder}"
                                ClearButtonEnabled="False" Loaded="FieldBox_Loaded"/>
                    <ui:AutoSuggestBox x:Name="SuggestBox" Visibility="Collapsed" Loaded="FieldBox_Loaded"
                                       Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       OriginalItemsSource="{Binding Suggestions}" PlaceholderText="{Binding Placeholder}"
                                       ClearButtonEnabled="False" MaxSuggestionListHeight="240" Icon="{x:Null}"/>
                </Grid>
                <TextBlock x:Name="Previous" Margin="2,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                           ToolTip="{Binding PreviousText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="이전"/><Run Text=" "/><Run Text="{Binding PreviousText, Mode=OneWay}" TextDecorations="Strikethrough"/>
                </TextBlock>
                <TextBlock x:Name="ErrorText" Margin="2,4,0,0" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                <!-- 일괄 편집, songs differing and left alone: what they have now -->
                <TextBlock x:Name="SpreadText" Margin="2,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                           Text="{Binding Distribution}" ToolTip="{Binding Distribution}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding UsesSuggestions}" Value="True">
                <Setter TargetName="Box" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="SuggestBox" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBatch}" Value="True">
                <Setter TargetName="ApplyCheck" Property="Visibility" Value="Visible"/>
                <Setter TargetName="BatchStatusText" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsBatch}" Value="True"/>
                    <Condition Binding="{Binding IsMixed}" Value="True"/>
                    <Condition Binding="{Binding IsChanged}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="SpreadText" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource TagChangeBrush}"/>
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource TagChangeBackgroundBrush}"/>
                <Setter TargetName="FieldLabel" Property="Foreground" Value="{DynamicResource TagChangeBrush}"/>
                <Setter TargetName="BatchStatusText" Property="Foreground" Value="{DynamicResource TagChangeBrush}"/>
                <Setter TargetName="RevertButton" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Previous" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                <Setter TargetName="ErrorText" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Previous" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 커버 찾기 result tile: thumbnail (fetched when on screen, CoverThumbnails), size, the
         recommendation badge; a click puts that cover in. -->
    <DataTemplate x:Key="CoverCandidateTemplate">
        <Button Command="{Binding DataContext.PickCoverCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        ToolTip="{Binding ToolTip}" Cursor="Hand" Margin="0" Padding="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Loaded="CoverCandidate_Loaded" IsVisibleChanged="CoverCandidate_IsVisibleChanged">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Frame" CornerRadius="8" Padding="4" Margin="0,0,0,4" BorderThickness="2"
                                    BorderBrush="Transparent" Background="Transparent">
                                <StackPanel>
                                    <Grid>
                                        <Border CornerRadius="5" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                                            <ui:SymbolIcon x:Name="Placeholder" Symbol="Image24" FontSize="22" Visibility="Collapsed"
                                                           Foreground="{DynamicResource TextFillColorDisabledBrush}"/>
                                        </Border>
                                        <Border CornerRadius="5">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="SizeBadge" CornerRadius="3" Padding="4,0,4,1" Margin="4" Background="#A0000000"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="White"/>
                                        </Border>
                                        <Border x:Name="RecBadge" CornerRadius="3" Padding="3,1,4,1" Margin="4" Visibility="Collapsed"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Star16" Filled="True" FontSize="10" Margin="0,0,2,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                <TextBlock Text="추천" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="Busy" CornerRadius="5" Background="#80000000" Visibility="Collapsed">
                                            <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22"/>
                                        </Border>
                                        <Border x:Name="Check" Width="20" Height="20" CornerRadius="10" Margin="4" Visibility="Collapsed"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <ui:SymbolIcon Symbol="Checkmark16" FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding AlbumText}" FontSize="12" Margin="1,5,1,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DetailText}" FontSize="11" Margin="1,1,1,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                    <Setter TargetName="RecBadge" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoadingFull}" Value="True">
                                    <Setter TargetName="Busy" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SizeText}" Value="">
                                    <Setter TargetName="SizeBadge" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
    </DataTemplate>
</ResourceDictionary>
