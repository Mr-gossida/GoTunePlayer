<Window x:Class="TuneSync.App.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TuneSync.App"
        xmlns:conv="clr-namespace:TuneSync.App.Converters"
        xmlns:views="clr-namespace:TuneSync.App.Views"
        Title="GoTune HUD"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <!-- The HUD: what is playing in a small card that stays above every other program (it never
         takes the focus from them). DataContext: the PlaybackViewModel; the card's own menu works
         on the HudViewModel (Hud). It is as solid as set (설정 › 재생 or its menu) and turns solid
         while the mouse is over it, so the buttons can be read; drag it anywhere. -->
    <Window.Resources>
        <conv:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <Storyboard x:Key="LineFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
        <Style x:Key="HudChrome" TargetType="ui:Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <!-- the margin leaves room for the shadow -->
    <Border x:Name="Card" Margin="10" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource PlayerTrackBrush}"
            Background="{DynamicResource PlayerTintBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="Black" RenderingBias="Performance"/>
        </Border.Effect>
        <Grid>
            <!-- the cover's colors behind, like the player -->
            <Border CornerRadius="13" ClipToBounds="True" IsHitTestVisible="False" Opacity="0.4">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding BackdropCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"/>
                </Border.Background>
            </Border>
            <Border CornerRadius="13" Background="{DynamicResource PlayerTintBrush}" Opacity="0.6" IsHitTestVisible="False"/>

            <Grid Margin="14,12,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- the song -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="46" Height="46" Margin="0,0,12,0">
                        <Border CornerRadius="6" Background="{DynamicResource PlayerHoverBrush}">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Border>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CurrentCoverSmall}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding NowPlayingSubtitle, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- the card's menu and close: shown while the mouse is over it -->
                    <StackPanel x:Name="Chrome" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Opacity="0" Margin="6,-4,-4,0">
                        <ui:Button x:Name="MenuButton" Style="{StaticResource HudChrome}" Icon="{ui:SymbolIcon Options24}" ToolTip="투명도"
                                   Click="Menu_Click" AutomationProperties.Name="HUD 투명도"/>
                        <ui:Button Style="{StaticResource HudChrome}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="HUD 끄기"
                                   Command="{Binding Tag.CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="HUD 끄기"/>
                    </StackPanel>
                </Grid>

                <!-- the lyrics: the line being sung and the next one -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0"
                            Visibility="{Binding HasSyncedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <TextBlock Text="{Binding CurrentLyricText, NotifyOnTargetUpdated=True}" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PlayerAccentBrush}">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard Storyboard="{StaticResource LineFadeIn}"/>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="{Binding NextLyricText}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding HasSyncedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                </StackPanel>

                <!-- spectrum and the buttons -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <views:SpectrumView Playback="{Binding}" Look="{Binding SpectrumLook}" BarBrush="{DynamicResource PlayerAccentBrush}"
                                        Height="22" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="15"
                                   Icon="{ui:SymbolIcon Previous24, Filled=True}" Command="{Binding PlayPreviousCommand}" ToolTip="이전 곡"/>
                        <ui:Button Style="{StaticResource PlayerPlayButtonStyle}" Width="36" Height="36" CornerRadius="18" Margin="4,0" FontSize="16"
                                   Icon="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                                   Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지"/>
                        <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="15"
                                   Icon="{ui:SymbolIcon Next24, Filled=True}" Command="{Binding PlayNextCommand}" ToolTip="다음 곡"/>
                    </StackPanel>
                </Grid>

                <!-- where in the song: a thin line, and the times -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="Progress" Height="3" VerticalAlignment="Center" Minimum="0" Maximum="{Binding DurationSeconds}"
                                 Value="{Binding PositionSeconds, Mode=OneWay}" Foreground="{DynamicResource PlayerAccentBrush}"
                                 Background="{DynamicResource PlayerTrackBrush}" BorderThickness="0" IsHitTestVisible="False"/>
                    <TextBlock Grid.Column="1" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Typography.NumeralAlignment="Tabular">
                        <Run Text="{Binding PositionText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- the menu: how solid, and off -->
            <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" HorizontalOffset="-200" VerticalOffset="4"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Margin="8" Width="240" CornerRadius="10" Padding="14,12" Background="{DynamicResource PlayerTintBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource PlayerTrackBrush}"
                        DataContext="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="투명도" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding OpacityText}" FontSize="12" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Slider Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Opacity}" Margin="0,8,0,4"
                                IsMoveToPointEnabled="True" AutomationProperties.Name="HUD 투명도"/>
                        <TextBlock Text="마우스를 올리면 잠시 선명해집니다" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ui:Button Content="HUD 끄기" Icon="{ui:SymbolIcon Dismiss24}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                   Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
