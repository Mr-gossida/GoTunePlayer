<ui:FluentWindow x:Class="TuneSync.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:TuneSync.App.Views"
        Title="TuneSync" Height="820" Width="1480"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TuneSync"/>

        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation" IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="라이브러리" Icon="{ui:SymbolIcon MusicNote224}" TargetPageType="{x:Type views:LibraryView}"/>
                <ui:NavigationViewItem Content="자동 채움" Icon="{ui:SymbolIcon Sparkle24}" TargetPageType="{x:Type views:AutoMatchView}"/>
                <ui:NavigationViewItem Content="폴더 합치기" Icon="{ui:SymbolIcon FolderSync24}" TargetPageType="{x:Type views:MergeView}"/>
                <ui:NavigationViewItem Content="이름 변경" Icon="{ui:SymbolIcon TextSortAscending24}" TargetPageType="{x:Type views:RenameView}"/>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="설정" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type views:SettingsView}"/>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
