<UserControl x:Class="TuneSync.App.Views.LibrarySourceBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
             xmlns:conv="clr-namespace:TuneSync.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}">
    <UserControl.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
    </UserControl.Resources>

    <!-- Library source add/remove/rescan. DataContext: LibraryViewModel. -->
    <Border Padding="2,4,2,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PlayerHoverBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="16" Margin="0,0,4,0" Icon="{ui:SymbolIcon Add24}"
                       Click="AddButton_Click" ToolTip="음악 추가 (폴더·파일 / 네트워크 위치)">
                <ui:Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="폴더·파일 추가…" Click="AddLocal_Click">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="FolderAdd24"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="네트워크 위치 추가…" Click="AddNetwork_Click">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="CloudAdd24"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ui:Button.ContextMenu>
            </ui:Button>
            <ui:Button Grid.Column="1" Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="16" Margin="0,0,4,0" Icon="{ui:SymbolIcon Subtract24}"
                       Click="RemoveButton_Click" ToolTip="목록 정리">
                <ui:Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="모두 제거" Click="RemoveAll_Click"/>
                        <Separator/>
                        <MenuItem Header="존재하지 않는 폴더/파일 제거" Click="RemoveMissing_Click"/>
                        <MenuItem Header="중복 항목 제거" Click="RemoveDuplicates_Click"/>
                    </ContextMenu>
                </ui:Button.ContextMenu>
            </ui:Button>
            <ui:Button Grid.Column="2" Style="{StaticResource PlayerIconButtonStyle}" Width="32" Height="32" FontSize="16" Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding RescanCommand}" ToolTip="새로고침"/>
            <ui:TextBlock Grid.Column="3" Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Margin="10,0,0,0"
                          VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:ProgressRing Grid.Column="4" IsIndeterminate="True" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsScanning, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
        </Grid>
    </Border>
</UserControl>
