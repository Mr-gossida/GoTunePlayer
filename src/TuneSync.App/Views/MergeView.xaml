<Page x:Class="TuneSync.App.Views.MergeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="폴더 합치기">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="원본(합칠) 폴더:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="SourceFolderBox" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="찾아보기..." Margin="6,0,0,0" Click="BrowseSource_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="대상(목적지) 폴더:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="DestFolderBox" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="찾아보기..." Margin="6,0,0,0" Click="BrowseDest_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="미리보기(Dry Run)" Padding="10,4" Click="Scan_Click"/>
            <Button Content="적용" Padding="10,4" Margin="8,0,0,0" Click="Execute_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="동작" Binding="{Binding ActionLabel}" Width="100"/>
                <DataGridTextColumn Header="원본 파일" Binding="{Binding SourceName}" Width="2*"/>
                <DataGridTextColumn Header="저장될 이름" Binding="{Binding DestFileName}" Width="2*"/>
                <DataGridTextColumn Header="충돌 대상" Binding="{Binding ConflictName}" Width="2*"/>
                <DataGridTextColumn Header="원본 크기" Binding="{Binding SourceSizeKb}" Width="90"/>
                <DataGridTextColumn Header="충돌 크기" Binding="{Binding ConflictSizeKb}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="적용 시 '복제' 또는 '중복(기존 유지/신규 유지)' 결과로 밀려나는 쪽은 삭제되지 않고 대상 폴더 옆의 _quarantine 폴더로 이동합니다. 필요하면 그 폴더에서 직접 되돌릴 수 있습니다."/>
    </Grid>
</Page>
