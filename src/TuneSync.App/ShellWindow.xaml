<ui:FluentWindow x:Class="TuneSync.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TuneSync.App"
        xmlns:conv="clr-namespace:TuneSync.App.Converters"
        Title="GoTune Player" Height="760" Width="1320"
        Icon="pack://application:,,,/Assets/TuneSync.ico"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="{DynamicResource PlayerTintBrush}"
        WindowCornerPreference="Round">
    <Window.Resources>
        <conv:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="MediaPlayPause" Command="{Binding TogglePlayPauseCommand}"/>
        <KeyBinding Key="MediaStop" Command="{Binding StopCommand}"/>
        <KeyBinding Key="MediaNextTrack" Command="{Binding PlayNextCommand}"/>
        <KeyBinding Key="MediaPreviousTrack" Command="{Binding PlayPreviousCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Backdrop: the cover's own color, the cover itself stretched and blurred over it, and a
             scrim that deepens toward the bottom so text always stays readable. -->
        <Rectangle Grid.RowSpan="3" Fill="{DynamicResource PlayerTintBrush}"/>
        <!-- BackdropCover is already blurred (ImageHelper.BlurredBackdrop): stretching it is all the
             work left, so resizing the window stays smooth. -->
        <Grid Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False">
            <!-- The previous song's cover, fading out under the new one (ShellWindow code). -->
            <Image x:Name="BackdropPrevious" Stretch="UniformToFill" Opacity="0"
                   RenderOptions.BitmapScalingMode="Linear" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="BackdropImage" Source="{Binding BackdropCover}" Stretch="UniformToFill" Opacity="0.55"
                   RenderOptions.BitmapScalingMode="Linear" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                </Image.RenderTransform>
            </Image>
        </Grid>
        <Rectangle Grid.RowSpan="3" Fill="{DynamicResource PlayerScrimBrush}" IsHitTestVisible="False"/>

        <ui:TitleBar Grid.Row="0" Title="GoTune Player">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/TuneSync.png"/>
            </ui:TitleBar.Icon>
            <!-- The player is the main window; the tag/merge/rename tools and settings open in
                 their own windows from here. -->
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Width="34" Height="30" FontSize="16"
                               Icon="{ui:SymbolIcon Search24}" ToolTip="재생목록 검색 (Ctrl+F)" Click="Search_Click"/>
                    <ui:DropDownButton Content="도구" Icon="{ui:SymbolIcon Toolbox24}" Height="30" Padding="10,0" Margin="4,0"
                                       Background="Transparent" BorderThickness="0"
                                       ToolTip="태그 관리, 폴더 합치기, 이름 변경">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="태그 관리" Click="OpenTagManager_Click">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Tag24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="폴더 합치기" Click="OpenMerge_Click">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="FolderSync24"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="이름 변경" Click="OpenRename_Click">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="TextSortAscending24"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="화면 보호기 시작" Click="StartScreenSaver_Click">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Desktop24"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Width="34" Height="30" FontSize="16"
                               Icon="{ui:SymbolIcon Settings24}" ToolTip="설정" Click="OpenSettings_Click"/>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Frame x:Name="PlayerFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Focusable="False"/>

        <!-- Transport bar: what's playing | controls + seek | view toggles + volume. DataContext is
             the PlaybackViewModel singleton, set on the Window. -->
        <Border Grid.Row="2" Background="{DynamicResource PlayerPanelBrush}" Padding="16,10,16,12">
            <Grid x:Name="TransportGrid" SizeChanged="Transport_SizeChanged">
                <Grid.ColumnDefinitions>
                    <!-- Widths set by LayoutTransport: equal sides so the controls sit in the exact
                         middle, the right side never narrower than its buttons. -->
                    <ColumnDefinition x:Name="TransportLeft" Width="*" MinWidth="160"/>
                    <ColumnDefinition x:Name="TransportCenter" Width="2*"/>
                    <ColumnDefinition x:Name="TransportRight" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56" Margin="0,0,12,0">
                        <Border CornerRadius="6" Background="{DynamicResource PlayerHoverBrush}">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Border>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CurrentCoverSmall}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NowPlayingTitle}" ToolTip="{Binding NowPlayingTitle}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding NowPlayingSubtitle}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Style="{StaticResource PlayerToggleButtonStyle}" Margin="0,0,12,0"
                                   Tag="{Binding IsShuffle}" Command="{Binding ToggleShuffleCommand}" ToolTip="{Binding ShuffleToolTip}"
                                   Icon="{ui:SymbolIcon ArrowShuffle24}"/>
                        <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Margin="0,0,8,0" Icon="{ui:SymbolIcon Previous24, Filled=True}"
                                   Command="{Binding PlayPreviousCommand}" ToolTip="이전 곡 (Ctrl+←)"/>
                        <ui:Button Style="{StaticResource PlayerPlayButtonStyle}"
                                   Icon="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                                   Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지 (Space)"/>
                        <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Margin="8,0,0,0" Icon="{ui:SymbolIcon Next24, Filled=True}"
                                   Command="{Binding PlayNextCommand}" ToolTip="다음 곡 (Ctrl+→)"/>
                        <ui:Button Margin="12,0,0,0" Command="{Binding CycleRepeatCommand}" ToolTip="{Binding RepeatToolTip}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
                                    <Setter Property="Icon" Value="{ui:SymbolIcon ArrowRepeatAll24}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Repeat}" Value="All">
                                            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Repeat}" Value="One">
                                            <Setter Property="Icon" Value="{ui:SymbolIcon ArrowRepeat124}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="11" VerticalAlignment="Center"
                                   TextAlignment="Right" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <local:WaveSeekBar x:Name="SeekBar" Grid.Column="1" Height="28" VerticalAlignment="Center"
                                           Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                           IsPlaying="{Binding IsPlaying}" Waveform="{Binding Waveform}" Look="{Binding SeekLook}"
                                           WaveBrush="{DynamicResource PlayerAccentBrush}"
                                           TrackBrush="{DynamicResource PlayerTrackBrush}"
                                           SeekStarted="SeekBar_SeekStarted" SeekCompleted="SeekBar_SeekCompleted"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="TransportTools" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            SizeChanged="Transport_SizeChanged">
                    <!-- 예약 종료: lit while a shutdown is scheduled, with the time left beside it.
                         DataContext is the SleepTimerViewModel (set in code). -->
                    <ui:Button x:Name="SleepTimerButton" Margin="0,0,2,0" Click="SleepTimer_Click"
                               Tag="{Binding IsActive}" ToolTip="{Binding ToolTip}" Width="NaN" MinWidth="36" Padding="9,0">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PlayerToggleButtonStyle}">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="18"/>
                            <TextBlock Text="{Binding RemainingText}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource PlayerToggleButtonStyle}" Icon="{ui:SymbolIcon SlideText24}"
                               Tag="{Binding IsLyricsVisible}" Command="{Binding ToggleLyricsCommand}" ToolTip="가사 보기"/>
                    <ui:Button Style="{StaticResource PlayerToggleButtonStyle}" Margin="2,0,0,0" Icon="{ui:SymbolIcon TextBulletListLtr24}"
                               Tag="{Binding IsQueueVisible}" Command="{Binding ToggleQueueCommand}" ToolTip="재생 대기열"/>
                    <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Margin="2,0,10,0" Icon="{ui:SymbolIcon PictureInPictureEnter24}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Click="MiniMode_Click" ToolTip="미니 플레이어 (Ctrl+M)"/>
                    <ui:Button Command="{Binding ToggleMuteCommand}" ToolTip="음소거">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
                                <Setter Property="Icon" Value="{ui:SymbolIcon Speaker224}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon SpeakerMute24}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <Slider x:Name="VolumeSlider" PreviewMouseWheel="Volume_PreviewMouseWheel" Width="96" Margin="4,0,0,0" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                            Value="{Binding Volume}" ToolTip="볼륨 (Ctrl+↑/↓, 마우스 휠)"/>
                    <TextBlock x:Name="VolumeText" Text="{Binding VolumePercent}" Width="26" Margin="6,0,0,0" TextAlignment="Right" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast notifications (Toast.cs), floating just above the transport bar. -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" VerticalAlignment="Bottom" Margin="20,0,20,12"/>
    </Grid>
</ui:FluentWindow>
