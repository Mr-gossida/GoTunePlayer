<ui:FluentWindow x:Class="TuneSync.App.LyricsSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:TuneSync.App.Converters"
        Title="싱크 가사 만들기" Width="760" Height="820" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" WindowCornerPreference="Round" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>

        <!-- One lyric line: [time] [check mark] text. The line being sung gets an accent bar. -->
        <Style x:Key="LineItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="4,3" Margin="0,1,10,1"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="싱크 가사 만들기" ShowMinimize="False" ShowMaximize="False"/>

        <!-- Song -->
        <Grid Grid.Row="1" Margin="24,8,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="56" Height="56" Margin="0,0,14,0">
                <Border CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Border>
                <Border CornerRadius="6">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding File.CoverThumbnail}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding File.DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding File.Artist}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Automatic sync -->
        <Border Grid.Row="2" Margin="24,0,24,12" Padding="16,14" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="자동으로 맞추기" FontWeight="SemiBold"/>
                    <TextBlock FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="음성 인식이 이 PC에서 노래를 듣고 각 줄의 시간을 찾습니다. 노래와 가사는 외부로 보내지 않습니다. 결과는 아래에서 들어보며 고칠 수 있습니다."
                               Visibility="{Binding IsBusy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}"/>
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ProgressBar Value="{Binding Progress}" Maximum="1" Height="4" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="자동으로 맞추기" Icon="{ui:SymbolIcon Sparkle24}" Appearance="Primary" Command="{Binding AutoSyncCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}"/>
                    <ui:Button Content="취소" Command="{Binding CancelWorkCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lines -->
        <ListBox x:Name="LinesList" Grid.Row="3" Margin="20,0,14,0" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                 ItemContainerStyle="{StaticResource LineItemStyle}" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="98"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- the time: click to play from just before it -->
                        <ui:Button x:Name="TimeButton" Content="{Binding TimeText}" FontFamily="Consolas" FontSize="13" Padding="8,3"
                                   Appearance="Transparent" HorizontalAlignment="Left" Click="TimeButton_Click"
                                   ToolTip="여기부터 듣기 (Enter)"/>
                        <Ellipse x:Name="CheckDot" Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Center" Visibility="Collapsed"
                                 Fill="{DynamicResource SystemFillColorCautionBrush}"
                                 ToolTip="자동으로 추정한 시간입니다. 들어보고 맞는지 확인하세요."/>
                        <TextBlock x:Name="LineText" Grid.Column="2" Text="{Binding Text}" FontSize="14" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="4,0,0,0"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasTime}" Value="False">
                            <Setter TargetName="TimeButton" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NeedsCheck}" Value="True">
                            <Setter TargetName="CheckDot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="TimeButton" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="LineText" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Listen and tap -->
        <Border Grid.Row="4" Margin="24,10,24,0" Padding="12,10" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Width="40" Height="40" CornerRadius="20" Padding="0" Appearance="Primary" Command="{Binding TogglePlayCommand}"
                               Icon="{Binding Playback.IsPlaying, Converter={StaticResource PlayPauseIconConverter}}" ToolTip="재생 / 일시정지"/>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="PositionText" FontFamily="Consolas" FontSize="15" Text="00:00.00"/>
                        <TextBlock Text="{Binding Playback.DurationText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="−0.1초" Command="{Binding NudgeBackCommand}" Margin="0,0,4,0" ToolTip="선택한 줄을 앞당기기 (←, Shift+← 0.5초)"/>
                    <ui:Button Content="+0.1초" Command="{Binding NudgeForwardCommand}" Margin="0,0,10,0" ToolTip="선택한 줄을 늦추기 (→, Shift+→ 0.5초)"/>
                    <ui:Button Content="지금 시간 찍기" Icon="{ui:SymbolIcon Flag24}" Appearance="Primary" Command="{Binding StampCommand}"
                               ToolTip="선택한 줄을 지금 재생 위치로 정하고 다음 줄로 (Space)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="24,12,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Space 시간 찍기 · Enter 이 줄부터 듣기 · ↑↓ 줄 이동 · ←→ 0.1초 조정 · Delete 시간 지우기 · Ctrl+S 저장"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <ui:Button Content="취소" Click="Cancel_Click" Margin="0,0,8,0"/>
                <ui:Button Content="저장" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
