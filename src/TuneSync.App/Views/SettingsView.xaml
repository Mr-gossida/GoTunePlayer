                            <StackPanel>
                                <ui:TextBlock Text="헤드룸" FontTypography="Body"/>
                                <ui:TextBlock Text="올린 만큼 전체 음량을 미리 낮추기 (소리가 작아집니다)" Style="{StaticResource Desc}"/>
