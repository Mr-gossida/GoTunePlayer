<Page x:Class="TuneSync.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
      Title="설정"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16,20,24" MaxWidth="900" HorizontalAlignment="Left">
        <ui:TextBlock Text="설정" FontTypography="Title" Margin="0,0,0,16"/>

        <ui:TextBlock Text="모양" FontTypography="BodyStrong" Margin="0,0,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="테마" FontTypography="Body"/>
                    <ui:TextBlock Text="앱의 밝은/어두운 테마를 선택합니다." FontSize="12"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="200" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding Theme}"/>
        </ui:CardControl>

        <ui:TextBlock Text="라이브러리" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderAdd24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="폴더·파일을 추가할 때" FontTypography="Body"/>
                    <ui:TextBlock Text="이미 등록된 목록이 있을 때, 새로 고른 항목을 기존 목록에 더할지 목록을 새로 만들지 정합니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="200" ItemsSource="{Binding Library.AddModeOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding Library.AddMode}"/>
        </ui:CardControl>

        <ui:TextBlock Text="재생" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Desktop24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="재생 중 화면 켜짐 유지" FontTypography="Body"/>
                    <ui:TextBlock Text="음악이 재생되는 동안 화면이 꺼지거나 PC가 절전 모드로 들어가지 않게 합니다. 일시정지하거나 멈추면 원래대로 돌아갑니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding Playback.KeepScreenOn}" OnContent="켬" OffContent="끔"/>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon SlideMultiple24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="화면 보호기" FontTypography="Body"/>
                    <ui:TextBlock Text="음악이 재생되는 동안 마우스·키보드 입력이 없으면 커버와 가사, 시계를 전체 화면으로 보여 줍니다. 마우스를 움직이면 돌아옵니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="110" Margin="0,0,12,0" ItemsSource="{Binding ScreenSaverDelayOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding ScreenSaverMinutes}" IsEnabled="{Binding ScreenSaverEnabled}"
                          ToolTip="입력이 없을 때 이 시간이 지나면 시작합니다"/>
                <ui:Button Content="미리 보기" Margin="0,0,12,0" Command="{Binding PreviewScreenSaverCommand}"/>
                <ui:ToggleSwitch IsChecked="{Binding ScreenSaverEnabled}" OnContent="켬" OffContent="끔"/>
            </StackPanel>
        </ui:CardControl>

        <ui:TextBlock Text="폴더 합치기" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderProhibited24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="격리 폴더 이름" FontTypography="Body"/>
                    <ui:TextBlock Text="충돌한 파일을 삭제하지 않고 옮겨 두는, 타겟 폴더 안의 폴더 이름입니다." FontSize="12" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox Width="240" Text="{Binding QuarantineFolderName, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False"/>
        </ui:CardControl>

        <ui:TextBlock Text="데이터" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderOpen24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="데이터 폴더" FontTypography="Body"/>
                    <ui:TextBlock Text="설정 파일과 자동 채움 적용 기록(되돌리기용 이전 태그)이 저장되는 폴더입니다." FontSize="12" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="폴더 열기" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenDataFolderCommand}"/>
        </ui:CardControl>

        <ui:TextBlock Text="정보" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:Card Margin="0,0,0,4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/TuneSync.png" Width="40" Height="40" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="TuneSync" FontTypography="BodyStrong"/>
                        <ui:TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ui:TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="태그·커버 정보는 MusicBrainz와 Cover Art Archive, 가사는 LRCLIB에서 가져옵니다."/>
            </StackPanel>
        </ui:Card>
    </StackPanel>
    </ScrollViewer>
</Page>
