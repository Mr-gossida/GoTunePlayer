<Page x:Class="TuneSync.App.Views.SongEditorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:views="clr-namespace:TuneSync.App.Views"
      xmlns:conv="clr-namespace:TuneSync.App.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SongEditorViewModel}"
      Title="태그 편집"
      PreviewKeyDown="Page_PreviewKeyDown" KeyDown="Page_KeyDown"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- One song's tags, cover and lyrics in a window of their own: the cover large on the left,
         the fields as a two-column form on the right, saved from the bar below. Foreground: see
         PlayView.xaml. -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:TagEditorParts/>
            </ResourceDictionary.MergedDictionaries>
            <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
            <conv:EmptyDashConverter x:Key="EmptyDashConverter"/>
            <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <!-- 태그 찾기 / 가사 찾기 cards: the one in use across the width, or all of them two a row -->
            <ItemsPanelTemplate x:Key="TwoCandidateColumns">
                <UniformGrid Columns="2" VerticalAlignment="Top"/>
            </ItemsPanelTemplate>
            <Style x:Key="CandidateColumns" TargetType="ItemsControl">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="3,0"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InfoLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,3,12,3"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            </Style>
            <Style x:Key="InfoValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="Root" Margin="24,6,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid DataContext="{Binding Editor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left: the cover and the file ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,0,16">
                    <!-- the cover: click to see it large, drop an image file to use it -->
                    <Border Width="240" Height="240" CornerRadius="10" Cursor="Hand" ToolTip="클릭하면 크게 봅니다 · 이미지 파일을 끌어다 놓으면 바뀝니다"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            MouseLeftButtonUp="Cover_Click"
                            AllowDrop="True" DragEnter="CoverDrop_DragOver" DragOver="CoverDrop_DragOver" DragLeave="CoverDrop_DragLeave" Drop="CoverDrop_Drop">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding ShowCoverPlaceholder, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                <ui:SymbolIcon Symbol="ImageAdd24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="이미지를 여기로 끌어다 놓으세요" Margin="0,8,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                            <Border CornerRadius="9" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="5" Padding="7,2,8,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False"
                                    Visibility="{Binding IsRecommendedCoverShown, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Star16" Filled="True" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                    <TextBlock Text="추천 커버" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CoverDropHighlight" CornerRadius="9" BorderThickness="2" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource TagChangeBrush}" Background="#33000000">
                                <TextBlock Text="놓으면 커버로 사용합니다" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource TagChangeBrush}"
                                Visibility="{Binding IsCoverPending, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <TextBlock Text="저장 전" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TagChangeOnBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding CoverInfo}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <!-- which album the chosen online cover belongs to (nothing, no line) -->
                    <TextBlock Text="{Binding CoverCandidateDetail}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CoverCandidateDetail}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CoverCandidateDetail}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CoverCandidateDetail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <UniformGrid Columns="2" Margin="-3,10,-3,0">
                        <ui:Button Content="커버 찾기" Icon="{ui:SymbolIcon Search24}" Margin="3" HorizontalAlignment="Stretch" Click="SearchCover_Click"
                                   ToolTip="온라인에서 앨범 커버를 찾아 추천 커버를 넣고, 다른 후보는 '커버' 탭에 보여 줍니다"/>
                        <ui:Button Content="파일 선택" Icon="{ui:SymbolIcon Image24}" Margin="3" HorizontalAlignment="Stretch" Command="{Binding PickCoverCommand}"
                                   ToolTip="이미지 파일을 골라 커버로 사용합니다"/>
                        <ui:Button Content="붙여넣기" Icon="{ui:SymbolIcon ClipboardPaste24}" Margin="3" HorizontalAlignment="Stretch" Command="{Binding PasteCoverCommand}"
                                   ToolTip="복사한 이미지나 이미지 파일을 커버로 사용합니다"/>
                        <ui:Button Content="지우기" Icon="{ui:SymbolIcon Delete24}" Margin="3" HorizontalAlignment="Stretch" Command="{Binding RemoveCoverCommand}"/>
                    </UniformGrid>
                    <ui:Button Content="커버 되돌리기" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding RevertCoverCommand}" Margin="0,4,0,0"
                               Appearance="Transparent" HorizontalAlignment="Left"
                               Visibility="{Binding IsCoverPending, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>

                    <!-- the file -->
                    <Rectangle Height="1" Margin="0,16,0,10" Fill="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="형식" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding FileFormat}" ToolTip="{Binding FileFormat}" Style="{StaticResource InfoValue}"/>
                        <TextBlock Grid.Row="1" Text="크기" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSize, Converter={StaticResource EmptyDashConverter}}" Style="{StaticResource InfoValue}"/>
                        <TextBlock Grid.Row="2" Text="이름" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileName}" ToolTip="{Binding FileName}" Style="{StaticResource InfoValue}"/>
                        <!-- under the name: the one 이름 변경's rule gives it (from the tags as edited), or why there's none to give -->
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,3" ToolTip="{Binding RenameRuleText}">
                            <StackPanel Visibility="{Binding RenameState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Change}">
                                <TextBlock FontSize="12" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TagChangeBrush}">
                                    <Run Text="→"/><Run Text=" "/><Run Text="{Binding RenameNewName, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Text="저장하지 않은 태그 기준 · 바꿀 때 함께 저장합니다" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding RenameNeedsSave, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                <TextBlock Text="{Binding RenameNote}" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RenameNote}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding RenameState}" Value="{x:Static vm:FileRenameState.Same}"/>
                                                    <Condition Binding="{Binding CanUndoRename}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="CheckmarkCircle16" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="이름 변경 규칙에 맞는 이름" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                            <!-- just renamed here: the old name one click away -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding CanUndoRename, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle16" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="이름을 바꿨습니다" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:Button Content="되돌리기" Appearance="Transparent" Padding="6,0" Margin="4,0,0,0" FontSize="11" MinHeight="0"
                                           Command="{Binding UndoRenameCommand}" ToolTip="원래 파일 이름으로 되돌립니다"
                                           IsEnabled="{Binding IsRenaming, Converter={StaticResource InverseBooleanConverter}}"/>
                            </StackPanel>
                            <TextBlock Text="규칙에 쓰는 태그가 비어 있어 새 이름을 만들 수 없습니다" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding RenameState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=NoName}"/>
                            <TextBlock Text="{Binding RenameNote}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding RenameState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Remote}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="위치" Style="{StaticResource InfoLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FileLocation}" ToolTip="{Binding FilePath}" Style="{StaticResource InfoValue}"/>
                    </Grid>
                    <UniformGrid Columns="2" Margin="-3,8,-3,0">
                        <ui:Button Content="폴더 열기" Icon="{ui:SymbolIcon FolderOpen24}" Margin="3" HorizontalAlignment="Stretch" Click="RevealFile_Click"
                                   ToolTip="파일이 있는 폴더를 엽니다"/>
                        <!-- (ToolTipService: the reason shows on the button greyed out too) -->
                        <ui:Button Content="이름 변경" Icon="{ui:SymbolIcon Rename24}" Margin="3" HorizontalAlignment="Stretch"
                                   Command="{Binding RenameFileCommand}" IsEnabled="{Binding CanRename}"
                                   ToolTip="{Binding RenameButtonToolTip}" ToolTipService.ShowOnDisabled="True"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Right: title, tabs ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,2,0,0">
                    <!-- opened with several songs: step through them -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                DataContext="{Binding DataContext, ElementName=Root}"
                                Visibility="{Binding HasMany, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                        <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent" Padding="6" Command="{Binding PreviousCommand}"
                                   ToolTip="이전 곡 (Alt+←)"/>
                        <TextBlock Text="{Binding PositionText}" FontSize="12" Margin="6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent" Padding="6" Command="{Binding NextCommand}"
                                   ToolTip="다음 곡 (Alt+→)"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding HeaderTitle}" ToolTip="{Binding HeaderTitle}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding HeaderDetail}" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,14,0,12">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="온라인에서 태그 찾기" Icon="{ui:SymbolIcon GlobeSearch24}" Appearance="Transparent"
                                   Padding="8,3" Margin="0,0,0,6" Command="{Binding SearchTagsCommand}" VerticalAlignment="Center"
                                   ToolTip="제목·아티스트로 아래 출처에서 찾아, 가장 잘 맞는 결과를 저장 전 변경으로 넣습니다. 칸마다 되돌릴 수 있습니다"
                                   Visibility="{Binding Tab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Tags}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="SongTabs" Style="{StaticResource PanelTab}" Content="정보"
                                         IsChecked="{Binding Tab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Tags}"/>
                            <RadioButton GroupName="SongTabs" Style="{StaticResource PanelTab}" Content="커버" Tag="{Binding HasCoverCandidates}"
                                         IsChecked="{Binding Tab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Cover}"/>
                            <RadioButton GroupName="SongTabs" Style="{StaticResource PanelTab}" Content="가사" Tag="{Binding IsLyricsPending}"
                                         IsChecked="{Binding Tab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Lyrics}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 정보: the fields as a form -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Visibility="{Binding Tab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Tags}">
                    <StackPanel Margin="0,0,10,16">
                        <!-- where 온라인에서 태그 찾기 looks (switched here or in 설정 › 도구), and what it said -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="출처" FontSize="12" Margin="0,4,10,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding Sources.TagSources}" ItemTemplate="{StaticResource SourceChipTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchStatusTemplate}" Focusable="False" Margin="0,0,0,8"/>
                        <!-- what 태그 찾기 found, above the fields it changes: the card in use, or all of
                             them (two a row) to choose from -->
                        <StackPanel Margin="0,0,0,12" Visibility="{Binding HasTagCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <DockPanel Margin="0,0,0,4">
                                <ui:Button DockPanel.Dock="Right" Content="{Binding MoreTagCandidatesText}" Appearance="Transparent" Padding="8,2" FontSize="12"
                                           Command="{Binding ToggleMoreTagCandidatesCommand}"
                                           ToolTip="찾은 결과를 일치율 순으로 모두 보여 줍니다"
                                           Visibility="{Binding HasMoreTagCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                <TextBlock Text="{Binding TagCandidatesHeader}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding TagCandidates}" ItemTemplate="{StaticResource TagCandidateTemplate}" Margin="-3,0" Focusable="False">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl" BasedOn="{StaticResource CandidateColumns}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowAllTagCandidates}" Value="True">
                                                <Setter Property="ItemsPanel" Value="{StaticResource TwoCandidateColumns}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="원래 태그로" Icon="{ui:SymbolIcon ArrowUndo16}" Appearance="Transparent"
                                           Padding="8,2" FontSize="12" Margin="6,0,0,0" Command="{Binding UndoTagCandidateCommand}"
                                           ToolTip="찾은 결과로 바뀐 칸을 원래 값으로 되돌립니다 (직접 고친 칸은 그대로)"
                                           Visibility="{Binding IsTagCandidateApplied, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                <TextBlock Text="카드를 누르면 그 값으로 바뀝니다. 저장하기 전까지 파일은 그대로입니다." FontSize="11" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </DockPanel>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <ContentControl Grid.ColumnSpan="3" Content="{Binding TitleField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            <ContentControl Grid.Row="1" Content="{Binding ArtistField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding AlbumArtistField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            <ContentControl Grid.Row="2" Grid.ColumnSpan="3" Content="{Binding AlbumField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding YearField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                                <ContentControl Grid.Column="2" Content="{Binding GenreField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding TrackField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                                <ContentControl Grid.Column="2" Content="{Binding DiscField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            </Grid>
                            <ContentControl Grid.Row="4" Grid.ColumnSpan="3" Content="{Binding ComposerField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 커버 후보: what 커버 찾기 found, ranked -->
                <ScrollViewer x:Name="CandidateScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              ScrollChanged="CandidateScroll_ScrollChanged"
                              Visibility="{Binding Tab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Cover}">
                    <Grid Margin="0,0,10,16">
                        <StackPanel Visibility="{Binding HasCoverCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="일치율 순" FontSize="11" VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="{Binding CoverCandidatesHeader}" FontSize="13" FontWeight="SemiBold"/>
                            </DockPanel>
                            <ItemsControl x:Name="CandidateList" ItemsSource="{Binding CoverCandidates}" Margin="-4,0" Focusable="False"
                                          ItemTemplate="{StaticResource CoverCandidateTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="썸네일을 누르면 그 커버로 바뀝니다. 저장하기 전까지 파일은 그대로입니다." FontSize="11" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource EditorEmpty}"
                                    Visibility="{Binding HasCoverCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}">
                            <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="온라인에서 커버를 찾으면 후보가 여기에 나옵니다." Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:Button Content="커버 찾기" Icon="{ui:SymbolIcon Search24}" HorizontalAlignment="Center" Margin="0,14,0,0" Click="SearchCover_Click"/>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchStatusTemplate}" Focusable="False" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 가사 -->
                <Grid Grid.Row="2" Margin="0,0,10,12"
                      Visibility="{Binding Tab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Lyrics}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Content="가사 찾기" Icon="{ui:SymbolIcon Search24}" Padding="10,4" FontSize="12" Margin="4,0,0,0"
                                       Command="{Binding SearchLyricsCommand}"
                                       ToolTip="아래 출처에서 이 곡(길이·앨범까지 맞는 버전)의 가사를 찾아, 가장 잘 맞는 것을 넣습니다. 싱크 가사를 우선합니다"/>
                            <ui:Button Content="싱크 가사 만들기" Icon="{ui:SymbolIcon Sparkle24}" Padding="10,4" FontSize="12" Margin="4,0,0,0"
                                       Command="{Binding MakeSyncedCommand}"
                                       Visibility="{Binding CanMakeSynced, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            <ui:Button Content="싱크 편집" Icon="{ui:SymbolIcon Edit24}" Padding="10,4" FontSize="12" Margin="4,0,0,0"
                                       Command="{Binding MakeSyncedCommand}"
                                       Visibility="{Binding CanEditSynced, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            <ui:Button Content="되돌리기" Icon="{ui:SymbolIcon ArrowUndo16}" Appearance="Transparent" Padding="8,3" FontSize="12" Margin="4,0,0,0"
                                       Command="{Binding RevertLyricsCommand}"
                                       Visibility="{Binding IsLyricsPending, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                                             Visibility="{Binding IsLyricsLoading, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            <TextBlock Text="{Binding LyricsInfo}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- where 가사 찾기 looks, what it said, and what it found: two cards a row, kept
                         short so the lyrics keep their room -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="출처" FontSize="12" Margin="0,4,10,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding Sources.LyricsSources}" ItemTemplate="{StaticResource SourceChipTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchStatusTemplate}" Focusable="False"/>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasLyricsCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <DockPanel Margin="0,0,0,4">
                                <ui:Button DockPanel.Dock="Right" Content="{Binding MoreLyricsCandidatesText}" Appearance="Transparent" Padding="8,2" FontSize="12"
                                           Command="{Binding ToggleMoreLyricsCandidatesCommand}"
                                           ToolTip="찾은 가사를 모두 보여 줍니다. 카드 위에 마우스를 올리면 가사를 더 볼 수 있습니다"
                                           Visibility="{Binding HasMoreLyricsCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                <TextBlock Text="{Binding LyricsCandidatesHeader}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding LyricsCandidates}" ItemTemplate="{StaticResource LyricsCandidateTemplate}" Margin="-3,0" Focusable="False">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl" BasedOn="{StaticResource CandidateColumns}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowAllLyricsCandidates}" Value="True">
                                                    <Setter Property="ItemsPanel" Value="{StaticResource TwoCandidateColumns}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                    <ui:TextBox Grid.Row="2" Text="{Binding LyricsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False"
                                TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="13"
                                PlaceholderText="가사를 입력하거나 붙여넣으세요" ClearButtonEnabled="False"
                                IsEnabled="{Binding IsLyricsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                    <TextBlock Grid.Row="3" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="[01:23.45] 처럼 시간이 붙은 줄이 있으면 싱크 가사로 재생됩니다. 모두 지우고 저장하면 가사가 삭제됩니다."/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Save bar ===== -->
        <Border Grid.Row="1" DataContext="{Binding Editor}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="0,12,0,14" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="되돌리기" Command="{Binding RevertAllCommand}" Margin="0,0,6,0" Appearance="Transparent"
                               ToolTip="저장하지 않은 변경 내용을 모두 되돌립니다"
                               Visibility="{Binding HasPending, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                    <ui:Button Content="닫기" Click="Close_Click" Margin="0,0,6,0"/>
                    <ui:Button Content="저장" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" Appearance="Primary"
                               IsEnabled="{Binding HasPending}" ToolTip="저장 (Ctrl+S)"/>
                </StackPanel>
                <Grid VerticalAlignment="Center">
                    <TextBlock FontSize="12" Text="변경 사항 없음" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding BarState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Idle}"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding BarState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Pending}">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{DynamicResource TagChangeBrush}"/>
                        <TextBlock Text="{Binding PendingSummary}" FontSize="12" Foreground="{DynamicResource TagChangeBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding BarState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Saving}">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SaveProgress}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding BarState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Saved}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="{Binding UndoText}" FontSize="12" VerticalAlignment="Center"/>
                        <ui:Button Content="실행 취소" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoCommand}" Appearance="Transparent"
                                   Padding="8,2" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Page>
