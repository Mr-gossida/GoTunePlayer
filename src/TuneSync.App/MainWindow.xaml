<Window x:Class="TuneSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TuneSync.App.Views"
        Title="TuneSync" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="4">
        <TabItem Header="1. 폴더 합치기">
            <views:MergeView/>
        </TabItem>
        <TabItem Header="2. 앨범 커버">
            <views:CoverView/>
        </TabItem>
        <TabItem Header="3. 폴더·파일명 규칙">
            <views:RenameView/>
        </TabItem>
        <TabItem Header="4. 가사">
            <views:LyricsView/>
        </TabItem>
        <TabItem Header="5. 태그">
            <views:TagView/>
        </TabItem>
    </TabControl>
</Window>
