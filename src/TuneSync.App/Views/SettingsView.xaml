<Page x:Class="TuneSync.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
      Title="설정"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16,20,24" MaxWidth="900" HorizontalAlignment="Left">
        <ui:TextBlock Text="설정" FontTypography="Title" Margin="0,0,0,16"/>

        <ui:TextBlock Text="모양" FontTypography="BodyStrong" Margin="0,0,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="테마" FontTypography="Body"/>
                    <ui:TextBlock Text="앱의 밝은/어두운 테마를 선택합니다." FontSize="12"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="200" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding Theme}"/>
        </ui:CardControl>

        <ui:TextBlock Text="라이브러리" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderAdd24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="폴더·파일을 추가할 때" FontTypography="Body"/>
                    <ui:TextBlock Text="이미 등록된 목록이 있을 때, 새로 고른 항목을 기존 목록에 더할지 목록을 새로 만들지 정합니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="200" ItemsSource="{Binding Library.AddModeOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding Library.AddMode}"/>
        </ui:CardControl>

        <ui:TextBlock Text="네트워크" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:Card Margin="0,0,0,4" Padding="16,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Server24" FontSize="22" Margin="2,0,16,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <ui:TextBlock Text="네트워크 위치" FontTypography="Body"/>
                        <ui:TextBlock Text="NAS·서버·클라우드(WebDAV, Samba, SFTP, FTP)의 음악을 재생합니다. 태그·가사·커버를 고치면 원격지 파일에도 저장됩니다."
                                      FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="위치 추가" Icon="{ui:SymbolIcon Add24}" Margin="12,0,0,0" VerticalAlignment="Center"
                               Command="{Binding AddNetworkSourceCommand}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding NetworkSources}" Margin="38,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Address, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding UserName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}" ToolTip="이 위치 제거" Width="34" Height="32" Padding="0"
                                               Background="Transparent" BorderThickness="0"
                                               Command="{Binding DataContext.RemoveNetworkSourceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="아직 추가한 네트워크 위치가 없습니다." Margin="38,10,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNetworkSources}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ui:Card>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DatabaseArrowDown20}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="스트리밍 캐시" FontTypography="Body"/>
                    <ui:TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="네트워크 음악은 재생하면서 이 PC에 받아 두어, 다시 들을 때는 바로 재생됩니다. 다음 곡도 미리 받아 둡니다. 용량을 넘으면 오래 듣지 않은 곡부터 지웁니다."/>
                        <LineBreak/>
                        <Run Text="{Binding CacheUsageText, Mode=OneWay}" FontWeight="SemiBold"/>
                    </ui:TextBlock>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="100" ItemsSource="{Binding CacheSizeOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding CacheMegabytes}" ToolTip="최대 용량"/>
                <ui:Button Content="비우기" Margin="8,0,0,0" Command="{Binding ClearCacheCommand}"/>
                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0" Width="34" Padding="0" ToolTip="캐시 폴더 열기"
                           Command="{Binding OpenCacheFolderCommand}"/>
            </StackPanel>
        </ui:CardControl>

        <ui:TextBlock Text="시작" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Windows 시작 시 자동 실행" FontTypography="Body"/>
                    <ui:TextBlock Text="Windows에 로그인하면 TuneSync가 작업 표시줄에 최소화된 상태로 시작합니다. 작업 관리자 › 시작 앱에서도 끌 수 있습니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" OnContent="켬" OffContent="끔"/>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Play24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="시작하면 바로 재생" FontTypography="Body"/>
                    <ui:TextBlock Text="켜면 일시정지 상태로 기다리지 않고 바로 재생합니다. 이어 들을 곡이 없으면 재생 대기열의 첫 곡(셔플이 켜져 있으면 무작위 곡)부터 재생합니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding AutoPlayOnStartup}" OnContent="켬" OffContent="끔"/>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon History24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="마지막 곡 이어 듣기" FontTypography="Body"/>
                    <ui:TextBlock Text="TuneSync를 열면 마지막으로 듣던 곡을 어디서부터 준비할지 정합니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="200" ItemsSource="{Binding StartupResumeOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding StartupResume}"/>
        </ui:CardControl>

        <ui:TextBlock Text="재생" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Flash24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="재생바 효과" FontTypography="Body"/>
                    <ui:TextBlock Text="재생한 부분 위에서 음악에 맞춰 움직이는 효과입니다. 임의는 곡마다 물결과 불꽃 중 하나를 고릅니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="160" ItemsSource="{Binding SeekBarStyleOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding SeekBarStyle}"/>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DataBarVertical24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="스펙트럼 모양" FontTypography="Body"/>
                    <ui:TextBlock Text="곡 정보 아래와 화면 보호기의 스펙트럼입니다. 곡 정보 아래 스펙트럼을 클릭해도 차례로 바뀝니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="160" ItemsSource="{Binding SpectrumStyleOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding SpectrumStyle}"/>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="인트로 진행 게이지" FontTypography="Body"/>
                    <ui:TextBlock Text="싱크 가사가 시작되기 전 인트로 동안, 가사가 나오기까지 얼마나 남았는지 가는 막대로 보여 줍니다. 인트로가 끝나면 부드럽게 사라집니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ShowIntroGauge}" OnContent="표시" OffContent="숨김"/>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Desktop24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="재생 중 화면 켜짐 유지" FontTypography="Body"/>
                    <ui:TextBlock Text="음악이 재생되는 동안 화면이 꺼지거나 PC가 절전 모드로 들어가지 않게 합니다. 일시정지하거나 멈추면 원래대로 돌아갑니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding Playback.KeepScreenOn}" OnContent="켬" OffContent="끔"/>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon SlideMultiple24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="화면 보호기" FontTypography="Body"/>
                    <ui:TextBlock Text="음악이 재생되는 동안 마우스·키보드 입력이 없으면 커버와 가사, 시계를 전체 화면으로 보여 줍니다. 마우스를 움직이면 돌아옵니다."
                                  FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="110" Margin="0,0,12,0" ItemsSource="{Binding ScreenSaverDelayOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding ScreenSaverMinutes}" IsEnabled="{Binding ScreenSaverEnabled}"
                          ToolTip="입력이 없을 때 이 시간이 지나면 시작합니다"/>
                <ui:Button Content="미리 보기" Margin="0,0,12,0" Command="{Binding PreviewScreenSaverCommand}"/>
                <ui:ToggleSwitch IsChecked="{Binding ScreenSaverEnabled}" OnContent="켬" OffContent="끔"/>
            </StackPanel>
        </ui:CardControl>

        <ui:TextBlock Text="폴더 합치기" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderProhibited24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="격리 폴더 이름" FontTypography="Body"/>
                    <ui:TextBlock Text="충돌한 파일을 삭제하지 않고 옮겨 두는, 타겟 폴더 안의 폴더 이름입니다." FontSize="12" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox Width="240" Text="{Binding QuarantineFolderName, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False"/>
        </ui:CardControl>

        <ui:TextBlock Text="데이터" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderOpen24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="데이터 폴더" FontTypography="Body"/>
                    <ui:TextBlock Text="설정 파일과 자동 채움 적용 기록(되돌리기용 이전 태그)이 저장되는 폴더입니다." FontSize="12" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="폴더 열기" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenDataFolderCommand}"/>
        </ui:CardControl>

        <ui:TextBlock Text="정보" FontTypography="BodyStrong" Margin="0,20,0,8"/>
        <ui:Card Margin="0,0,0,4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/TuneSync.png" Width="40" Height="40" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <ui:TextBlock Text="TuneSync" FontTypography="BodyStrong"/>
                        <ui:TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ui:TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="태그·커버 정보는 MusicBrainz와 Cover Art Archive, 가사는 LRCLIB에서 가져옵니다."/>
            </StackPanel>
        </ui:Card>
    </StackPanel>
    </ScrollViewer>
</Page>
