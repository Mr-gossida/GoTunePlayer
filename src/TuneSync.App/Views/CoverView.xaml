<UserControl x:Class="TuneSync.App.Views.CoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="폴더:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="FolderBox" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="찾아보기..." Margin="6,0,0,0" Click="Browse_Click"/>
            <Button Grid.Column="3" Content="새로고침" Margin="6,0,0,0" Click="Refresh_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="TrackGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Extended"
                      SelectionChanged="TrackGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="2*"/>
                    <DataGridTextColumn Header="앨범" Binding="{Binding Album}" Width="1.5*"/>
                    <DataGridTextColumn Header="커버" Binding="{Binding HasCoverLabel}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="LightGray"/>

            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                <Border Height="220" Background="#EEEEEE">
                    <Image x:Name="CoverImage" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="SelectionInfo" Margin="0,8,0,8" TextWrapping="Wrap" Foreground="Gray"/>
                <Button Content="이미지 파일로 교체..." Padding="6,4" Click="ReplaceFromFile_Click"/>
                <Button Content="선택한 전체 항목에 같은 커버 적용" Padding="6,4" Margin="0,6,0,0" Click="ApplyToAll_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
