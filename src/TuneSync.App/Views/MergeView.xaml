<Page x:Class="TuneSync.App.Views.MergeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="폴더 합치기">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="원본(합칠) 폴더" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="SourceFolderBox" IsReadOnly="True" Margin="12,0"/>
                    <Button Grid.Column="2" Content="찾아보기..." Click="BrowseSource_Click"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="대상(목적지) 폴더" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="DestFolderBox" IsReadOnly="True" Margin="12,0"/>
                    <Button Grid.Column="2" Content="찾아보기..." Click="BrowseDest_Click"/>
                </Grid>
            </StackPanel>
        </ui:Card>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="미리보기 (Dry Run)" Click="Scan_Click"/>
            <ui:Button Grid.Column="1" Content="적용" Margin="8,0,0,0" Appearance="Primary" Click="Execute_Click"/>
            <TextBlock Grid.Column="2" x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7"/>
        </Grid>

        <ui:Card Grid.Row="2" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="동작" Binding="{Binding ActionLabel}" Width="130"/>
                        <DataGridTextColumn Header="원본 파일" Binding="{Binding SourceName}" Width="2*"/>
                        <DataGridTextColumn Header="저장될 이름" Binding="{Binding DestFileName}" Width="2*"/>
                        <DataGridTextColumn Header="충돌 대상" Binding="{Binding ConflictName}" Width="2*"/>
                        <DataGridTextColumn Header="원본 크기" Binding="{Binding SourceSizeKb}" Width="100"/>
                        <DataGridTextColumn Header="충돌 크기" Binding="{Binding ConflictSizeKb}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" Margin="16,8,16,16" Opacity="0.6" TextWrapping="Wrap" FontSize="12"
                           Text="적용 시 '복제' 또는 '중복(기존 유지/신규 유지)' 결과로 밀려나는 쪽은 삭제되지 않고 대상 폴더 옆의 _quarantine 폴더로 이동합니다. 필요하면 그 폴더에서 직접 되돌릴 수 있습니다."/>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
