                    <ui:TextBlock Text="GoTune Player가 실행 중이면 다른 프로그램을 쓰는 중에도 어디서든 작동하는 키" Style="{StaticResource CategoryLead}"/>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Keyboard24}" Tag="단축키 핫키 사용 전역 키보드">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="단축키 사용" FontTypography="Body"/>
                                <ui:TextBlock Text="아래에서 켠 단축키가 어디서든 작동합니다" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding Enabled}" OnContent="켬" OffContent="끔"/>
                    </ui:CardControl>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon MusicNote124}" Tag="멀티미디어 키 미디어 키보드 재생 일시정지 이전 다음 정지"
                                    ToolTip="키보드의 재생/일시정지 · 이전 곡 · 다음 곡 · 정지 키로 GoTune Player를 조작합니다. 다른 플레이어가 먼저 쓰고 있으면 그쪽에 남습니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="멀티미디어 키 사용" FontTypography="Body"/>
                                <ui:TextBlock Text="키보드의 재생 · 이전 · 다음 · 정지 키" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding MediaKeys}" OnContent="켬" OffContent="끔"/>
                    </ui:CardControl>

                    <Grid Margin="0,14,0,6" Tag="단축키 목록 이전 곡 재생 일시정지 정지 다음 곡 뒤로 앞으로 반복 랜덤 무작위 셔플 음소거 소리 높임 낮춤 미니 플레이어 HUD 기본값">
                        <ui:TextBlock Text="단축키 목록" FontTypography="BodyStrong" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <ui:Button Content="기본값으로" Icon="{ui:SymbolIcon ArrowReset24}" HorizontalAlignment="Right" Padding="10,4"
                                   Command="{Binding ResetCommand}" ToolTip="모든 단축키를 처음 설정(Ctrl+Alt + PageUp/Insert/End/PageDown 켜짐)으로 되돌립니다"/>
                    </Grid>
                    <Border Tag="단축키 목록 이전 곡 재생 일시정지 정지 다음 곡 뒤로 앞으로 반복 랜덤 무작위 셔플 음소거 소리 높임 낮춤 미니 플레이어 HUD 키 바꾸기"
                            CornerRadius="8" BorderThickness="1" Padding="16,8"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            IsEnabled="{Binding Enabled}">
                        <StackPanel>
                            <ui:TextBlock Text="키 칸을 클릭한 뒤 원하는 키를 누르면 바뀝니다 (Ctrl+Alt+F5처럼 조합째 눌러도 됩니다 · Esc는 취소)"
                                          Style="{StaticResource Desc}" Margin="0,4,0,8"/>
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HotkeyRowViewModel}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" Width="150" Margin="8,0,0,0" IsEnabled="{Binding Enabled}"
                                                      ItemsSource="{Binding DataContext.ModifierOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Modifiers}"/>
                                            <views:HotkeyBox Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource HotkeyKey}" IsEnabled="{Binding Enabled}"
                                                             Service="{Binding DataContext.Service, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                             AutomationProperties.Name="{Binding Name}"/>
                                            <ui:SymbolIcon Grid.Column="3" Symbol="Warning20" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" ToolTip="{Binding Problem}"
                                                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,4" Padding="10,8"
                                    CornerRadius="6" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="Warning20" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                    <ui:TextBlock TextWrapping="Wrap" FontSize="12" app:KeepWords.IsEnabled="True"
                                                  Text="표시된 키는 작동하지 않습니다. 다른 프로그램(다른 음악 플레이어 등)이 먼저 쓰고 있거나 다른 단축키와 겹칩니다. 키를 바꾸거나 그 프로그램의 단축키를 끄세요. 아이콘에 마우스를 올리면 이유가 보입니다."/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 화면 보호기: everything about it in one card -->
