<Page x:Class="TuneSync.App.Views.LibraryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:conv="clr-namespace:TuneSync.App.Converters"
      d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="라이브러리">
    <Page.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Folder selection -->
        <ui:CardExpander Grid.Row="0" IsExpanded="False" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,0,12">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="음악 폴더"/>
                        <ui:TextBlock Text="{Binding CurrentFolder, TargetNullValue='폴더를 선택해 주세요.'}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="폴더 선택" Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding BrowseFolderCommand}" Margin="0,0,12,0"/>
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="하위 폴더 포함" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center"/>
                <ui:Button Content="새로고침" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RescanCommand}" Margin="12,0,0,0"/>
            </StackPanel>
        </ui:CardExpander>

        <!-- Filters + view toggle -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" DataContext="{Binding Filter}">
                <ui:TextBlock Text="누락만 보기:" VerticalAlignment="Center" Margin="0,0,8,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ToggleButton Content="커버 없음" IsChecked="{Binding ShowMissingCoverOnly}" Margin="0,0,6,0"/>
                <ToggleButton Content="태그 없음" IsChecked="{Binding ShowMissingTagsOnly}" Margin="0,0,6,0"/>
                <ToggleButton Content="가사 없음" IsChecked="{Binding ShowMissingLyricsOnly}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton GroupName="ViewModeGroup" Content="목록" Margin="0,0,12,0" VerticalAlignment="Center"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=List}"/>
                <RadioButton GroupName="ViewModeGroup" Content="그리드" VerticalAlignment="Center"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Grid}"/>
            </StackPanel>
        </Grid>

        <!-- List view -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilesView}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=List}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="파일" Binding="{Binding FileName}" Width="260"/>
                <DataGridTextColumn Header="아티스트" Binding="{Binding Artist}" Width="150"/>
                <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="앨범" Binding="{Binding Album}" Width="180"/>
                <DataGridTextColumn Header="커버" Binding="{Binding CoverMark}" Width="60"/>
                <DataGridTextColumn Header="가사" Binding="{Binding LyricsMark}" Width="60"/>
                <DataGridTextColumn Header="상태" Binding="{Binding GapSummary}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Grid view -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Grid}">
            <ItemsControl ItemsSource="{Binding FilesView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Width="200" Margin="0,0,12,12" ToolTip="{Binding GapSummary}">
                            <ui:CardControl.Icon>
                                <Border Width="48" Height="48" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Image Source="{Binding CoverThumbnail}" Stretch="UniformToFill"/>
                                </Border>
                            </ui:CardControl.Icon>
                            <StackPanel>
                                <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis"/>
                                <ui:TextBlock Text="{Binding Artist}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ui:TextBlock Text="{Binding GapSummary}" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <ui:TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" HorizontalAlignment="Right"
                              Visibility="{Binding IsScanning, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
        </Grid>
    </Grid>
</Page>
