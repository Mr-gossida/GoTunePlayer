                    <ui:CardControl Style="{StaticResource Card}" DataContext="{Binding Hud}" Icon="{ui:SymbolIcon Board24}"
                                    Tag="HUD 항상 위 오버레이 가사 스펙트럼 재생 버튼 떠 있는 창"
                                    ToolTip="어떤 프로그램을 쓰든 그 위에 작은 카드로 곡 정보, 가사, 스펙트럼과 재생 버튼을 띄웁니다. 끌어서 옮길 수 있고, 제목 표시줄의 HUD 버튼이나 단축키(HUD 전환)로도 켜고 끕니다.">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="HUD" FontTypography="Body"/>
                                <ui:TextBlock Text="다른 프로그램 위에 곡 정보 · 가사 · 스펙트럼 · 재생 버튼을 띄우기" Style="{StaticResource Desc}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
