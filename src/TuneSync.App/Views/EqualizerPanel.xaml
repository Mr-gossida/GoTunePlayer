<UserControl x:Class="TuneSync.App.Views.EqualizerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
             xmlns:views="clr-namespace:TuneSync.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EqualizerViewModel}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- The equalizer on the 플레이 page, in place of the lyrics: made for a wide (landscape) area.
         Presets run along the top as chips; the tone bars (balance-style, filling out from their middle) sit on the left; the band sliders on the
         right stand on the response curve, drawn on their own scale so each handle sits on it.
         In a narrow area the bars go under the bands; both fit the height there is (EqualizerPanel.ApplyLayout). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PlayerPanelBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Reading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- an on/off button: an outlined pill, filled with the accent while on -->
        <Style x:Key="OnOff" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="15" Background="Transparent" BorderThickness="1"
                                BorderBrush="{DynamicResource PlayerTrackBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerAccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PlayerAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PlayerOnAccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PlayerAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- the lamp in a switch: faint while idle, lit (Tag True) while at work -->
        <Style x:Key="Lamp" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- what a switch is doing, beside it: a fixed slot, digits of one width -->
        <Style x:Key="SwitchReading" TargetType="TextBlock">
            <Setter Property="Width" Value="62"/>
            <Setter Property="Margin" Value="8,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- a quiet text button that opens a card: no outline, a hover fill, the accent while open -->
        <Style x:Key="CardOpener" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="15" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="ui:Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- a preset chip: a rounded label, filled with the accent while chosen -->
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="15" Padding="14,6" Background="{DynamicResource PlayerPanelBrush}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <TextBlock x:Name="ChipText" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PlayerAccentBrush}"/>
                                <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource PlayerOnAccentBrush}"/>
                                <Setter TargetName="ChipText" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,12,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== title, switch, close (back to what was beside the cover) ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="DeviceEq24" FontSize="20" Foreground="{DynamicResource PlayerAccentBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="이퀄라이저" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" OnContent="켜짐" OffContent="꺼짐" Margin="18,0,0,0"
                             VerticalAlignment="Center" ToolTip="끄면 파일에 담긴 소리 그대로 재생합니다"/>

            <ui:Button Grid.Column="3" Content="닫기" Icon="{ui:SymbolIcon Dismiss24}" Margin="12,0,0,0" Padding="12,5" CornerRadius="16"
                       BorderThickness="0" Background="{DynamicResource PlayerHoverBrush}" MouseOverBackground="{DynamicResource PlayerTrackBrush}"
                       Command="{Binding ClosePanelCommand}" ToolTip="이퀄라이저 닫기 (Esc)" AutomationProperties.Name="이퀄라이저 닫기"/>
        </Grid>

        <!-- ===== presets as chips ("사용자 지정" leads while the bands match none) ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CustomChip" CornerRadius="15" Padding="14,6" Margin="0,0,6,0" Background="{DynamicResource PlayerAccentBrush}"
                    VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="사용자 지정" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PlayerOnAccentBrush}"/>
            </Border>
            <!-- more chips than fit: the strip fades at the side that goes on, with an arrow there
                 (EqualizerPanel.ShowChipArrows) -->
            <Grid Grid.Column="1">
            <ScrollViewer x:Name="ChipScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ChipScroller_PreviewMouseWheel" ScrollChanged="ChipScroller_ScrollChanged">
                <ListBox x:Name="PresetChips" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                         ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </ScrollViewer>
            <ui:Button x:Name="ChipsBack" Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon ChevronLeft24}" Margin="0"
                       Width="30" Height="30" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                       Background="{DynamicResource PlayerPanelBrush}" ToolTip="앞의 프리셋" Click="ChipsBack_Click"/>
            <ui:Button x:Name="ChipsOn" Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon ChevronRight24}" Margin="0"
                       Width="30" Height="30" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                       Background="{DynamicResource PlayerPanelBrush}" ToolTip="다음 프리셋" Click="ChipsOn_Click"/>
            </Grid>

            <!-- preset actions, at the end of the chips -->
            <StackPanel x:Name="PresetActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <ui:Button Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon Save24}" ToolTip="지금 설정을 프리셋으로 저장" Click="Save_Click"/>
                <ui:Button Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon Rename24}" ToolTip="프리셋 이름 바꾸기"
                           IsEnabled="{Binding CanEditPreset}" Click="Rename_Click"/>
                <ui:Button Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="프리셋 삭제"
                           IsEnabled="{Binding CanEditPreset}" Click="Delete_Click"/>
                <ui:Button Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon ArrowReset24}" ToolTip="모두 처음 상태로 (플랫)"
                           Command="{Binding ResetCommand}"/>
            </StackPanel>

            <!-- naming a preset (in place of the actions) -->
            <StackPanel x:Name="NameBar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <ui:TextBox x:Name="NameBox" Width="180" PlaceholderText="프리셋 이름" MaxLength="30" KeyDown="NameBox_KeyDown"/>
                <ui:Button x:Name="NameConfirm" Content="저장" Appearance="Primary" Margin="6,0,0,0" Click="NameConfirm_Click"/>
                <ui:Button Content="취소" Margin="6,0,0,0" Click="NameCancel_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== tone bars | bands (wide), or bands over the bars (narrow) =====
             Fitted to the height there is (EqualizerPanel.ApplyLayout); it scrolls only when even
             the most compact arrangement is too tall, the bands first. -->
        <ScrollViewer x:Name="BodyScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" SizeChanged="BodyScroller_SizeChanged">
        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="BottomRow" Height="0"/>
            </Grid.RowDefinitions>

            <Border x:Name="ToneSection" Grid.Row="0" Grid.Column="0" Style="{StaticResource Section}" Padding="20,16" Margin="0,0,12,0" Width="280">
                <DockPanel>
                <!-- what is coming out: at the very bottom of the card (the first thing docked to the bottom) -->
                <Border x:Name="MeterBlock" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PlayerTrackBrush}"
                        Padding="0,12,0,0" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="출력 레벨" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="dBFS" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                        <views:EqLevelMeter x:Name="Meter"
                                            ToolTip="스피커로 나가는 소리의 크기 (볼륨 적용 전). 채운 부분은 평균, 옅은 부분은 순간 최대, 눈금은 최근 최고점입니다."/>
                    </StackPanel>
                </Border>
                <!-- limiter, headroom, reverb: above the level meter. Stacked (one per row,
                     the reading beside each pill) where there's height, side by side where there
                     isn't (EqualizerPanel.ArrangeSwitches). A pill shows a lamp (lit while it is at
                     work) and its name only, so it never changes size; how many dB reads beside it
                     in a slot of its own width, so nothing moves when one is switched. -->
                <Border x:Name="SwitchBlock" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PlayerTrackBrush}"
                        Padding="0,8,0,0" Margin="0,8,0,0">
                    <UniformGrid x:Name="Switches" Columns="1">
                        <DockPanel Margin="0,3">
                            <ToggleButton x:Name="LimiterPill" Style="{StaticResource OnOff}" IsChecked="{Binding Limiter}" VerticalAlignment="Center"
                                          ToolTip="켜면 소리가 최대 크기를 넘으려 할 때 부드럽게 눌러 찌그러짐을 막습니다. 불이 켜져 있는 동안 옆의 수치만큼 음량을 낮추고 있습니다. 끄면 넘친 부분이 그대로 나가 찌그러질 수 있습니다.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LimiterLamp" Style="{StaticResource Lamp}"/>
                                    <TextBlock Text="리미터" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <TextBlock x:Name="LimiterReading" Style="{StaticResource SwitchReading}"/>
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <ToggleButton x:Name="HeadroomPill" Style="{StaticResource OnOff}" IsChecked="{Binding AutoHeadroom}" VerticalAlignment="Center"
                                          ToolTip="켜면 이퀄라이저로 올린 만큼 전체 음량을 미리 낮춰 리미터가 걸릴 일을 없앱니다(소리가 작아집니다). 불이 켜져 있는 동안 옆의 수치만큼 낮추고 있습니다. 끄면 음량은 그대로 둡니다.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Lamp}" Tag="{Binding IsHeadroomWorking}"/>
                                    <TextBlock Text="헤드룸" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <TextBlock x:Name="HeadroomReading" Style="{StaticResource SwitchReading}" Text="{Binding HeadroomText}"/>
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <ToggleButton x:Name="ReverbPill" Style="{StaticResource OnOff}" IsChecked="{Binding Reverb}" VerticalAlignment="Center"
                                          ToolTip="켜면 음악에 공간의 울림(잔향)을 더합니다. 옆 버튼에서 공간과 양을 고릅니다.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Lamp}" Tag="{Binding IsReverbWorking}"/>
                                    <TextBlock Text="잔향" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <!-- the room and amount; opens the reverb's card beside it -->
                            <ToggleButton x:Name="ReverbOpener" Style="{StaticResource CardOpener}" Margin="4,0,0,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" IsChecked="{Binding IsOpen, ElementName=ReverbCard}" ToolTip="잔향 공간·양·길이"
                                          AutomationProperties.Name="잔향 설정">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ReverbSummary" Text="{Binding ReverbSummary}" VerticalAlignment="Center" Margin="0,0,4,0"
                                               Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis"/>
                                    <ui:SymbolIcon Symbol="ChevronRight16" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                        </DockPanel>
                    </UniformGrid>
                </Border>
                <!-- the reverb's card, beside the button that opened it (EqualizerPanel.PlaceReverbCard) -->
            <Popup x:Name="ReverbCard" PlacementTarget="{Binding ElementName=ReverbOpener}" Placement="Custom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <!-- the margin leaves room for the shadow -->
                <Border Margin="12" Width="340" CornerRadius="12" Background="{DynamicResource PlayerTintBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource PlayerTrackBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                    <Border CornerRadius="12" Background="{DynamicResource PlayerVeilBrush}" Padding="18,14,18,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ConferenceRoom24" FontSize="18" Foreground="{DynamicResource PlayerAccentBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="잔향" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch IsChecked="{Binding Reverb}" OnContent="켜짐" OffContent="꺼짐" HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding ReverbRoomChoices}" SelectedItem="{Binding ReverbRoom}"
                                     ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="잔향 공간">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <views:EqBar Label="양" Minimum="0" Maximum="1" Rest="0" Step="0.01" Value="{Binding ReverbAmount}"
                                         Text="{Binding ReverbAmountText}" Margin="0,14,0,6"
                                         ToolTip="원래 소리에 더하는 울림의 양 (조금만 더해도 공간감이 생깁니다 · 더블클릭하면 0)"/>
                            <views:EqBar Label="길이" Minimum="0.5" Maximum="2" Rest="1" Step="0.05" Value="{Binding ReverbDecay}"
                                         Text="{Binding ReverbDecayText}" Margin="0,6"
                                         ToolTip="울림이 사라지는 데 걸리는 시간 (더블클릭하면 공간의 기본값)"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Popup>
                <UniformGrid x:Name="ToneBars" Columns="1" VerticalAlignment="Center">
                    <views:EqBar x:Name="BassBar" Label="저음" Value="{Binding Bass}" Text="{Binding BassText}" Margin="0,10"
                                 ToolTip="저음 전체를 올리거나 내립니다 (클릭·끌기 · 휠 · 더블클릭하면 0)"/>
                    <views:EqBar x:Name="TrebleBar" Label="고음" Value="{Binding Treble}" Text="{Binding TrebleText}" Margin="0,10"
                                 ToolTip="고음 전체를 올리거나 내립니다 (클릭·끌기 · 휠 · 더블클릭하면 0)"/>
                    <views:EqBar x:Name="WidthBar" Label="스테레오 폭" Minimum="0" Maximum="2" Rest="1" Step="0.05" Value="{Binding Width}"
                                 Text="{Binding WidthText}" Margin="0,10" ToolTip="좌우로 퍼진 정도: 왼쪽 끝은 모노, 가운데는 원래대로 (더블클릭)"/>
                    <views:EqBar x:Name="BalanceBar" Label="좌우 균형" Minimum="-1" Maximum="1" Step="0.05" Value="{Binding Balance}"
                                 Text="{Binding BalanceShortText}" Margin="0,10" ToolTip="왼쪽·오른쪽 음량의 균형 (더블클릭하면 가운데)"/>
                </UniformGrid>
                </DockPanel>
            </Border>

            <Border x:Name="BandSection" Grid.Row="0" Grid.Column="1" Style="{StaticResource Section}" Padding="10,12,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="104"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- preamp, set apart on the left -->
                    <TextBlock x:Name="PreampReading" Grid.Row="0" Grid.Column="0" Text="{Binding PreampText}" Style="{StaticResource Reading}" Margin="0,0,0,4"/>
                    <views:EqSlider Grid.Row="1" Grid.Column="0" Value="{Binding Preamp}" HorizontalAlignment="Center"
                                    ToolTip="프리앰프: 전체 음량 (끌기 · 휠 · 더블클릭하면 0)"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="프리앰프" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                    <Rectangle Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1" Margin="4,4,10,4" Fill="{DynamicResource PlayerTrackBrush}"/>

                    <!-- readings over the bands -->
                    <ItemsControl x:Name="BandReadings" Grid.Row="0" Grid.Column="2" ItemsSource="{Binding Bands}" Focusable="False" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                <TextBlock Text="{Binding GainText}" Style="{StaticResource Reading}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- the response curve, on the sliders' own scale: ±12 dB at their ends, inset by the handle's radius -->
                    <!-- the live spectrum, faint behind the curve -->
                    <views:EqSpectrum x:Name="Spectrum" Grid.Row="1" Grid.Column="2" Margin="0,7"/>
                    <!-- Kept as a picture (BitmapCache): the spectrum under it changes every frame, and
                         without the cache its dashed lines were worked out again each time. -->
                    <views:EqCurve Grid.Row="1" Grid.Column="2" Range="12" ThroughBands="True" Margin="0,7" Settings="{Binding Settings}"
                                   Version="{Binding CurveVersion}" IsActive="{Binding IsEnabled}">
                        <views:EqCurve.CacheMode>
                            <BitmapCache SnapsToDevicePixels="True"/>
                        </views:EqCurve.CacheMode>
                    </views:EqCurve>
                    <ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Bands}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                <views:EqSlider Value="{Binding Gain}" HorizontalAlignment="Center"
                                                ToolTip="끌거나 마우스 휠로 조절 · 더블클릭하면 0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Bands}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- ===== a note when this song can't be equalized (the switches live with the tone bars) ===== -->
        <StackPanel x:Name="BypassNotice" Grid.Row="3" Orientation="Horizontal" Margin="2,12,2,0" VerticalAlignment="Center" Visibility="Collapsed">
            <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource PlayerAccentBrush}"/>
            <TextBlock Text="이 곡은 Windows 기본 재생기로 재생되어 이퀄라이저가 적용되지 않습니다" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</UserControl>
