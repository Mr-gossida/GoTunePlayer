<Page x:Class="TuneSync.App.Views.RenameView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="폴더·파일명 규칙">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="이름 규칙" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="단일 곡 패턴:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SinglePatternBox" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="콜론( : ) 대체 문자:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="ColonReplacementBox" Margin="0,2,0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="앨범 트랙 패턴:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AlbumPatternBox" Margin="0,2,16,2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="기타 금지문자 대체:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="OtherReplacementBox" Margin="0,2,0,2"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="규칙 저장" Padding="10,4" Click="SaveRules_Click"/>
            <Button Content="규칙 기본값으로" Padding="10,4" Margin="8,0,0,0" Click="ResetRules_Click"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="대상 폴더:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="FolderBox" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="찾아보기..." Margin="6,0,0,0" Click="Browse_Click"/>
            <CheckBox Grid.Column="3" x:Name="IsAlbumCheck" Content="앨범 폴더(트랙 번호 포함)" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button Grid.Column="4" Content="미리보기" Margin="12,0,0,0" Click="Preview_Click"/>
            <Button Grid.Column="5" Content="적용" Margin="8,0,0,0" Click="Apply_Click"/>
        </Grid>

        <DataGrid Grid.Row="3" x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="기존 파일명" Binding="{Binding OldName}" Width="2*"/>
                <DataGridTextColumn Header="새 파일명" Binding="{Binding NewName}" Width="2*"/>
                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
