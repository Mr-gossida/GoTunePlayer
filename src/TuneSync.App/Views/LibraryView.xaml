<Page x:Class="TuneSync.App.Views.LibraryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:views="clr-namespace:TuneSync.App.Views"
      xmlns:conv="clr-namespace:TuneSync.App.Converters"
      xmlns:app="clr-namespace:TuneSync.App"
      d:DataContext="{d:DesignInstance Type=vm:LibraryPageViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="태그 관리"
      PreviewKeyDown="Page_PreviewKeyDown"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Foreground: see PlayView.xaml. -->
    <Page.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <views:TagEditorParts/>
        </ResourceDictionary.MergedDictionaries>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <conv:EmptyDashConverter x:Key="EmptyDashConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- 저장 전 검토's lyrics comparison: the file's lyrics now and after saving, side by side,
             with the lines that differ tinted (LyricsDiff ignores LRC times). Used in the review
             list and, larger, in its own window (CompareScroll / CompareWideVisibility differ there). -->
        <Style x:Key="CompareScroll" TargetType="ScrollViewer">
            <Setter Property="MaxHeight" Value="260"/>
        </Style>
        <Visibility x:Key="CompareWideVisibility">Visible</Visibility>
        <DataTemplate x:Key="LyricsCompareTemplate" DataType="{x:Type vm:ReviewFileViewModel}">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="넓게 보기" Icon="{ui:SymbolIcon ArrowExpand24}" Appearance="Transparent"
                               Padding="8,2" FontSize="12" Click="CompareWide_Click" Visibility="{DynamicResource CompareWideVisibility}"/>
                    <ui:ProgressRing IsIndeterminate="True" Width="12" Height="12" Margin="0,0,6,0"
                                     Visibility="{Binding IsCompareLoading, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                    <TextBlock Text="{Binding CompareSummary}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="6" Padding="4,6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="교체 전" FontSize="11" Margin="6,0,0,4" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ScrollViewer Style="{DynamicResource CompareScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding BeforeLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,1" CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="6" Padding="4,6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="교체 후" FontSize="11" Margin="6,0,0,4" Foreground="{DynamicResource TagChangeBrush}"/>
                            <ScrollViewer Style="{DynamicResource CompareScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AfterLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,1" CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>


        <!-- List columns preview unsaved values in accent italics -->
        <Style x:Key="PendingTitleText" TargetType="TextBlock" BasedOn="{StaticResource GridTrimmedText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTitlePending}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TagChangeBrush}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PendingArtistText" TargetType="TextBlock" BasedOn="{StaticResource GridTrimmedText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsArtistPending}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TagChangeBrush}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PendingAlbumText" TargetType="TextBlock" BasedOn="{StaticResource GridTrimmedText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlbumPending}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TagChangeBrush}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PageRoot" Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters + view toggle -->
        <Grid Grid.Row="0" Margin="0,0,0,12" DataContext="{Binding Library}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" DataContext="{Binding Filter}">
                <ui:TextBlock Text="누락만 보기:" VerticalAlignment="Center" Margin="0,0,8,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ToggleButton Content="커버 없음" IsChecked="{Binding ShowMissingCoverOnly}" Margin="0,0,6,0"/>
                <ToggleButton Content="태그 없음" IsChecked="{Binding ShowMissingTagsOnly}" Margin="0,0,6,0"/>
                <ToggleButton Content="가사 없음" IsChecked="{Binding ShowMissingLyricsOnly}"/>
                <Rectangle Width="1" Height="20" Margin="14,0" VerticalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                <ui:TextBlock Text="가사 종류:" VerticalAlignment="Center" Margin="0,0,8,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ToggleButton Content="일반 가사" IsChecked="{Binding ShowPlainLyricsOnly}" Margin="0,0,6,0"
                              ToolTip="시간이 없는 가사가 있는 곡만"/>
                <ToggleButton Content="싱크 가사" IsChecked="{Binding ShowSyncedLyricsOnly}"
                              ToolTip="줄마다 시간이 있는 가사(LRC)가 있는 곡만"/>
            </WrapPanel>

            <!-- Opened from the queue's "태그 편집": only those songs, until "전체 보기". -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="12,6,6,6" CornerRadius="6"
                    Background="{DynamicResource TagChangeBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource TagChangeBrush}"
                    Visibility="{Binding HasScope, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="전체 라이브러리 보기" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                               Padding="10,4" Command="{Binding ClearScopeCommand}"/>
                    <ui:SymbolIcon Symbol="Filter24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TagChangeBrush}"/>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                        <Run Text="{Binding ScopeLabel, Mode=OneWay}"/><Run Text="만 보는 중" FontWeight="Normal"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton GroupName="ViewModeGroup" Content="목록" Margin="0,0,16,0" MinWidth="0" VerticalAlignment="Center"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=List}"/>
                <RadioButton GroupName="ViewModeGroup" Content="그리드" MinWidth="0" VerticalAlignment="Center"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Grid}"/>
            </StackPanel>
        </Grid>

        <!-- File browser | task panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400" MinWidth="330" MaxWidth="600"/>
            </Grid.ColumnDefinitions>

            <!-- List view -->
            <DataGrid x:Name="FileListGrid" Grid.Column="0" ItemsSource="{Binding Library.FilesView}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Disabled" CanUserResizeColumns="True" CanUserSortColumns="True"
                      HeadersVisibility="Column" CellStyle="{StaticResource GridCellStyle}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      SelectedItem="{Binding SelectedFile}"
                      SelectionChanged="FileSelectionChanged"
                      MouseDoubleClick="FileListGrid_MouseDoubleClick" KeyDown="FileListGrid_KeyDown"
                      Visibility="{Binding Library.ViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=List}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="16" MinWidth="16" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="7" Height="7" HorizontalAlignment="Center" Fill="{DynamicResource TagChangeBrush}"
                                         ToolTip="저장하지 않은 변경이 있습니다"
                                         Visibility="{Binding HasPendingChanges, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="파일" Width="2*" MinWidth="120" SortMemberPath="FileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="아티스트" Binding="{Binding ShownArtist}" SortMemberPath="Artist" Width="1.1*" MinWidth="70" ElementStyle="{StaticResource PendingArtistText}"/>
                    <DataGridTextColumn Header="제목" Binding="{Binding ShownTitle}" SortMemberPath="Title" Width="1.6*" MinWidth="90" ElementStyle="{StaticResource PendingTitleText}"/>
                    <DataGridTextColumn Header="앨범" Binding="{Binding ShownAlbum}" SortMemberPath="Album" Width="1.3*" MinWidth="70" ElementStyle="{StaticResource PendingAlbumText}"/>
                    <DataGridTextColumn Header="길이" Binding="{Binding DurationText}" Width="72" MinWidth="72" SortMemberPath="Duration"
                                        ElementStyle="{StaticResource GridSecondaryText}"/>
                    <DataGridTemplateColumn Header="커버" Width="50" MinWidth="50" SortMemberPath="HasCover">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:SymbolIcon HorizontalAlignment="Center" FontSize="16">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Checkmark24"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            <Setter Property="ToolTip" Value="커버 있음"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCover}" Value="False">
                                                    <Setter Property="Symbol" Value="Dismiss24"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                    <Setter Property="ToolTip" Value="커버 없음"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="가사" Width="58" MinWidth="58" SortMemberPath="LyricsMark">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LyricsMark}" HorizontalAlignment="Center" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LyricsMark}" Value="싱크">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LyricsMark}" Value="없음">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="누락 태그" Width="1*" MinWidth="64" SortMemberPath="MissingTagsText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MissingTagsText}" TextTrimming="CharacterEllipsis" FontSize="12"
                                           ToolTip="{Binding GapSummary}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Grid view -->
            <ListBox x:Name="FileTileList" Grid.Column="0" ItemsSource="{Binding Library.FilesView}" SelectionMode="Extended"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectedItem="{Binding SelectedFile}"
                     SelectionChanged="FileSelectionChanged"
                     MouseDoubleClick="FileTileList_MouseDoubleClick"
                     Visibility="{Binding Library.ViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Grid}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ui:VirtualizingWrapPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="150" Margin="4" ToolTip="{Binding GapSummary}">
                            <Grid Width="150" Height="150">
                                <Border CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </Border>
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CoverThumbnail}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Ellipse Width="10" Height="10" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Fill="{DynamicResource TagChangeBrush}" Stroke="White" StrokeThickness="1.5"
                                         ToolTip="저장하지 않은 변경이 있습니다"
                                         Visibility="{Binding HasPendingChanges, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            </Grid>
                            <ui:TextBlock Text="{Binding DisplayTitle}" FontTypography="BodyStrong" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                            <ui:TextBlock Text="{Binding Artist}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <ui:TextBlock Text="{Binding GapSummary}" FontSize="11"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ui:TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}" IsHitTestVisible="False"
                          Text="하단의 + 버튼으로 폴더나 음악 파일을 추가하세요."
                          Visibility="{Binding Library.HasNoFiles, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- Editor panel: header, tabs (태그 / 커버 / 가사 / 자동 채움), save bar. Edits wait on
                 each song until saved; the list previews them. -->
            <Grid x:Name="EditorPanel" Grid.Column="2" Margin="8,0,0,0" DataContext="{Binding Editor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header. One song: its cover, title, artist · album, format. Several: the 일괄 편집
                     banner (tinted), and the songs it changes behind "곡 목록". -->
                <Border Grid.Row="0" Margin="0,0,0,14" CornerRadius="8" BorderThickness="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMulti}" Value="True">
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Background" Value="{DynamicResource TagChangeBackgroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                <Grid MinHeight="60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- One song: its cover -->
                    <Grid Width="76" Height="76" Margin="0,0,14,0"
                          Visibility="{Binding IsSingle, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                        <Border CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="24" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Border>
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding HeaderCover}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <!-- Several songs: a little stack of their covers -->
                    <Grid Width="60" Height="60" Margin="0,0,12,0"
                          Visibility="{Binding IsMulti, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                        <Border CornerRadius="6" Margin="12,0,0,12" Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        <Border CornerRadius="6" Margin="6,6,6,6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        <Border CornerRadius="6" Margin="0,12,12,0" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Border>
                        <Border CornerRadius="6" Margin="0,12,12,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding HeaderCovers[0]}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <!-- Nothing selected -->
                    <Border Width="60" Height="60" Margin="0,0,12,0" CornerRadius="30" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                        <ui:SymbolIcon Symbol="TagMultiple24" FontSize="24" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <!-- one song: the roomier one-song editor (SongEditorView) -->
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowExpand24}" Appearance="Transparent" Padding="5" Margin="6,-4,0,-4"
                                       ToolTip="큰 창으로 편집 (목록의 곡을 ‹ ›로 넘기며 고칠 수 있습니다)" Click="OpenSongEditor_Click"
                                       Visibility="{Binding IsSingle, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding HeaderTitle}" ToolTip="{Binding HeaderTitle}"/>
                        </DockPanel>
                        <TextBlock FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding HeaderDetail}" ToolTip="{Binding HeaderDetail}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsSingle, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                        <TextBlock FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="{Binding HeaderSubtitle}" ToolTip="{Binding HeaderSubtitle}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="곡을 선택하세요"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                        <TextBlock FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Ctrl·Shift로 여러 곡을 고르면 한 번에 고칠 수 있습니다."
                                   Visibility="{Binding IsEmpty, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                    </StackPanel>
                </Grid>
                <!-- 일괄 편집: which songs it changes -->
                <Expander Margin="0,8,0,0" Padding="0,4,0,0" Background="Transparent" BorderThickness="0"
                          Visibility="{Binding IsMulti, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <Expander.Header>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="곡 목록"/><Run Text=" ("/><Run Text="{Binding Count, Mode=OneWay}"/><Run Text="곡)"/>
                        </TextBlock>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Selection}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" Margin="0,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}">
                                        <Run Text="{Binding DisplayTitle, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Artist, Mode=OneWay}"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
                </StackPanel>
                </Border>

                <!-- Tabs -->
                <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="EditorTabs" Style="{StaticResource PanelTab}" Content="태그"
                                     IsChecked="{Binding Tab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Tags}"/>
                        <RadioButton GroupName="EditorTabs" Style="{StaticResource PanelTab}" Content="커버" Tag="{Binding IsCoverPending}"
                                     IsChecked="{Binding Tab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Cover}"/>
                        <RadioButton GroupName="EditorTabs" Style="{StaticResource PanelTab}" Content="가사" Tag="{Binding IsLyricsPending}"
                                     IsChecked="{Binding Tab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Lyrics}"/>
                        <RadioButton GroupName="EditorTabs" Style="{StaticResource PanelTab}" Content="통합 검색"
                                     IsChecked="{Binding Tab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=AutoFill}"/>
                    </StackPanel>
                </Border>

                <!-- ===== 태그 ===== -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Visibility="{Binding Tab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Tags}">
                    <Grid Margin="0,0,14,8">
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <!-- Online lookup: the sources it asks (chips), then what each found, as cards; the
                                 best goes into the fields as unsaved edits (blue, with the old value), and another
                                 card is one click away. -->
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,110,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="제목·아티스트로 아래 출처에서 찾아, 가장 잘 맞는 결과를 넣습니다"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMulti}" Value="True">
                                                            <Setter Property="Text" Value="곡마다 아래 출처에서 찾아, 확실히 맞는 결과만 넣습니다"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ui:Button HorizontalAlignment="Right" Content="태그 찾기" Icon="{ui:SymbolIcon Search24}" Padding="10,4"
                                                   Command="{Binding SearchTagsCommand}"
                                                   ToolTip="찾은 값은 저장 전 변경으로 들어갑니다. 칸마다 되돌릴 수 있고, 저장하기 전까지 파일은 그대로입니다"/>
                                    </Grid>
                                    <!-- the sources, switched on and off here or in 설정 › 도구 -->
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="출처" FontSize="12" Margin="0,4,10,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Sources.TagSources}" ItemTemplate="{StaticResource SourceChipTemplate}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DockPanel>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchStatusTemplate}" Focusable="False" Margin="0,6,0,0"/>
                                    <!-- several songs: every result of every song, with its source, is in 통합 검색 -->
                                    <ui:Button Content="곡마다 결과를 보고 고르기" Icon="{ui:SymbolIcon TaskListSquareLtr24}" Appearance="Transparent"
                                               Padding="8,3" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Left" Command="{Binding OpenAutoFillCommand}"
                                               ToolTip="통합 검색 탭에서 곡마다 찾은 결과를 출처와 함께 보고, 다른 결과로 바꿔 넣을 수 있습니다"
                                               Visibility="{Binding IsMulti, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                    <!-- what was found: the card in use (checked), or all of them to choose from -->
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasTagCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                        <DockPanel Margin="0,0,0,4">
                                            <ui:Button DockPanel.Dock="Right" Content="{Binding MoreTagCandidatesText}" Appearance="Transparent" Padding="8,2" FontSize="12"
                                                       Command="{Binding ToggleMoreTagCandidatesCommand}"
                                                       ToolTip="찾은 결과를 일치율 순으로 모두 보여 줍니다"
                                                       Visibility="{Binding HasMoreTagCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                            <TextBlock Text="{Binding TagCandidatesHeader}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding TagCandidates}" ItemTemplate="{StaticResource TagCandidateTemplate}" Focusable="False"/>
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Right" Content="원래 태그로" Icon="{ui:SymbolIcon ArrowUndo16}" Appearance="Transparent"
                                                       Padding="8,2" FontSize="12" Margin="6,0,0,0" Command="{Binding UndoTagCandidateCommand}"
                                                       ToolTip="찾은 결과로 바뀐 칸을 원래 값으로 되돌립니다 (직접 고친 칸은 그대로)"
                                                       Visibility="{Binding IsTagCandidateApplied, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                            <TextBlock Text="카드를 누르면 그 값으로 바뀝니다. 저장하기 전까지 파일은 그대로입니다." FontSize="11" TextWrapping="Wrap"
                                                       app:KeepWords.IsEnabled="True" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource EditorSection}" Text="기본 정보" Margin="0,0,0,4"/>
                            <ContentControl Content="{Binding TitleField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            <ContentControl Content="{Binding ArtistField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            <ContentControl Content="{Binding AlbumField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>

                            <TextBlock Style="{StaticResource EditorSection}" Text="세부 정보"/>
                            <ContentControl Content="{Binding AlbumArtistField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding YearField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                                <ContentControl Grid.Column="2" Content="{Binding GenreField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding TrackField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                                <ContentControl Grid.Column="2" Content="{Binding DiscField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>
                            </Grid>
                            <ui:Button Content="목록 순서대로 트랙 번호 매기기" Icon="{ui:SymbolIcon TextNumberListLtr24}" Command="{Binding NumberTracksCommand}"
                                       Appearance="Transparent" Padding="10,5" Margin="4,0,0,6" FontSize="12"
                                       ToolTip="선택한 곡에 지금 목록에 보이는 순서대로 1, 2, 3… 번호를 붙입니다."
                                       Visibility="{Binding IsMulti, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            <ContentControl Content="{Binding ComposerField}" ContentTemplate="{StaticResource TagFieldTemplate}" Focusable="False"/>

                            <Expander Margin="0,14,0,0" Padding="12,4,12,10"
                                      Visibility="{Binding IsSingle, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                <Expander.Header>
                                    <TextBlock Text="파일 정보" FontSize="13"/>
                                </Expander.Header>
                                <Grid>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Margin" Value="0,3"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="형식" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileFormat}" ToolTip="{Binding FileFormat}"/>
                                    <TextBlock Grid.Row="1" Text="크기" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSize, Converter={StaticResource EmptyDashConverter}}"/>
                                    <TextBlock Grid.Row="2" Text="위치" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileLocation}" ToolTip="{Binding FileLocation}"/>
                                    <TextBlock Grid.Row="3" Text="경로" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FilePath}" ToolTip="{Binding FilePath}" TextWrapping="Wrap"
                                               TextTrimming="None" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Expander>
                        </StackPanel>

                        <StackPanel Style="{StaticResource EditorEmpty}"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <ui:SymbolIcon Symbol="Tag24" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="목록에서 곡을 선택하면 태그를 바로 고칠 수 있습니다." Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="고친 칸은 강조 표시되고, 저장하기 전까지 목록에 미리 보입니다." Margin="0,4,0,0" FontSize="12" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ===== 커버 ===== -->
                <ScrollViewer x:Name="CoverScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              ScrollChanged="CoverScroll_ScrollChanged"
                              Visibility="{Binding Tab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Cover}">
                    <Grid Margin="0,0,14,8">
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <!-- Drop zone: the cover itself (drag an image file onto it) -->
                            <Border x:Name="CoverDropZone" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Cursor="Hand" ToolTip="클릭하면 크게 봅니다" MouseLeftButtonUp="EditorCover_Click"
                                    BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                    AllowDrop="True" DragEnter="CoverDrop_DragOver" DragOver="CoverDrop_DragOver" DragLeave="CoverDrop_DragLeave" Drop="CoverDrop_Drop">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="MaxHeight" Value="340"/>
                                        <Style.Triggers>
                                            <!-- smaller while search results are shown, so the gallery is in view without scrolling -->
                                            <DataTrigger Binding="{Binding HasCoverCandidates}" Value="True">
                                                <Setter Property="MaxHeight" Value="240"/>
                                                <Setter Property="MaxWidth" Value="240"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding ShowCoverPlaceholder, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                        <ui:SymbolIcon Symbol="ImageAdd24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock Text="이미지를 여기로 끌어다 놓으세요" Margin="0,8,0,0" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <!-- one cover (or the pending new one) -->
                                    <Border CornerRadius="7" ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <!-- several songs: their different covers -->
                                    <ItemsControl ItemsSource="{Binding CoverTiles}" Margin="8" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Margin="4" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- the search's best match is the one shown -->
                                    <Border CornerRadius="5" Padding="7,2,8,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False"
                                            Visibility="{Binding IsRecommendedCoverShown, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Star16" Filled="True" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                            <TextBlock Text="추천 커버" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="CoverDropHighlight" CornerRadius="7" BorderThickness="2" Visibility="Collapsed"
                                            BorderBrush="{DynamicResource TagChangeBrush}" Background="#33000000">
                                        <TextBlock Text="놓으면 커버로 사용합니다" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{DynamicResource TagChangeBrush}"
                                        Visibility="{Binding IsCoverPending, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                    <TextBlock Text="저장 전" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TagChangeOnBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding CoverInfo}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <!-- which album the chosen online cover belongs to -->
                            <TextBlock Text="{Binding CoverCandidateDetail}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CoverCandidateDetail}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoverCandidateDetail}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button Content="커버 찾기" Icon="{ui:SymbolIcon Search24}" Command="{Binding SearchCoverCommand}" Margin="0,0,6,6"
                                           ToolTip="온라인에서 앨범 커버를 찾아 저장 전 변경으로 넣습니다"/>
                                <ui:Button Content="이미지 선택…" Icon="{ui:SymbolIcon Image24}" Command="{Binding PickCoverCommand}" Margin="0,0,6,6"/>
                                <ui:Button Content="붙여넣기" Icon="{ui:SymbolIcon ClipboardPaste24}" Command="{Binding PasteCoverCommand}" Margin="0,0,6,6"
                                           ToolTip="복사한 이미지나 이미지 파일을 커버로 사용합니다"/>
                                <ui:Button Content="지우기" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCoverCommand}" Margin="0,0,6,6"
                                           Appearance="Transparent"/>
                                <ui:Button Content="되돌리기" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding RevertCoverCommand}" Margin="0,0,6,6"
                                           Appearance="Transparent"
                                           Visibility="{Binding IsCoverPending, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            </WrapPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchStatusTemplate}" Focusable="False" Margin="0,6,0,0"/>
                            <TextBlock Text="여러 곡을 선택한 상태에서 바꾸면 모두 같은 커버가 됩니다." FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding IsMulti, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>

                            <!-- 커버 찾기 results: the song's own cover, the recommendation, then the other matches -->
                            <StackPanel Visibility="{Binding HasCoverCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="일치율 순" FontSize="11" Margin="0,16,0,4" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding CoverCandidatesHeader}" Style="{StaticResource EditorSection}"/>
                                </DockPanel>
                                <ItemsControl x:Name="CoverCandidateList" ItemsSource="{Binding CoverCandidates}" Margin="-4,0" Focusable="False"
                                              ItemTemplate="{StaticResource CoverCandidateTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                </ItemsControl>
                                <TextBlock Text="썸네일을 누르면 그 커버로 바뀝니다. 저장하기 전까지 파일은 그대로입니다." FontSize="11" Margin="0,2,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource EditorEmpty}"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <ui:SymbolIcon Symbol="Image24" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="곡을 선택하면 커버를 바꾸거나 지울 수 있습니다." Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ===== 가사 ===== -->
                <Grid Grid.Row="2" Margin="0,0,14,8"
                      Visibility="{Binding Tab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Lyrics}">
                    <Grid Visibility="{Binding IsSingle, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- The lyrics' state on its own line, the actions under it: side by side they ran
                             into each other in a narrow panel. -->
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                                                 Visibility="{Binding IsLyricsLoading, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                <TextBlock Text="{Binding LyricsInfo}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding LyricsInfo}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal">
                                <ui:Button Content="가사 찾기" Icon="{ui:SymbolIcon Search24}" Padding="10,4" FontSize="12" Margin="0,0,4,0"
                                           Command="{Binding SearchLyricsCommand}"
                                           ToolTip="아래 출처에서 이 곡(길이·앨범까지 맞는 버전)의 가사를 찾아, 가장 잘 맞는 것을 넣습니다. 싱크 가사를 우선합니다"/>
                                <ui:Button Content="싱크 가사 만들기" Icon="{ui:SymbolIcon Sparkle24}" Padding="10,4" FontSize="12" Margin="0,0,4,0"
                                           Command="{Binding MakeSyncedCommand}"
                                           ToolTip="음성 인식으로 각 줄의 시간을 자동으로 맞추고, 들어보며 고칠 수 있습니다"
                                           Visibility="{Binding CanMakeSynced, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                <ui:Button Content="싱크 편집" Icon="{ui:SymbolIcon Edit24}" Padding="10,4" FontSize="12" Margin="0,0,4,0"
                                           Command="{Binding MakeSyncedCommand}"
                                           ToolTip="싱크 가사의 시간을 들어보며 고칩니다 (자동으로 다시 맞출 수도 있습니다)"
                                           Visibility="{Binding CanEditSynced, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                <ui:Button Content="되돌리기" Icon="{ui:SymbolIcon ArrowUndo16}" Appearance="Transparent"
                                           Padding="8,3" FontSize="12" Command="{Binding RevertLyricsCommand}"
                                           Visibility="{Binding IsLyricsPending, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            </WrapPanel>
                        </StackPanel>
                        <!-- where 가사 찾기 looks, what it said, and what it found (as cards; the one in
                             the box below is checked) - kept short so the lyrics keep their room -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="출처" FontSize="12" Margin="0,4,10,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding Sources.LyricsSources}" ItemTemplate="{StaticResource SourceChipTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </DockPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchStatusTemplate}" Focusable="False" VerticalAlignment="Top"/>
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasLyricsCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                <DockPanel Margin="0,0,0,4">
                                    <ui:Button DockPanel.Dock="Right" Content="{Binding MoreLyricsCandidatesText}" Appearance="Transparent" Padding="8,2" FontSize="12"
                                               Command="{Binding ToggleMoreLyricsCandidatesCommand}"
                                               ToolTip="찾은 가사를 모두 보여 줍니다. 카드 위에 마우스를 올리면 가사를 더 볼 수 있습니다"
                                               Visibility="{Binding HasMoreLyricsCandidates, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                    <TextBlock Text="{Binding LyricsCandidatesHeader}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding LyricsCandidates}" ItemTemplate="{StaticResource LyricsCandidateTemplate}" Focusable="False"/>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                        <ui:TextBox Grid.Row="2" Text="{Binding LyricsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False"
                                    TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="13"
                                    PlaceholderText="가사를 입력하거나 붙여넣으세요" ClearButtonEnabled="False"
                                    IsEnabled="{Binding IsLyricsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                        <TextBlock Grid.Row="3" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="[01:23.45] 처럼 시간이 붙은 줄이 있으면 싱크 가사로 재생됩니다. 모두 지우고 저장하면 가사가 삭제됩니다."/>
                    </Grid>
                    <StackPanel Style="{StaticResource EditorEmpty}"
                                Visibility="{Binding IsSingle, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=False}">
                        <ui:SymbolIcon Symbol="TextQuote24" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="가사 내용은 한 곡씩 편집할 수 있습니다." Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding LyricsInfo}" Margin="0,4,0,0" FontSize="12" TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <!-- several songs: find their lyrics, or time the lyrics they have (one batch) -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0"
                                    Visibility="{Binding IsMulti, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <ItemsControl ItemsSource="{Binding Sources.LyricsSources}" ItemTemplate="{StaticResource SourceChipTemplate}" Focusable="False"
                                          HorizontalAlignment="Center" Margin="6,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ui:Button Content="선택한 곡 가사 찾기" Icon="{ui:SymbolIcon Search24}" HorizontalAlignment="Stretch"
                                       Command="{Binding SearchLyricsCommand}"
                                       ToolTip="선택한 곡마다 켜 둔 출처(LRCLIB·곡 옆 가사 파일)에서 이 곡의 가사가 확실한 것만 저장 전 변경으로 넣습니다. 출처는 설정 › 도구 › 온라인 검색에서 고릅니다"/>
                            <ui:Button Content="곡마다 결과를 보고 고르기" Icon="{ui:SymbolIcon TaskListSquareLtr24}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                       Appearance="Transparent" Command="{Binding OpenAutoFillCommand}"
                                       ToolTip="통합 검색 탭에서 곡마다 찾은 가사를 출처와 함께 보고, 다른 가사로 바꿔 넣을 수 있습니다"/>
                            <ui:Button Content="선택한 곡 싱크 가사 만들기" Icon="{ui:SymbolIcon Sparkle24}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                       Command="{Binding BatchSyncCommand}"
                                       Visibility="{Binding CanBatchSync, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"
                                       ToolTip="일반 가사가 있는 곡마다 음성 인식으로 줄의 시간을 맞춰 바로 저장합니다. 시작하기 전에 예상 시간을 알려 드립니다."/>
                        </StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchStatusTemplate}" Focusable="False" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ===== 통합 검색 (several songs at once; results go in as unsaved edits) ===== -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Visibility="{Binding Tab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AutoFill}">
                    <StackPanel Margin="0,0,14,8" DataContext="{Binding DataContext.AutoMatch, ElementName=PageRoot}">
                        <TextBlock Text="{Binding TargetDescription}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Style="{StaticResource EditorSection}" Text="찾을 항목" Margin="0,0,0,4"/>
                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox Content="태그" MinWidth="0" Margin="0,0,16,0" IsChecked="{Binding FillTags}"
                                      ToolTip="비어 있는 태그(제목·아티스트·앨범·연도·장르·트랙 등)만 채웁니다. 기존 값은 바꾸지 않습니다."/>
                            <CheckBox Content="앨범 커버" MinWidth="0" Margin="0,0,16,0" IsChecked="{Binding FillCover}"
                                      ToolTip="MusicBrainz(Cover Art Archive)·iTunes·Deezer에서 찾습니다. 이미 커버가 있는 곡을 선택해 체크하면 새 커버를 찾아 교체 후보로 보여줍니다."/>
                            <CheckBox Content="가사" MinWidth="0" IsChecked="{Binding FillLyrics}"
                                      ToolTip="이미 가사가 있는 곡을 선택해 체크하면 새 가사를 찾아 교체 후보로 보여줍니다."/>
                        </WrapPanel>
                        <!-- where tags and lyrics are looked for: the same switches as the tag editor's chips -->
                        <DockPanel Margin="0,0,0,2" Visibility="{Binding FillTags, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <TextBlock Text="태그 출처" Width="58" FontSize="12" Margin="0,4,0,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding Sources.TagSources}" ItemTemplate="{StaticResource SourceChipTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,2" Visibility="{Binding FillLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                            <TextBlock Text="가사 출처" Width="58" FontSize="12" Margin="0,4,0,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding Sources.LyricsSources}" ItemTemplate="{StaticResource SourceChipTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                        <Border Height="8"/>

                        <ui:ToggleSwitch Content="찾은 결과 바로 넣기" IsChecked="{Binding IsAutomaticMode}" OffContent="결과를 보고 골라 넣기" Margin="0,0,0,10"
                                         ToolTip="어느 쪽이든 결과는 저장 전 변경으로 들어가며, 아래 저장 바에서 확인하고 저장합니다"/>
                        <WrapPanel Margin="0,0,0,8">
                            <ui:Button Content="검색" Icon="{ui:SymbolIcon Search24}" Command="{Binding RunCommand}" Margin="0,0,8,4" Appearance="Primary"/>
                            <ui:Button Content="취소" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding RunCancelCommand}" Margin="0,0,8,4"
                                       Visibility="{Binding IsRunning, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            <ui:Button Content="편집에 넣기" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding ApplySelectedCommand}" Margin="0,0,0,4"
                                       ToolTip="체크한 항목을 저장 전 변경으로 넣습니다 (저장은 아래 저장 바에서)"
                                       Visibility="{Binding HasResults, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                        </WrapPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Top"
                                             Visibility="{Binding IsRunning, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" app:KeepWords.IsEnabled="True"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <!-- where the answers came from: "태그: MusicBrainz 8곡 · iTunes 2곡" -->
                                <TextBlock Text="{Binding SourceSummary}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="16"
                                           ToolTip="곡마다 넣은 결과를 가져온 곳입니다. 결과 카드에서 출처와 다른 결과를 볼 수 있습니다."
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SourceSummary}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Results, a card per song: what changes (before → after, ticked one by one), where
                             each part is from, and the other results found - a click swaps to one (in the
                             editor already, the unsaved edits follow). Songs whose result is in the editor
                             are marked, with 빼기 to take it back out. -->
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <StackPanel>
                                            <!-- the song: ticked for 편집에 넣기, or marked as in the editor -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Pick" MinWidth="0" Margin="0,0,6,0" VerticalAlignment="Top"
                                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding HasProposal}" ToolTip="체크하면 '편집에 넣기'로 이 곡의 결과를 넣습니다"/>
                                                <ui:SymbolIcon x:Name="InMark" Symbol="CheckmarkCircle20" Filled="True" FontSize="18" Margin="2,1,8,0"
                                                               VerticalAlignment="Top" Visibility="Collapsed" ToolTip="이 곡의 결과가 편집에 들어가 있습니다 (저장 전)"
                                                               Foreground="{DynamicResource TagChangeBrush}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" ToolTip="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="SummaryText" Text="{Binding Summary}" FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap"
                                                               app:KeepWords.IsEnabled="True" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" Content="빼기" Icon="{ui:SymbolIcon ArrowUndo16}" Appearance="Transparent"
                                                           Padding="8,2" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Top" Command="{Binding UnstageCommand}"
                                                           ToolTip="이 곡에 넣은 변경을 편집에서 뺍니다 (직접 고친 칸은 그대로)"
                                                           Visibility="{Binding IsStaged, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                            </Grid>

                                            <!-- tags: where from and how well they fit; each change; the other results -->
                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding HasTagSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                                <DockPanel>
                                                    <ui:Button DockPanel.Dock="Right" Content="{Binding MoreTagsText}" Appearance="Transparent" Padding="8,1" FontSize="12"
                                                               Command="{Binding ToggleMoreTagsCommand}" ToolTip="이 곡에서 찾은 태그 결과를 일치율 순으로 보여 줍니다"
                                                               Visibility="{Binding HasMoreTags, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="태그" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Border Style="{StaticResource SourceBadge}" ToolTip="이 태그를 가져온 곳"
                                                                Visibility="{Binding HasTagSource, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                                            <TextBlock Text="{Binding TagSource}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding TagScore}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   ToolTip="이 곡과 맞는 정도: 제목·아티스트가 가장 크게, 앨범·길이가 그다음으로 반영됩니다"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock x:Name="TagNoteText" Text="{Binding TagNote}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           app:KeepWords.IsEnabled="True" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding HasTagNote, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                                <ItemsControl ItemsSource="{Binding TagChangeRows}" Margin="0,4,0,0" IsEnabled="{Binding IsSelected}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="78"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox x:Name="RowCheck" MinWidth="0" Padding="0" Margin="0,0,6,0" VerticalAlignment="Top" IsChecked="{Binding IsChecked}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" Margin="0,4,0,0"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <StackPanel Grid.Column="2" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding Before}" FontSize="11" TextDecorations="Strikethrough" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                    <TextBlock Text="{Binding After}" FontSize="12" TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource TagChangeBrush}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <!-- in the editor already: nothing left to tick -->
                                                                <DataTrigger Binding="{Binding DataContext.IsStaged, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                    <Setter TargetName="RowCheck" Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding TagCandidates}" ItemTemplate="{StaticResource TagCandidateTemplate}" Margin="0,6,0,0" Focusable="False"/>
                                            </StackPanel>

                                            <!-- cover: where from; the current one → the proposed one (a click compares them large) -->
                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding HasProposedCover, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="커버" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Border Style="{StaticResource SourceBadge}" ToolTip="이 커버를 가져온 곳"
                                                            Visibility="{Binding HasCoverSource, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                                        <TextBlock Text="{Binding CoverSource}"/>
                                                    </Border>
                                                </StackPanel>
                                                <Grid Margin="0,6,0,0" IsEnabled="{Binding IsSelected}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox x:Name="CoverCheck" MinWidth="0" Padding="0" Margin="0,0,6,0" VerticalAlignment="Center" IsChecked="{Binding IncludeCover}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Background="Transparent" Cursor="Hand"
                                                                ToolTip="클릭하면 크게 비교해 봅니다" MouseLeftButtonUp="AutoFillCover_Click">
                                                        <Border Width="52" Height="52" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                            <Border CornerRadius="4" Opacity="0.6">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding CurrentCover}" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Border>
                                                        <ui:SymbolIcon Symbol="ArrowRight16" Margin="6,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                        <Border Width="52" Height="52" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource TagChangeBrush}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding ProposedCover}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- lyrics: where from, synced or plain, language; the first lines; the other lyrics -->
                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding HasLyricsSection, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                                <DockPanel>
                                                    <ui:Button DockPanel.Dock="Right" Content="{Binding MoreLyricsText}" Appearance="Transparent" Padding="8,1" FontSize="12"
                                                               Command="{Binding ToggleMoreLyricsCommand}" ToolTip="이 곡에서 찾은 가사를 모두 보여 줍니다. 카드 위에 마우스를 올리면 가사를 더 볼 수 있습니다"
                                                               Visibility="{Binding HasMoreLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="가사" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Border Style="{StaticResource SourceBadge}" Margin="0,0,4,0" ToolTip="이 가사를 가져온 곳"
                                                                Visibility="{Binding HasLyricsSource, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                                            <TextBlock Text="{Binding LyricsSource}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource SourceBadge}" Margin="0,0,4,0" Background="Transparent"
                                                                ToolTip="싱크: 줄마다 시간이 있어 재생할 때 따라갑니다 · 일반: 시간이 없는 가사"
                                                                Visibility="{Binding HasProposedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                                            <TextBlock Text="{Binding LyricsLabel}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource SourceBadge}" Background="Transparent" ToolTip="가사가 쓰인 글자"
                                                                Visibility="{Binding HasLyricsLanguage, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                                            <TextBlock Text="{Binding LyricsLanguage}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </DockPanel>
                                                <TextBlock x:Name="LyricsNoteText" Text="{Binding LyricsNote}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           app:KeepWords.IsEnabled="True" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding HasLyricsNote, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                                <Grid Margin="0,6,0,0" IsEnabled="{Binding IsSelected}"
                                                      Visibility="{Binding HasProposedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox x:Name="LyricsCheck" MinWidth="0" Padding="0" Margin="0,0,6,0" VerticalAlignment="Top" IsChecked="{Binding IncludeLyrics}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding LyricsPreview}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18"
                                                               Foreground="{DynamicResource TagChangeBrush}"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding LyricsCandidates}" ItemTemplate="{StaticResource LyricsCandidateTemplate}" Margin="0,6,0,0" Focusable="False"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsStaged}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TagChangeBrush}"/>
                                            <Setter TargetName="Pick" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="InMark" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="CoverCheck" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="LyricsCheck" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <!-- a part waits for the user to pick a result -->
                                        <DataTrigger Binding="{Binding NeedsChoice}" Value="True">
                                            <Setter TargetName="SummaryText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTagUnsure}" Value="True">
                                            <Setter TargetName="TagNoteText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLyricsUnsure}" Value="True">
                                            <Setter TargetName="LyricsNoteText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Save review (several songs) ===== -->
                <Grid Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource ApplicationBackgroundBrush}"
                      Visibility="{Binding IsReviewing, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="저장하기 전에 확인하세요" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding ReviewTitle, Mode=OneWay}"/><Run Text=" · 바뀌는 곡만 표시합니다"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Row="1" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ReviewItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding Changes}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="84"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ui:Button Grid.Column="2" Content="비교" Icon="{ui:SymbolIcon TextQuote24}" Appearance="Transparent"
                                                                               Padding="8,1" FontSize="12" Margin="6,-2,0,-2" VerticalAlignment="Center"
                                                                               ToolTip="교체 전 가사와 교체 후 가사를 나란히 봅니다"
                                                                               Command="{Binding DataContext.ToggleCompareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                               Visibility="{Binding IsLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    <WrapPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Before}" FontSize="12" TextDecorations="Strikethrough"
                                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                        <ui:SymbolIcon Symbol="ArrowRight12" FontSize="11" Margin="6,0" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                        <TextBlock Text="{Binding After}" FontSize="12">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TagChangeBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsRemoval}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </WrapPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LyricsCompareTemplate}" Focusable="False"
                                                                    Visibility="{Binding IsCompareOpen, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ReviewMore}" Margin="12,8" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== Save bar ===== -->
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,10,14,0" MinHeight="48">
                    <Grid>
                        <!-- nothing to save -->
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="변경 사항 없음"
                                   Visibility="{Binding BarState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Idle}"/>
                        <!-- unsaved edits -->
                        <DockPanel Visibility="{Binding BarState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Pending}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="되돌리기" Command="{Binding RevertAllCommand}" Margin="0,0,6,0" Appearance="Transparent"
                                           ToolTip="저장하지 않은 변경 내용을 모두 되돌립니다"/>
                                <ui:Button Content="{Binding SaveButtonText}" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" Appearance="Primary"
                                           ToolTip="저장 (Ctrl+S)"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{DynamicResource TagChangeBrush}"/>
                                <TextBlock Text="{Binding PendingSummary}" FontSize="12" Foreground="{DynamicResource TagChangeBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="저장하지 않은 변경 (다른 곡을 선택해도 유지됩니다)"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- review -->
                        <DockPanel Visibility="{Binding BarState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Reviewing}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="돌아가기" Command="{Binding CancelReviewCommand}" Margin="0,0,6,0" Appearance="Transparent"/>
                                <ui:Button Content="{Binding ConfirmSaveText}" Icon="{ui:SymbolIcon Save24}"
                                           Command="{Binding ConfirmSaveCommand}" Appearance="Primary"/>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Text="저장 후 바로 취소할 수 있습니다"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </DockPanel>
                        <!-- saving -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding BarState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Saving}">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SaveProgress}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- just saved: undo -->
                        <DockPanel Visibility="{Binding BarState, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Saved}">
                            <ui:Button DockPanel.Dock="Right" Content="실행 취소" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoCommand}"
                                       Appearance="Transparent"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="{Binding UndoText}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <views:LibrarySourceBar x:Name="SourceBar" Grid.Row="2" Margin="0,12,0,0" DataContext="{Binding Library}"/>
    </Grid>
</Page>
