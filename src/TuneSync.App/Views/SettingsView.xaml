                    </ui:CardControl>
                    <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon ShieldCheckmark24}" Tag="리미터 클리핑 왜곡 찌그러짐 음량 최대 크기"
                                    ToolTip="끄면 최대 크기를 넘은 소리가 잘린 채로 나가 왜곡될 수 있습니다.">
