                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <ui:TextBlock Text="HUD 레이아웃" FontTypography="Body"/>
                                    <ui:TextBlock Text="고르면 HUD가 바로 바뀝니다 · 곡이 바뀌어도 크기는 그대로입니다" Style="{StaticResource Desc}"/>
                                </StackPanel>
                            </StackPanel>
                            <views:HudLayoutPicker Layout="{Binding Layout, Mode=TwoWay}" ShowDescriptions="True" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <ui:TextBlock Text="모양" Style="{StaticResource Group}"/>
