<Page x:Class="TuneSync.App.Views.EqualizerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:TuneSync.App.ViewModels"
      xmlns:views="clr-namespace:TuneSync.App.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:EqualizerViewModel}"
      Title="이퀄라이저"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- The equalizer and tone controls. The response curve sits right above the band sliders on
         the same frequency scale, so the curve's bumps line up with the sliders that make them. -->
    <Page.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PlayerPanelBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Reading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToneName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToneReading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="HeaderButton" TargetType="ui:Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <Grid Margin="22,8,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== switch and presets ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:ToggleSwitch IsChecked="{Binding IsEnabled}" OnContent="켜짐" OffContent="꺼짐" VerticalAlignment="Center"
                             ToolTip="끄면 파일에 담긴 소리 그대로 재생합니다"/>

            <StackPanel x:Name="PresetBar" Grid.Column="1" Orientation="Horizontal">
                <Grid>
                    <ComboBox x:Name="PresetBox" Width="190" ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedPreset}" ToolTip="프리셋"/>
                    <!-- shown in the box while the bands match no preset -->
                    <TextBlock x:Name="CustomLabel" Text="사용자 지정" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
                <ui:Button Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon Save24}" ToolTip="지금 설정을 프리셋으로 저장" Click="Save_Click"/>
                <ui:Button x:Name="RenameButton" Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon Rename24}" ToolTip="프리셋 이름 바꾸기"
                           IsEnabled="{Binding CanEditPreset}" Click="Rename_Click"/>
                <ui:Button x:Name="DeleteButton" Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon Delete24}" ToolTip="프리셋 삭제"
                           IsEnabled="{Binding CanEditPreset}" Click="Delete_Click"/>
                <ui:Button Style="{StaticResource HeaderButton}" Icon="{ui:SymbolIcon ArrowReset24}" ToolTip="모두 처음 상태로 (플랫)"
                           Command="{Binding ResetCommand}"/>
            </StackPanel>

            <!-- naming a preset (in place of the preset box) -->
            <StackPanel x:Name="NameBar" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                <ui:TextBox x:Name="NameBox" Width="190" PlaceholderText="프리셋 이름" MaxLength="30" KeyDown="NameBox_KeyDown"/>
                <ui:Button x:Name="NameConfirm" Content="저장" Appearance="Primary" Margin="6,0,0,0" Click="NameConfirm_Click"/>
                <ui:Button Content="취소" Margin="6,0,0,0" Click="NameCancel_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== the playing song goes around the equalizer ===== -->
        <Border x:Name="BypassNotice" Grid.Row="1" Style="{StaticResource Panel}" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" Foreground="{DynamicResource PlayerAccentBrush}"/>
                <TextBlock Text="지금 재생 중인 곡은 Windows 기본 재생기로 재생되어 이퀄라이저가 적용되지 않습니다." FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ===== response curve over the band sliders ===== -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="6,14,16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="96" MaxHeight="170"/>
                    <RowDefinition Height="3*" MinHeight="150"/>
                </Grid.RowDefinitions>

                <!-- the curve's dB scale: ±12 sit a tenth from the top and bottom (the scale runs to ±15) -->
                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="1" Text="+12" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                    <TextBlock Grid.Row="1" Text="0 dB" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-7"/>
                    <TextBlock Grid.Row="2" Text="−12" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-7"/>
                </Grid>
                <views:EqCurve Grid.Row="0" Grid.Column="1" Settings="{Binding Settings}" Version="{Binding CurveVersion}" IsActive="{Binding IsEnabled}"/>

                <!-- preamp, set apart on the left -->
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,12,8,0" ToolTip="프리앰프: 전체 음량 (더블클릭하면 0)">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding PreampText}" Style="{StaticResource Reading}"/>
                    <views:EqSlider Grid.Row="1" Value="{Binding Preamp}" HorizontalAlignment="Center" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="프리앰프" Style="{StaticResource Caption}"/>
                </Grid>

                <!-- the ten bands, each under its frequency on the curve -->
                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Bands}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                            <Grid ToolTip="끌거나 마우스 휠로 조절 · 더블클릭하면 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding GainText}" Style="{StaticResource Reading}"/>
                                <views:EqSlider Grid.Row="1" Value="{Binding Gain}" HorizontalAlignment="Center" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Text="{Binding Label}" Style="{StaticResource Caption}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ===== tone ===== -->
        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="18,10,18,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="저음" Style="{StaticResource ToneName}"/>
                <views:EqSlider Grid.Row="0" Grid.Column="1" IsVertical="False" Value="{Binding Bass}" VerticalAlignment="Center" ToolTip="저음 전체를 올리거나 내립니다 (더블클릭하면 0)"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding BassText}" Style="{StaticResource ToneReading}"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="고음" Style="{StaticResource ToneName}"/>
                <views:EqSlider Grid.Row="0" Grid.Column="5" IsVertical="False" Value="{Binding Treble}" VerticalAlignment="Center" ToolTip="고음 전체를 올리거나 내립니다 (더블클릭하면 0)"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding TrebleText}" Style="{StaticResource ToneReading}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="스테레오 폭" Style="{StaticResource ToneName}"/>
                <views:EqSlider Grid.Row="1" Grid.Column="1" IsVertical="False" Minimum="0" Maximum="2" Rest="1" Step="0.05" Value="{Binding Width}"
                                VerticalAlignment="Center" ToolTip="좌우로 퍼진 정도: 0%는 모노, 100%는 원래대로 (더블클릭)"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WidthText}" Style="{StaticResource ToneReading}"/>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="좌우 균형" Style="{StaticResource ToneName}"/>
                <views:EqSlider Grid.Row="1" Grid.Column="5" IsVertical="False" Minimum="-1" Maximum="1" Step="0.05" Value="{Binding Balance}"
                                VerticalAlignment="Center" ToolTip="왼쪽·오른쪽 음량의 균형 (더블클릭하면 가운데)"/>
                <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding BalanceText}" Style="{StaticResource ToneReading}"/>
            </Grid>
        </Border>

        <!-- ===== headroom and limiter ===== -->
        <Grid Grid.Row="4" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding AutoHeadroom}" Content="자동 헤드룸" VerticalAlignment="Center"
                      ToolTip="올린 만큼 전체 음량을 미리 낮춰, 소리가 찌그러지지 않게 합니다. 끄면 넘치는 부분만 리미터가 눌러 줍니다."/>
            <TextBlock Grid.Column="1" Text="{Binding HeadroomText}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        ToolTip="소리가 최대 크기를 넘으려 할 때 부드럽게 눌러 주는 장치입니다. 불이 자주 켜지면 프리앰프를 낮추세요.">
                <Ellipse x:Name="LimiterLamp" Width="8" Height="8" Fill="{DynamicResource PlayerAccentBrush}" Opacity="0.22" Margin="0,0,6,0"/>
                <TextBlock x:Name="LimiterText" Text="리미터" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
