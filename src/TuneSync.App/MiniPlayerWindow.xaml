<ui:FluentWindow x:Class="TuneSync.App.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TuneSync.App"
        xmlns:conv="clr-namespace:TuneSync.App.Converters"
        xmlns:views="clr-namespace:TuneSync.App.Views"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="GoTune 미니 플레이어"
        Icon="pack://application:,,,/Assets/TuneSync.ico"
        Width="500" Height="104" MinWidth="0" MinHeight="0" ResizeMode="CanResize" SizeToContent="Manual"
        WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{DynamicResource PlayerTintBrush}"
        Topmost="{Binding IsMiniTopmost}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <conv:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>

        <!-- Small chrome buttons (pin / rotate / expand / close). -->
        <Style x:Key="MiniChromeButton" TargetType="ui:Button" BasedOn="{StaticResource PlayerToggleButtonStyle}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The lyric line fades in each time it changes. -->
        <Storyboard x:Key="LineFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
        </Storyboard>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="MediaPlayPause" Command="{Binding TogglePlayPauseCommand}"/>
        <KeyBinding Key="MediaStop" Command="{Binding StopCommand}"/>
        <KeyBinding Key="MediaNextTrack" Command="{Binding PlayNextCommand}"/>
        <KeyBinding Key="MediaPreviousTrack" Command="{Binding PlayPreviousCommand}"/>
    </Window.InputBindings>

    <Grid>
        <!-- Same cover-colored backdrop as the full player. -->
        <!-- A brush-filled Rectangle (not an Image): it takes no room of its own, so the card's
             height is decided by its content alone (SizeToContent). -->
        <Grid ClipToBounds="True" IsHitTestVisible="False">
            <Rectangle Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{Binding BackdropCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"/>
                </Rectangle.Fill>
                <Rectangle.RenderTransform><ScaleTransform ScaleX="1.15" ScaleY="1.15"/></Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
        <Rectangle Fill="{DynamicResource PlayerTintBrush}" Opacity="0.72" IsHitTestVisible="False"/>

        <!-- ===== Horizontal strip ===== -->
        <Grid x:Name="HorizontalLayout" Margin="12,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Width="68" Height="68" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border CornerRadius="6" Background="{DynamicResource PlayerHoverBrush}">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="24" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Border>
                <Border CornerRadius="6">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding CurrentCoverSmall}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding NowPlayingTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding NowPlayingTitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <Run Text="{Binding PositionText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
                <TextBlock Text="{Binding CurrentLyricText, NotifyOnTargetUpdated=True}" FontSize="12" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard Storyboard="{StaticResource LineFadeIn}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <local:WaveSeekBar Height="20" Margin="0,4,0,0"
                                   Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                   IsPlaying="{Binding IsPlaying}" Waveform="{Binding Waveform}" Look="{Binding SeekLook}"
                                   WaveBrush="{DynamicResource PlayerAccentBrush}" TrackBrush="{DynamicResource PlayerTrackBrush}"
                                   SeekStarted="SeekBar_SeekStarted" SeekCompleted="SeekBar_SeekCompleted"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Icon="{ui:SymbolIcon Previous24, Filled=True}"
                           Command="{Binding PlayPreviousCommand}" ToolTip="이전 곡"/>
                <ui:Button Style="{StaticResource PlayerPlayButtonStyle}" Width="40" Height="40" CornerRadius="20" Margin="4,0"
                           Icon="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                           Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지"/>
                <ui:Button Style="{StaticResource PlayerIconButtonStyle}" Icon="{ui:SymbolIcon Next24, Filled=True}"
                           Command="{Binding PlayNextCommand}" ToolTip="다음 곡"/>
            </StackPanel>

            <UniformGrid Grid.Column="3" Rows="2" Columns="2" VerticalAlignment="Center">
                <ui:Button Style="{StaticResource MiniChromeButton}" Icon="{ui:SymbolIcon Pin24}" Click="Pin_Click"
                           Tag="{Binding IsMiniTopmost}" ToolTip="항상 위에 표시"/>
                <ui:Button Style="{StaticResource MiniChromeButton}" Icon="{ui:SymbolIcon ArrowMaximize24}" Click="Expand_Click"
                           ToolTip="전체 플레이어 (Ctrl+M)"/>
                <ui:Button Style="{StaticResource MiniChromeButton}" Icon="{ui:SymbolIcon ArrowRotateClockwise24}" Click="Rotate_Click"
                           ToolTip="세로 미니 플레이어로"/>
                <ui:Button Style="{StaticResource MiniChromeButton}" Icon="{ui:SymbolIcon Dismiss24}" Click="Close_Click"
                           ToolTip="GoTune 종료"/>
            </UniformGrid>
        </Grid>

        <!-- ===== Vertical card (window height follows its content: SizeToContent) ===== -->
        <Grid x:Name="VerticalLayout" Margin="18,10,18,14" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- The fold-out queue takes whatever height the card is dragged to. -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-8,6">
                <ui:Button Style="{StaticResource MiniChromeButton}" Icon="{ui:SymbolIcon Pin24}" Click="Pin_Click"
                           Tag="{Binding IsMiniTopmost}" ToolTip="항상 위에 표시"/>
                <ui:Button Style="{StaticResource MiniChromeButton}" Icon="{ui:SymbolIcon ArrowRotateCounterclockwise24}" Click="Rotate_Click"
                           ToolTip="가로 미니 플레이어로"/>
                <ui:Button Style="{StaticResource MiniChromeButton}" Icon="{ui:SymbolIcon ArrowMaximize24}" Click="Expand_Click"
                           ToolTip="전체 플레이어 (Ctrl+M)"/>
                <ui:Button Style="{StaticResource MiniChromeButton}" Icon="{ui:SymbolIcon Dismiss24}" Click="Close_Click"
                           ToolTip="GoTune 종료"/>
            </StackPanel>

            <Grid Grid.Row="1" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                <Border CornerRadius="10" Background="{DynamicResource PlayerHoverBrush}">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="56" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Border>
                <Border CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.4" Color="Black"/>
                    </Border.Effect>
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding CurrentCover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="{Binding NowPlayingTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding NowPlayingTitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding NowPlayingSubtitle}" FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Only for synced lyrics; otherwise this would just repeat the artist. -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0" Height="68"
                        Visibility="{Binding HasSyncedLyrics, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                <TextBlock Text="{Binding CurrentLyricText, NotifyOnTargetUpdated=True}" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxHeight="44" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard Storyboard="{StaticResource LineFadeIn}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="{Binding NextLyricText}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <local:WaveSeekBar Height="24"
                                   Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}"
                                   IsPlaying="{Binding IsPlaying}" Waveform="{Binding Waveform}" Look="{Binding SeekLook}"
                                   WaveBrush="{DynamicResource PlayerAccentBrush}" TrackBrush="{DynamicResource PlayerTrackBrush}"
                                   SeekStarted="SeekBar_SeekStarted" SeekCompleted="SeekBar_SeekCompleted"/>
                <Grid Grid.Row="1">
                    <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding DurationText}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>
            </Grid>

            <!-- Symmetric around the play button: shuffle | prev  ( play )  next | repeat -->
            <Grid Grid.Row="5" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <ui:Button Style="{StaticResource PlayerToggleButtonStyle}" HorizontalAlignment="Left"
                               Tag="{Binding IsShuffle}" Command="{Binding ToggleShuffleCommand}" ToolTip="{Binding ShuffleToolTip}"
                               Icon="{ui:SymbolIcon ArrowShuffle24}"/>
                    <ui:Button Style="{StaticResource PlayerIconButtonStyle}" HorizontalAlignment="Right" Margin="0,0,14,0"
                               Icon="{ui:SymbolIcon Previous24, Filled=True}" Command="{Binding PlayPreviousCommand}" ToolTip="이전 곡"/>
                </Grid>
                <ui:Button Grid.Column="1" Style="{StaticResource PlayerPlayButtonStyle}" Width="52" Height="52" CornerRadius="26"
                           Icon="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                           Command="{Binding TogglePlayPauseCommand}" ToolTip="재생 / 일시정지"/>
                <Grid Grid.Column="2">
                    <ui:Button Style="{StaticResource PlayerIconButtonStyle}" HorizontalAlignment="Left" Margin="14,0,0,0"
                               Icon="{ui:SymbolIcon Next24, Filled=True}" Command="{Binding PlayNextCommand}" ToolTip="다음 곡"/>
                    <ui:Button HorizontalAlignment="Right" Command="{Binding CycleRepeatCommand}" ToolTip="{Binding RepeatToolTip}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PlayerIconButtonStyle}">
                                <Setter Property="Icon" Value="{ui:SymbolIcon ArrowRepeatAll24}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Repeat}" Value="All">
                                        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Repeat}" Value="One">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon ArrowRepeat124}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Grid>

            <!-- Fold-out queue: the window grows downward to show it. -->
            <ui:Button Grid.Row="6" Style="{StaticResource PlayerIconButtonStyle}" Width="NaN" Height="34" CornerRadius="8"
                       Margin="-6,12,-6,0" Padding="8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                       Command="{Binding ToggleMiniQueueCommand}" ToolTip="재생 대기열 펼치기 / 접기">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="재생 대기열" FontSize="13" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ui:SymbolIcon HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="ChevronDown24"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMiniQueueExpanded}" Value="True">
                                        <Setter Property="Symbol" Value="ChevronUp24"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Grid>
            </ui:Button>

            <ListBox x:Name="MiniQueue" Grid.Row="7" MinHeight="140" Margin="-6,6,-6,0"
                     ItemsSource="{Binding Library.PlaylistView}"
                     BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="MiniQueue_MouseDoubleClick" KeyDown="MiniQueue_KeyDown"
                     Visibility="{Binding IsMiniQueueExpanded, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4" Margin="0,0,12,0">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlayerHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="두 번 클릭하면 재생합니다">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34" Margin="0,0,10,0">
                                <Border CornerRadius="4" Background="{DynamicResource PlayerHoverBrush}"/>
                                <Border CornerRadius="4">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CoverThumbnail}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="4" Background="#8C000000"
                                        Visibility="{Binding IsNowPlaying, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=True}">
                                    <views:EqualizerBars BarBrush="{DynamicResource PlayerAccentBrush}"
                                                         IsActive="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="{Binding PrimaryText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" Margin="8,0,2,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/>
                                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" VerticalAlignment="Bottom"/>
    </Grid>
</ui:FluentWindow>
