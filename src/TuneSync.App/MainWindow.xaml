<ui:FluentWindow x:Class="TuneSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:TuneSync.App.Views"
        Title="TuneSync" Height="760" Width="1150"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TuneSync"/>

        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation" IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="폴더 합치기" TargetPageType="{x:Type views:MergeView}"/>
                <ui:NavigationViewItem Content="앨범 커버" TargetPageType="{x:Type views:CoverView}"/>
                <ui:NavigationViewItem Content="폴더·파일명 규칙" TargetPageType="{x:Type views:RenameView}"/>
                <ui:NavigationViewItem Content="가사" TargetPageType="{x:Type views:LyricsView}"/>
                <ui:NavigationViewItem Content="태그" TargetPageType="{x:Type views:TagView}"/>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
