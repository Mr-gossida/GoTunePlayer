<UserControl x:Class="TuneSync.App.Views.BatchSyncConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:TuneSync.App"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Width="470">
    <!-- The confirmation before a batch of 싱크 가사 만들기 (BatchSyncConfirmViewModel): what it
         will do, how long it should take, and that it's heavy work. Shown inside the themed
         message box (Dialogs), which brings the title and the buttons. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- a line that has nothing to say takes no room -->
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="app:KeepWords.IsEnabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Padding" Value="14,10,14,12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        </Style>
        <Style x:Key="Bullet" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="app:KeepWords.IsEnabled" Value="True"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- what -->
        <TextBlock Text="{Binding Heading}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" app:KeepWords.IsEnabled="True"/>
        <TextBlock Text="{Binding Skipped}" Style="{StaticResource Note}" Margin="0,4,0,0"/>

        <!-- how long -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Timer24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="곡당 예상 시간" Style="{StaticResource TileLabel}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PerSong}" Style="{StaticResource TileValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Tile}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Clock24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Style="{StaticResource TileLabel}">
                            <Run Text="전체"/> <Run Text="{Binding Count, Mode=OneWay}"/><Run Text="곡 예상 시간"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Total}" Style="{StaticResource TileValue}"/>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="{Binding EstimateNote}" Style="{StaticResource Note}" Margin="2,8,0,0"/>
        <TextBlock Text="{Binding RemoteNote}" Style="{StaticResource Note}" Margin="2,2,0,0"/>

        <!-- heavy work -->
        <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Warning24" Filled="True" FontSize="20" VerticalAlignment="Top" Margin="0,0,10,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="자원과 전력을 많이 쓰는 작업입니다" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <!-- bullets with a hanging indent: a wrapped line starts under the text, not the dot -->
                    <ItemsControl Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Style="{StaticResource Bullet}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Bullet}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <sys:String>처리하는 동안 CPU와 그래픽을 거의 최대로 씁니다. 팬 소리가 커지고 다른 프로그램이 느려질 수 있습니다.</sys:String>
                        <sys:String>전력을 많이 써서 노트북은 배터리가 빨리 닳습니다. 전원을 연결해 두세요.</sys:String>
                        <sys:String>끝날 때까지 PC가 절전 모드로 들어가지 않습니다. 언제든 중지할 수 있고, 끝난 곡은 그대로 남습니다.</sys:String>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- unplugged laptop: said louder -->
        <Border Margin="0,8,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="{Binding OnBattery, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="BatteryWarning24" FontSize="20" VerticalAlignment="Top" Margin="0,0,10,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="지금 배터리로 실행 중입니다" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Bullet}"
                               Text="전원을 연결하지 않으면 배터리가 빠르게 닳고, 절전 설정에 따라 처리가 크게 느려질 수 있습니다."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- the models, the first time -->
        <Border Margin="0,8,0,0" Padding="14,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                Visibility="{Binding NeedsModel, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" VerticalAlignment="Top" Margin="0,0,10,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Bullet}" Margin="0"
                           Text="처음 한 번, 노래를 듣는 데 쓰는 모델(최대 254MB)을 받은 뒤 시작합니다. 노래와 가사는 외부로 보내지 않습니다."/>
            </Grid>
        </Border>

        <!-- songs synced already -->
        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasSynced, Converter={StaticResource BoolToVisibility}}">
            <CheckBox Content="{Binding IncludeSyncedText}" IsChecked="{Binding IncludeSynced}" MinWidth="0"/>
            <TextBlock Style="{StaticResource Note}" Margin="28,0,0,0"
                       Text="지금 있는 싱크 가사의 시간을 새로 맞춘 시간으로 바꿉니다."/>
        </StackPanel>
    </StackPanel>
</UserControl>
